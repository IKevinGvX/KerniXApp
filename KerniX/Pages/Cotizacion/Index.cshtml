                </a>

            </div>

        </aside>



        <!-- =========================================================
         PAGE
         ========================================================= -->

        <div class="kx-page">


            <!-- =====================================================
             TOPBAR
             ===================================================== -->

            <header class="kx-topbar">


                <!-- MOBILE MENU -->

                <button type="button"
                        class="kx-mobile-menu"
                        id="mobileMenuButton">

                    <i class="fa-solid fa-bars"></i>

                </button>


                <!-- =================================================
                 GLOBAL SEARCH
                 ================================================= -->

                <div class="kx-global-search">

                    <i class="fa-solid fa-magnifying-glass"></i>


                    <input type="text"
                           id="globalSearch"
                           autocomplete="off"
                           placeholder="Buscar clientes, productos, cotizaciones..." />


                    <kbd>
                        Ctrl + K
                    </kbd>


                    <div class="kx-global-results"
                         id="globalResults">

                        <div class="kx-global-empty">

                            Escribe para buscar.

                        </div>

                    </div>

                </div>


                <!-- =================================================
                 RIGHT
                 ================================================= -->

                <div class="kx-topbar-actions">


                    <!-- DATE -->

                    <div class="kx-top-range"
                         id="rangeButton">


                        <i class="fa-regular fa-calendar-check"></i>


                        <span>

                            @(Model.FechaDesde?.ToString("dd/MM/yyyy")
                              ?? "--/--/----")

                            -

                            @(Model.FechaHasta?.ToString("dd/MM/yyyy")
                              ?? "--/--/----")

                        </span>


                        <i class="fa-solid fa-chevron-down"></i>


                        <form method="get"
                              class="kx-range-popup"
                              id="rangePopup">


                            <input type="hidden"
                                   name="IdCliente"
                                   value="@Model.IdCliente" />

                            <input type="hidden"
                                   name="Estado"
                                   value="@Model.Estado" />


                            <div class="kx-range-grid">


                                <div class="kx-range-field">

                                    <label>
                                        Desde
                                    </label>

                                    <input type="date"
                                           name="FechaDesde"
                                           value="@Model.FechaDesde?.ToString("yyyy-MM-dd")" />

                                </div>


                                <div class="kx-range-field">

                                    <label>
                                        Hasta
                                    </label>

                                    <input type="date"
                                           name="FechaHasta"
                                           value="@Model.FechaHasta?.ToString("yyyy-MM-dd")" />

                                </div>

                            </div>


                            <div class="kx-range-actions">

                                <a href="/Cotizacion/Index"
                                   class="kx-range-reset">

                                    Limpiar

                                </a>


                                <button type="submit"
                                        class="kx-range-apply">

                                    Aplicar

                                </button>

                            </div>

                        </form>

                    </div>


                    <!-- THEME -->

                    <button type="button"
                            class="kx-top-icon"
                            id="themeButton"
                            title="Tema">

                        <i class="fa-regular fa-sun"></i>

                    </button>


                    <!-- NOTIFICATIONS -->

                    <button type="button"
                            class="kx-top-icon notification"
                            id="notificationButton"
                            title="Notificaciones">

                        <i class="fa-regular fa-bell"></i>

                        <span class="kx-notification-badge">
                            5
                        </span>

                    </button>


                    <!-- MESSAGES -->

                    <button type="button"
                            class="kx-top-icon notification"
                            id="messageButton"
                            title="Mensajes">

                        <i class="fa-regular fa-envelope"></i>

                        <span class="kx-notification-badge">
                            2
                        </span>

                    </button>


                    <!-- USER -->

                    <div class="kx-user-area"
                         id="userButton">


                        <div class="kx-user-avatar">
                            @inicial
                        </div>


                        <div class="kx-user-information">

                            <strong>
                                @empleado
                            </strong>

                            <span>
                                @cargo
                            </span>

                        </div>


                        <i class="fa-solid fa-chevron-down"></i>


                        <div class="kx-user-dropdown"
                             id="userDropdown">


                            <div class="kx-user-dropdown-header">

                                <strong>
                                    @empleado
                                </strong>

                                <span>
                                    @nombreUsuario
                                </span>

                            </div>

                            <!-- PERFIL -->

                            <a href="/Perfil/Index">

                                <i class="fa-regular fa-user"></i>

                                Ver perfil

                            </a>


                            <!-- CONFIGURACIÓN -->

                            <a href="/Configuracion/General">

                                <i class="fa-solid fa-gear"></i>

                                Configuración

                            </a>


                            <!-- CERRAR SESIÓN -->

                            <a href="/Account/Logout"
                               class="logout">

                                <i class="fa-solid fa-right-from-bracket"></i>

                                Cerrar sesión

                            </a>

                        </div>

                    </div>

                </div>

            </header>


            <!-- =====================================================
             CONTENT
             ===================================================== -->

            <main class="kx-content">


                @if (!string.IsNullOrWhiteSpace(Model.ErrorMensaje))
                {
                    <div class="kx-error">

                        <i class="fa-solid fa-circle-exclamation"></i>

                        @Model.ErrorMensaje

                    </div>
                }


                <!-- =================================================
                 TITLE
                 ================================================= -->

                <section class="kx-heading">


                    <div class="kx-heading-icon">

                        <i class="fa-regular fa-clipboard"></i>

                    </div>


                    <div>

                        <h1>
                            Cotizaciones
                        </h1>

                        <p>
                            Gestiona y da seguimiento a todas tus cotizaciones.
                        </p>

                    </div>

                </section>



                <!-- =================================================
                 KPI
                 ================================================= -->

                <section class="kx-kpi-grid">


                    <!-- KPI 1 -->

                    <article class="kx-kpi blue">


                        <div class="kx-kpi-icon">

                            <i class="fa-regular fa-clipboard"></i>

                        </div>


                        <div class="kx-kpi-data">

                            <span>
                                Cotizaciones del Mes
                            </span>

                            <strong>
                                @Model.Resumen.TotalCotizaciones
                            </strong>

                            <small>

                                <b>

                                    <i class="fa-solid fa-chart-line"></i>

                                    Periodo seleccionado

                                </b>

                            </small>

                        </div>


                        <div class="kx-mini-chart blue-bars">

                            <span style="height:24%"></span>
                            <span style="height:32%"></span>
                            <span style="height:48%"></span>
                            <span style="height:38%"></span>
                            <span style="height:54%"></span>
                            <span style="height:33%"></span>
                            <span style="height:64%"></span>
                            <span style="height:45%"></span>
                            <span style="height:71%"></span>
                            <span style="height:80%"></span>
                            <span style="height:90%"></span>
                            <span style="height:100%"></span>

                        </div>

                    </article>


                    <!-- KPI 2 -->

                    <article class="kx-kpi gold">


                        <div class="kx-kpi-icon">

                            <i class="fa-regular fa-hourglass-half"></i>

                        </div>


                        <div class="kx-kpi-data">

                            <span>
                                Pendientes
                            </span>

                            <strong>
                                @Model.Resumen.Pendientes
                            </strong>

                            <small>

                                <b>

                                    <i class="fa-regular fa-clock"></i>

                                    En seguimiento

                                </b>

                            </small>

