@page
@model KerniX.Pages.Account.LogoutModel
@{
    Layout = null;
    ViewData["Title"] = "Cerrar sesión | KerniX ERP";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/css/uikit.min.css" />

    <style>
            :root {
                color-scheme: dark;
                --kx-gold: #ffbd16;
                --kx-text: #f5f7ff;
                --kx-muted: #aeb9cf;
            }

            *, *::before, *::after {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: #030711;
                color: var(--kx-text);
                font-family: "Segoe UI", Arial, sans-serif;
            }

            .kx-page {
                min-height: 100vh;
                padding: 28px 16px;
                display: flex;
                justify-content: center;
                align-items: center;
                background: radial-gradient(circle at 75% 15%, rgba(76, 36, 172, .20), transparent 42%), radial-gradient(circle at 20% 90%, rgba(218, 140, 0, .10), transparent 38%);
            }

            .kx-card {
                position: relative;
                overflow: hidden;
                width: min(100%, 490px);
                padding: 38px;
                border: 1px solid rgba(255, 188, 22, .60);
                border-radius: 20px;
                background: linear-gradient(155deg, #0b1122, #050914);
                box-shadow: 0 20px 70px rgba(0, 0, 0, .62), 0 0 30px rgba(255, 185, 0, .07);
            }

                .kx-card::before {
                    content: "";
                    position: absolute;
                    top: 0;
                    left: 26px;
                    width: 84px;
                    height: 3px;
                    background: var(--kx-gold);
                    box-shadow: 0 0 17px rgba(255, 189, 22, .65);
                }

            .kx-brand {
                display: flex;
                align-items: center;
                gap: 13px;
                margin-bottom: 34px;
            }

                .kx-brand img {
                    width: 62px;
                    height: 62px;
                    border-radius: 12px;
                    object-fit: cover;
                    border: 1px solid rgba(255, 188, 22, .4);
                }

            .kx-brand-title {
                color: #ffffff;
                font-size: 25px;
                font-weight: 800;
                line-height: 1.2;
            }

                .kx-brand-title span {
                    color: var(--kx-gold);
                }

            .kx-brand-subtitle {
                color: var(--kx-muted);
                font-size: 11px;
                margin-top: 4px;
            }

            .kx-icon {
                display: grid;
                place-items: center;
                width: 72px;
                height: 72px;
                border: 1px solid rgba(255, 188, 22, .5);
                border-radius: 19px;
                background: rgba(255, 188, 22, .08);
                color: var(--kx-gold);
                margin-bottom: 20px;
            }

            .kx-eyebrow {
                display: block;
                color: var(--kx-gold);
                font-size: 12px;
                font-weight: 700;
                letter-spacing: .04em;
            }

            .kx-title {
                margin: 10px 0 12px;
                color: #ffffff;
                font-size: clamp(27px, 5vw, 34px);
                line-height: 1.15;
                font-weight: 800;
            }

            .kx-description {
                margin: 0;
                color: var(--kx-muted);
                font-size: 14px;
                line-height: 1.7;
            }

            .kx-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                margin-top: 28px;
            }

                .kx-actions form {
                    margin: 0;
                }

            .kx-button {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                min-height: 49px;
                width: 100%;
                padding: 12px 10px;
                border-radius: 10px;
                font: 700 13px/1.3 "Segoe UI", Arial, sans-serif;
                text-align: center;
                text-decoration: none;
                cursor: pointer;
                transition: filter .2s, border-color .2s;
            }

                .kx-button:hover {
                    text-decoration: none;
                    filter: brightness(1.1);
                }

                .kx-button:focus-visible {
                    outline: 2px solid #8fd1ff;
                    outline-offset: 3px;
                }

            .kx-cancel {
                background: #10182b;
                border: 1px solid #3a4866;
                color: #eef3ff;
            }

                .kx-cancel:hover {
                    color: #ffffff;
                    border-color: #7484a5;
                }

            .kx-confirm {
                background: linear-gradient(180deg, #ffda69, #eca000);
                border: 1px solid #ffd875;
                color: #160f00;
            }

            .kx-note {
                margin: 28px 0 0;
                padding-top: 17px;
                border-top: 1px solid rgba(166, 181, 208, .17);
                color: #92a1bd;
                font-size: 12px;
                line-height: 1.6;
            }

            @@media (max-width: 440px) {
                .kx-card {
                    padding: 28px 22px;
                }

                .kx-actions {
                    grid-template-columns: 1fr;
                }

                .kx-brand-title {
                    font-size: 23px;
                }
            }
    </style>
</head>
<body>
    <main class="kx-page">
        <section class="kx-card" aria-labelledby="logoutTitle">
            <header class="kx-brand">
                <img src="~/images/login/kernix-logo.png"
                     asp-append-version="true"
                     alt="Logo de KerniX ERP" />
                <div>
                    <div class="kx-brand-title">KerniX <span>ERP</span></div>
                    <div class="kx-brand-subtitle">Sistema Inteligente de Gestión Empresarial</div>
                </div>
            </header>

            <div class="kx-icon" aria-hidden="true">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 17l5-5-5-5" />
                    <path d="M15 12H3" />
                    <path d="M12 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7" />
                </svg>
            </div>

            <span class="kx-eyebrow">SEGURIDAD DE TU CUENTA</span>
            <h1 class="kx-title" id="logoutTitle">¿Cerrar sesión?</h1>
            <p class="kx-description">
                Estás a punto de salir de KerniX ERP. Para volver a acceder a tu
                centro de operaciones tendrás que iniciar sesión nuevamente.
            </p>

            <div class="kx-actions">
                <a href="/Inicio/Carga" class="kx-button kx-cancel">
                    Seguir trabajando
                </a>

                <form method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="kx-button kx-confirm">
                        Cerrar sesión
                    </button>
                </form>
            </div>

            <p class="kx-note">
                Esta acción cierra la sesión web del navegador actual.
                No cierra automáticamente otras sesiones ni revoca los tokens
                ya emitidos por la API.
            </p>
        </section>
    </main>
</body>
</html>
