@page
@model KerniX.Pages.Configuracion.IndexModel

@{
    Layout = null;

    ViewData["Title"] =
        "Configuración | KerniX";

    var monedaSeleccionada =
        Model.Monedas.FirstOrDefault(
            x => string.Equals(
                x.Codigo,
                Model.MonedaPrincipal,
                StringComparison.OrdinalIgnoreCase));

    var estadoConfiguracion =
        Model.Validacion?
            .Estado
            .EstadoConfiguracion
        ?? "SIN DATOS";

    var configuracionCompleta =
        string.Equals(
            estadoConfiguracion,
            "COMPLETO",
            StringComparison.OrdinalIgnoreCase);

    var nombreUsuario =
        !string.IsNullOrWhiteSpace(
            Model.Perfil.Empleado)
            ? Model.Perfil.Empleado
            : Model.Perfil.NombreUsuario;

    var rolUsuario =
        !string.IsNullOrWhiteSpace(
            Model.Perfil.RolesTexto)
            ? Model.Perfil.RolesTexto
            : "Usuario";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"]
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/css/uikit.min.css" />

    <link rel="stylesheet"
          href="~/css/general.css"
          asp-append-version="true" />

</head>

<body>

<div class="kx-shell">

    <!-- ===================================================== -->
    <!-- SIDEBAR -->
    <!-- ===================================================== -->

    <aside class="kx-sidebar">

        <a href="/Inicio/Index"
           class="kx-logo">

            <img src="~/images/login/kernix-logo.png"
                 asp-append-version="true"
                 alt="KerniX" />

            <div>

                <strong>
                    Kerni<span>X</span>
                </strong>

                <small>
                    Gestión inteligente de ventas e inventario
                </small>

            </div>

        </a>


        <!-- ================================================= -->
        <!-- MENU -->
        <!-- ================================================= -->

        <nav class="kx-nav">

            <a href="/Inicio/Index">

                <span uk-icon="icon: home"></span>

                <span>
                    Inicio
                </span>

            </a>


            <a href="/Ventas/Index">

                <span uk-icon="icon: cart"></span>

                <span>
                    Ventas
                </span>

            </a>


            <a href="/Inventario/Index">

                <span uk-icon="icon: database"></span>

                <span>
                    Inventario
                </span>

            </a>


            <a href="/Productos/Index">

                <span uk-icon="icon: grid"></span>

                <span>
                    Productos
                </span>

            </a>


            <a href="/Clientes/Index">

                <span uk-icon="icon: users"></span>

                <span>
                    Clientes
                </span>

            </a>


            <a href="/IA/Index">

                <span uk-icon="icon: bolt"></span>

                <span>
                    KerniX IA
                </span>

            </a>


            <a href="/Configuracion/Index1"
               class="active">

                <span uk-icon="icon: settings"></span>

                <span>
                    Configuración
                </span>

            </a>

        </nav>


        <!-- ================================================= -->
        <!-- IA BOX -->
        <!-- ================================================= -->

        <div class="kx-ai-box">

            <div class="kx-ai-icon">
                AI
            </div>

            <strong>
                KerniX IA
            </strong>

            <p>
                Consulta datos, pronostica ventas
                y recibe recomendaciones de
                reposición de inventario.
            </p>

            <a href="/IA/Index"
               class="kx-ai-button">

                Abrir asistente

            </a>

        </div>

    </aside>


    <!-- ===================================================== -->
    <!-- MAIN -->
    <!-- ===================================================== -->

    <main class="kx-main">

        <!-- ================================================= -->
        <!-- TOPBAR -->
        <!-- ================================================= -->

        <header class="kx-topbar">

            <div class="kx-search">

                <span uk-icon="icon: search"></span>

                <input id="kxSearch"
                       type="text"
                       autocomplete="off"
                       placeholder="Buscar en configuración..." />

            </div>
                

            <div class="kx-top-actions">

                <div class="kx-top-icon"
                     title="Alertas">

                    <span uk-icon="icon: bell"></span>

                    @if (Model.Alertas.Count > 0)
                    {
                        <span class="kx-counter">
                            @Model.Alertas.Count
                        </span>
                    }

                </div>


                <div class="kx-top-user">

                    <div class="kx-user-circle">

                        <span uk-icon="icon: user"></span>

                    </div>

                    <div>

                        <strong>
                            @nombreUsuario
                        </strong>

                        <span>
                            @rolUsuario
                        </span>

                    </div>

                </div>

            </div>

        </header>


        <!-- ================================================= -->
        <!-- TITULO -->
        <!-- ================================================= -->

        <section class="kx-page-title">

            <div class="kx-title-icon">

                <span uk-icon="icon: settings; ratio: 1.5"></span>

            </div>

            <div>

                <h1>
                    Configuración
                </h1>

                <p>
                    Administra preferencias, inventario,
                    ventas, comprobantes, seguridad,
                    inteligencia artificial y mantenimiento.
                </p>

            </div>

        </section>


        <!-- ================================================= -->
        <!-- GRID -->
        <!-- ================================================= -->

        <section class="kx-config-grid">


            <!-- ================================================= -->
            <!-- EMPRESA -->
            <!-- ================================================= -->

            <article class="kx-card"
                     data-search="empresa sucursal moneda general">

                <div class="kx-card-title">

                    <span uk-icon="icon: location"></span>

                    <h2>
                        Datos de la Empresa
                    </h2>

                </div>


                <div class="kx-form-grid">

                    <div class="kx-field full">

                        <label>
                            Empresa
                        </label>

                        <input type="text"
                               value="@Model.Perfil.Empresa"
                               readonly />

                    </div>


                    <div class="kx-field full">

                        <label>
                            Sucursal actual
                        </label>

                        <input type="text"
                               value="@Model.Perfil.Sucursal"
                               readonly />

                    </div>


                    <div class="kx-field">

                        <label>
                            Moneda principal
                        </label>

                        <input type="text"
                               value="@(monedaSeleccionada is null
                                   ? Model.MonedaPrincipal
                                   : $"{monedaSeleccionada.Nombre} ({monedaSeleccionada.Simbolo})")"
                               readonly />

                    </div>


                    <div class="kx-field">

                        <label>
                            Zona horaria
                        </label>

                        <input type="text"
                               value="@Model.ZonaHoraria"
                               readonly />

                    </div>

                </div>


                <div class="kx-card-actions">

                    <a href="/Configuracion/General"
                       class="kx-btn-primary">

                        <span uk-icon="icon: settings"></span>

                        Configuración general

                    </a>

                </div>

            </article>


            <!-- ================================================= -->
            <!-- PERFIL -->
            <!-- ================================================= -->

            <article class="kx-card"
                     data-search="perfil usuario correo contraseña rol">

                <div class="kx-card-title">

                    <span uk-icon="icon: user"></span>

                    <h2>
                        Perfil del Usuario
                    </h2>

                </div>


                <div class="kx-profile-box">

                    <div class="kx-profile-avatar">

                        <span uk-icon="icon: user; ratio: 2.1"></span>

                    </div>


                    <div class="kx-profile-data">

                        <span>
                            Nombre
                        </span>

                        <strong>

                            @(string.IsNullOrWhiteSpace(
                                Model.Perfil.Empleado)
                                ? "No disponible"
                                : Model.Perfil.Empleado)

                        </strong>


                        <span>
                            Usuario
                        </span>

                        <strong>
                            @Model.Perfil.NombreUsuario
                        </strong>


                        <span>
                            Correo
                        </span>

                        <strong>
                            @Model.Perfil.Correo
                        </strong>


                        <span>
                            Rol
                        </span>

                        <strong>
                            @rolUsuario
                        </strong>

                    </div>

                </div>


                <div class="kx-card-actions">

                    <a href="/Perfil/Index"
                       class="kx-btn-primary">

                        <span uk-icon="icon: pencil"></span>

                        Editar perfil

                    </a>

                </div>

            </article>


            <!-- ================================================= -->
            <!-- ESTADO -->
            <!-- ================================================= -->

            <article class="kx-card"
                     data-search="estado sistema base datos configuración">

                <div class="kx-card-title">

                    <span uk-icon="icon: shield"></span>

                    <h2>
                        Estado del Sistema
                    </h2>

                </div>


                <div class="kx-system-list">

                    <div>

                        <span>
                            Configuración
                        </span>

                        <strong class="@(configuracionCompleta
                            ? "ok"
                            : "warning")">

                            @estadoConfiguracion

                        </strong>

                    </div>


                    <div>

                        <span>
                            Base de datos
                        </span>

                        <strong class="ok">
                            Conectada
                        </strong>

                    </div>


                    <div>

                        <span>
                            Parámetros activos
                        </span>

                        <strong>
                            @(Model.Diagnostico?
                                .ParametrosActivos ?? 0)
                        </strong>

                    </div>


                    <div>

                        <span>
                            Series activas
                        </span>

                        <strong>
                            @(Model.Diagnostico?
                                .SeriesActivas ?? 0)
                        </strong>

                    </div>


                    <div>

                        <span>
                            Alertas pendientes
                        </span>

                        <strong class="@(Model.Alertas.Count > 0
                            ? "warning"
                            : "ok")">

                            @Model.Alertas.Count

                        </strong>

                    </div>


                    <div>

                        <span>
                            Último respaldo
                        </span>

                        <strong>

                            @(Model.UltimaCopia?.FechaFin.HasValue == true
                                ? Model.UltimaCopia.FechaFin.Value
                                    .ToString("dd/MM/yyyy HH:mm")
                                : "Sin respaldo")

                        </strong>

                    </div>

                </div>

            </article>


            <!-- ================================================= -->
            <!-- SUCURSAL -->
            <!-- ================================================= -->

            <article class="kx-card"
                     data-search="sucursal empresa">

                <div class="kx-card-title">

                    <span uk-icon="icon: thumbnails"></span>

                    <h2>
                        Sucursal Actual
                    </h2>

                </div>


                <div class="kx-system-list">

                    <div>

                        <span>
                            Sucursal
                        </span>

                        <strong>
                            @Model.Perfil.Sucursal
                        </strong>

                    </div>


                    <div>

                        <span>
                            Empresa
                        </span>

                        <strong>
                            @Model.Perfil.Empresa
                        </strong>

                    </div>


                    <div>

                        <span>
                            Configuraciones
                        </span>

                        <strong>
                            @(Model.Diagnostico?
                                .ConfiguracionesSucursalActivas ?? 0)
                        </strong>

                    </div>

                </div>


                <div class="kx-card-actions">

                    <a href="/Configuracion/General"
                       class="kx-btn-primary">

                        Ver configuración

                    </a>

                </div>

            </article>


            <!-- ================================================= -->
            <!-- GENERAL -->
            <!-- ================================================= -->

            <article class="kx-card"
                     data-search="preferencias moneda idioma decimales general">

                <div class="kx-card-title">

                    <span uk-icon="icon: cog"></span>

                    <h2>
                        Preferencias del Sistema
                    </h2>

                </div>


                <div class="kx-option-row">

                    <span>
                        Moneda en documentos
                    </span>

                    <strong>
                        @Model.MonedaPrincipal
                    </strong>

                </div>


                <div class="kx-option-row">

                    <span>
                        Decimales en precios
                    </span>

                    <strong>
                        @Model.DecimalesPrecio
                    </strong>

                </div>


                <div class="kx-option-row">

                    <span>
                        Decimales en cantidades
                    </span>

                    <strong>
                        @Model.DecimalesCantidad
                    </strong>

                </div>


                <div class="kx-option-row">

                    <span>
                        Idioma
                    </span>

                    <strong>
                        @Model.Idioma
                    </strong>

                </div>


                <div class="kx-card-actions">

                    <a href="/Configuracion/General"
                       class="kx-btn-primary">

                        Configurar preferencias

                    </a>

                </div>

            </article>


            <!-- ================================================= -->
            <!-- INVENTARIO -->
            <!-- ================================================= -->

            <article class="kx-card"
                     data-search="inventario stock lotes series vencimiento">

                <div class="kx-card-title">

                    <span uk-icon="icon: database"></span>

                    <h2>
                        Reglas de Inventario
                    </h2>

                </div>


                <div class="kx-option-row">

                    <span>
                        Stock mínimo
                    </span>

                    <strong>
                        @Model.StockMinimo
                    </strong>

                </div>


                <div class="kx-option-row">

                    <span>
                        Stock negativo
                    </span>

                    <label class="kx-switch">

                        <input type="checkbox"
                               checked="@Model.PermitirStockNegativo"
                               disabled />

                        <span></span>

                    </label>

                </div>


                <div class="kx-option-row">

                    <span>
                        Alertas de stock bajo
                    </span>

                    <label class="kx-switch">

                        <input type="checkbox"
                               checked="@Model.AlertasStockActivas"
                               disabled />

                        <span></span>

                    </label>

                </div>


                <div class="kx-option-row">

                    <span>
                        Alertas de stock agotado
                    </span>

                    <label class="kx-switch">

                        <input type="checkbox"
                               checked="@Model.AlertasStockAgotado"
                               disabled />

                        <span></span>

                    </label>

                </div>


                <div class="kx-option-row">

                    <span>
                        Controlar lotes
                    </span>

                    <label class="kx-switch">

                        <input type="checkbox"
                               checked="@Model.ControlarLotes"
                               disabled />

                        <span></span>

                    </label>

                </div>


                <div class="kx-option-row">

                    <span>
                        Controlar series
                    </span>

                    <label class="kx-switch">

                        <input type="checkbox"
                               checked="@Model.ControlarSeries"
                               disabled />

                        <span></span>

                    </label>

                </div>


                <div class="kx-option-row">

                    <span>
                        Controlar vencimiento
                    </span>

                    <label class="kx-switch">

                        <input type="checkbox"
                               checked="@Model.ControlarVencimiento"
                               disabled />

                        <span></span>

                    </label>

                </div>


                <div class="kx-card-actions">

                    <a href="/Configuracion/Inventario"
                       class="kx-btn-primary">

                        Configurar inventario

                    </a>

                </div>

            </article>


            <!-- ================================================= -->
            <!-- VENTAS -->
            <!-- ================================================= -->

            <article class="kx-card"
                     data-search="ventas crédito descuento precio stock">

                <div class="kx-card-title">

                    <span uk-icon="icon: cart"></span>

                    <h2>
                        Reglas de Ventas
                    </h2>

                </div>


                <div class="kx-option-row">

                    <span>
                        Descuento máximo
                    </span>

                    <strong>
                        @Model.DescuentoMaximo.ToString("0.##") %
                    </strong>

                </div>


                <div class="kx-option-row">

                    <span>
                        Venta sin stock
                    </span>

                    <label class="kx-switch">

                        <input type="checkbox"
                               checked="@Model.PermitirVentaSinStock"
                               disabled />

                        <span></span>

                    </label>

                </div>


                <div class="kx-option-row">

                    <span>
                        Modificar precio
                    </span>

                    <label class="kx-switch">

                        <input type="checkbox"
                               checked="@Model.PermitirCambioPrecio"
                               disabled />

                        <span></span>

                    </label>

                </div>


                <div class="kx-option-row">

                    <span>
                        Ventas a crédito
                    </span>

                    <label class="kx-switch">

                        <input type="checkbox"
                               checked="@Model.PermitirVentaCredito"
                               disabled />

                        <span></span>

                    </label>

                </div>


                <div class="kx-card-actions">

                    <a href="/Configuracion/Venta"
                       class="kx-btn-primary">

                        Configurar ventas

                    </a>

                </div>

            </article>

                <!-- ================================================= -->
                <!-- MONEDAS E IMPUESTOS -->
                <!-- ================================================= -->

                <article class="kx-card"
                         data-search="monedas impuestos igv">

                    <div class="kx-card-title">

                        <span uk-icon="icon: credit-card"></span>

                        <h2>
                            Monedas e Impuestos
                        </h2>

                    </div>


                    <!-- ============================================= -->
                    <!-- MONEDAS -->
                    <!-- ============================================= -->

                    <div class="kx-table-wrap">

                        <table class="kx-table">

                            <thead>

                                <tr>

                                    <th>
                                        Moneda
                                    </th>

                                    <th>
                                        Símbolo
                                    </th>

                                    <th>
                                        Dec.
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (Model.Monedas.Count == 0)
                                {
                                    <tr>

                                        <td colspan="3"
                                            class="kx-empty">

                                            Sin monedas configuradas.

                                        </td>

                                    </tr>
                                }
                                else
                                {
                                    @foreach (var moneda in Model.Monedas)
                                    {
                                        <tr>

                                            <td>
                                                @moneda.Codigo
                                            </td>

                                            <td>
                                                @moneda.Simbolo
                                            </td>

                                            <td>
                                                @moneda.CantidadDecimales
                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>

                    </div>


                    <!-- ============================================= -->
                    <!-- IMPUESTOS -->
                    <!-- ============================================= -->
                    @if (Model.Impuestos.Count == 0)
                    {
                        <div class="kx-empty-box">

                            <span uk-icon="icon: info"></span>

                            <strong>
                                Sin impuestos configurados
                            </strong>

                        </div>
                    }
                    else
                    {
                        @foreach (var impuesto in Model.Impuestos)
                        {
                            <div class="kx-tax-row">

                                <span>
                                    @impuesto.Nombre
                                </span>

                                <strong>
                                    @impuesto.Porcentaje.ToString("0.##") %
                                </strong>

                            </div>
                        }
                    }


                    <!-- ============================================= -->
                    <!-- BOTONES -->
                    <!-- ============================================= -->

                    <div class="kx-card-actions">

                        <a href="/Configuracion/Monedas"
                           class="kx-btn-secondary">

                            Monedas

                        </a>

                        <a href="/Configuracion/Impuestos"
                           class="kx-btn-primary">

                            Impuestos

                        </a>

                    </div>

                </article>


            <!-- ================================================= -->
            <!-- BACKUPS -->
            <!-- ================================================= -->

            <article class="kx-card"
                     data-search="backup respaldo copia seguridad">

                <div class="kx-card-title">

                    <span uk-icon="icon: cloud-upload"></span>

                    <h2>
                        Copias de Seguridad
                    </h2>

                </div>


                @if (Model.UltimaCopia is null)
                {
                    <div class="kx-empty-box">

                        <span uk-icon="icon: warning"></span>

                        <strong>
                            Sin respaldos registrados
                        </strong>

                        <p>
                            Todavía no existe una copia
                            de seguridad registrada.
                        </p>

                    </div>
                }
                else
                {
                    <div class="kx-system-list">

                        <div>

                            <span>
                                Estado
                            </span>

                            <strong>
                                @Model.UltimaCopia.Estado
                            </strong>

                        </div>


                        <div>

                            <span>
                                Tipo
                            </span>

                            <strong>
                                @Model.UltimaCopia.TipoCopia
                            </strong>

                        </div>


                        <div>

                            <span>
                                Archivo
                            </span>

                            <strong class="kx-text-truncate">
                                @Model.UltimaCopia.NombreArchivo
                            </strong>

                        </div>


                        <div>

                            <span>
                                Fecha
                            </span>

                            <strong>

                                @(Model.UltimaCopia.FechaFin.HasValue
                                    ? Model.UltimaCopia.FechaFin.Value
                                        .ToString("dd/MM/yyyy HH:mm")
                                    : Model.UltimaCopia.FechaInicio
                                        .ToString("dd/MM/yyyy HH:mm"))

                            </strong>

                        </div>

                    </div>
                }


                <div class="kx-card-actions">

                    <a href="/Configuracion/Backups"
                       class="kx-btn-primary">

                        Gestionar respaldos

                    </a>

                </div>

            </article>


            <!-- ================================================= -->
            <!-- MANTENIMIENTO -->
            <!-- ================================================= -->

            <article class="kx-card kx-card-wide"
                     data-search="mantenimiento base datos índices estadísticas">

                <div class="kx-card-title row-between">

                    <div>

                        <span uk-icon="icon: settings"></span>

                        <h2>
                            Mantenimiento de Base de Datos
                        </h2>

                    </div>


                    <a href="/Configuracion/Mantenimiento"
                       class="kx-btn-primary">

                        Administrar

                    </a>

                </div>


                <div class="kx-table-wrap">

                    <table class="kx-table">

                        <thead>

                        <tr>

                            <th>
                                Proceso
                            </th>

                            <th>
                                Tipo
                            </th>

                            <th>
                                Frecuencia
                            </th>

                            <th>
                                Hora
                            </th>

                            <th>
                                Estado
                            </th>

                        </tr>

                        </thead>


                        <tbody>

                        @if (Model.Planes.Count == 0)
                        {
                            <tr>

                                <td colspan="5"
                                    class="kx-empty">

                                    No existen planes activos.

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var plan in Model.Planes)
                            {
                                <tr>

                                    <td>
                                        @plan.Nombre
                                    </td>

                                    <td>
                                        @plan.TipoTarea
                                    </td>

                                    <td>
                                        @plan.Frecuencia
                                    </td>

                                    <td>

                                        @(plan.HoraEjecucion.HasValue
                                            ? plan.HoraEjecucion.Value
                                                .ToString(@"hh\:mm")
                                            : "Manual")

                                    </td>

                                    <td>

                                        <span class="kx-status active">
                                            Activo
                                        </span>

                                    </td>

                                </tr>
                            }
                        }

                        </tbody>

                    </table>

                </div>

            </article>


            <!-- ================================================= -->
            <!-- CONFIGURACION IA -->
            <!-- ================================================= -->

            <article class="kx-card kx-ai-card"
                     data-search="ia inteligencia pronóstico reposición anomalías">

                <div class="kx-card-title">

                    <span class="kx-ai-dot">
                        AI
                    </span>

                    <h2>
                        KerniX IA
                    </h2>

                </div>


                <div class="kx-ai-state">

                    <span>
                        Inteligencia artificial
                    </span>

                    <strong class="@(Model.IaActiva
                        ? "ok"
                        : "warning")">

                        @(Model.IaActiva
                            ? "ACTIVA"
                            : "DESACTIVADA")

                    </strong>

                </div>


                <div class="kx-option-row">

                    <span>
                        Reposición inteligente
                    </span>

                    <strong>
                        @(Model.IaReposicion
                            ? "Activa"
                            : "Desactivada")
                    </strong>

                </div>


                <div class="kx-option-row">

                    <span>
                        Pronóstico de ventas
                    </span>

                    <strong>
                        @(Model.IaPronosticoVentas
                            ? "Activo"
                            : "Desactivado")
                    </strong>

                </div>


                <div class="kx-option-row">

                    <span>
                        Detección de anomalías
                    </span>

                    <strong>
                        @(Model.IaAnomalias
                            ? "Activa"
                            : "Desactivada")
                    </strong>

                </div>


                <div class="kx-card-actions">

                    <a href="/Configuracion/IA"
                       class="kx-btn-primary">

                        Configurar IA

                    </a>

                    <a href="/IA/Index"
                       class="kx-btn-secondary">

                        Abrir IA

                    </a>

                </div>

            </article>


            <!-- ================================================= -->
            <!-- DIAGNOSTICO -->
            <!-- ================================================= -->

            <article class="kx-card"
                     data-search="diagnóstico configuración observaciones">

                <div class="kx-card-title">

                    <span uk-icon="icon: check"></span>

                    <h2>
                        Diagnóstico de Configuración
                    </h2>

                </div>


                <div class="kx-diagnostic-state
                    @(configuracionCompleta
                        ? "complete"
                        : "warning")">

                    <strong>
                        @estadoConfiguracion
                    </strong>

                    <span>

                        @(Model.Validacion?
                            .Estado
                            .TotalObservaciones ?? 0)

                        observación(es)

                    </span>

                </div>


                <div class="kx-system-list">

                    <div>

                        <span>
                            Críticas
                        </span>

                        <strong class="danger">

                            @(Model.Validacion?
                                .Estado
                                .Criticas ?? 0)

                        </strong>

                    </div>


                    <div>

                        <span>
                            Altas
                        </span>

                        <strong class="warning">

                            @(Model.Validacion?
                                .Estado
                                .Altas ?? 0)

                        </strong>

                    </div>


                    <div>

                        <span>
                            Medias
                        </span>

                        <strong>

                            @(Model.Validacion?
                                .Estado
                                .Medias ?? 0)

                        </strong>

                    </div>

                </div>

            </article>


            <!-- ================================================= -->
            <!-- ALERTAS -->
            <!-- ================================================= -->

            <article class="kx-card"
                     data-search="alertas errores mantenimiento">

                <div class="kx-card-title">

                    <span uk-icon="icon: warning"></span>

                    <h2>
                        Alertas Técnicas
                    </h2>

                </div>


                @if (Model.Alertas.Count == 0)
                {
                    <div class="kx-empty-box success">

                        <span uk-icon="icon: check"></span>

                        <strong>
                            Sin alertas pendientes
                        </strong>

                        <p>
                            El módulo técnico no tiene
                            incidencias pendientes.
                        </p>

                    </div>
                }
                else
                {
                    @foreach (var alerta in Model.Alertas.Take(4))
                    {
                        <div class="kx-alert">

                            <div>

                                <strong>
                                    @alerta.Titulo
                                </strong>

                                <span>
                                    @alerta.TipoAlerta
                                </span>

                            </div>


                            <span class="kx-alert-severity">
                                @alerta.Severidad
                            </span>

                        </div>
                    }
                }

            </article>


            <!-- ================================================= -->
            <!-- SEGURIDAD -->
            <!-- ================================================= -->

            <article class="kx-card"
                     data-search="seguridad contraseña sesión intentos">

                <div class="kx-card-title">

                    <span uk-icon="icon: lock"></span>

                    <h2>
                        Seguridad
                    </h2>

                </div>


                <div class="kx-system-list">

                    <div>

                        <span>
                            Intentos máximos de acceso
                        </span>

                        <strong>

                            @Model.ObtenerValorParametro(
                                "INTENTOS_LOGIN_MAXIMOS",
                                "5")

                        </strong>

                    </div>


                    <div>

                        <span>
                            Expiración de sesión
                        </span>

                        <strong>

                            @Model.ObtenerValorParametro(
                                "MINUTOS_EXPIRACION_SESION",
                                "30") min

                        </strong>

                    </div>


                    <div>

                        <span>
                            Longitud mínima contraseña
                        </span>

                        <strong>

                            @Model.ObtenerValorParametro(
                                "LONGITUD_MINIMA_PASSWORD",
                                "8")

                        </strong>

                    </div>

                </div>


                <div class="kx-card-actions">

                    <a href="/Configuracion/Seguridad"
                       class="kx-btn-primary">

                        Configurar seguridad

                    </a>

                </div>

            </article>

        </section>

    </main>

</div>


<!-- ========================================================= -->
<!-- UIKIT -->
<!-- ========================================================= -->

<script src="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/js/uikit.min.js">
</script>

<script src="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/js/uikit-icons.min.js">
</script>


<!-- ========================================================= -->
<!-- BUSCADOR -->
<!-- ========================================================= -->

<script>

    const search =
        document.getElementById(
            "kxSearch");

    const cards =
        document.querySelectorAll(
            "[data-search]");

    search?.addEventListener(
        "input",
        function () {

            const value =
                this.value
                    .trim()
                    .toLowerCase();

            cards.forEach(
                card => {

                    const content =
                        (
                            card.dataset.search +
                            " " +
                            card.innerText
                        )
                            .toLowerCase();

                    card.style.display =
                        content.includes(value)
                            ? ""
                            : "none";

                });

        });

</script>

</body>

</html>