            </div>

            <div class="kx-modal-footer">

                <button type="button"
                        class="kx-btn"
                        data-cerrar-modal>

                    Cancelar

                </button>

                <button type="submit"
                        form="formCliente"
                        class="kx-btn kx-btn-primary"
                        id="guardarCliente">

                    <span uk-icon="check"></span>
                    Guardar cliente

                </button>

            </div>

        </div>

    </div>

    <!-- ==========================================
         MODAL DETALLE
    ========================================== -->

    <div class="kx-modal"
         id="modalDetalle"
         hidden>

        <div class="kx-modal-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="tituloDetalle">

            <div class="kx-modal-header">

                <div>

                    <h2 id="tituloDetalle">
                        Detalle del cliente
                    </h2>

                    <p>
                        Información registrada en KerniX.
                    </p>

                </div>

                <button type="button"
                        class="kx-icon-btn"
                        data-cerrar-detalle
                        aria-label="Cerrar">

                    <span uk-icon="close"></span>

                </button>

            </div>

            <div class="kx-modal-body"
                 id="contenidoDetalle">

                Cargando información...

            </div>

            <div class="kx-modal-footer">

                <button type="button"
                        class="kx-btn"
                        data-cerrar-detalle>

                    Cerrar

                </button>

            </div>

        </div>

    </div>

    <!-- UIKIT -->

    <script src="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/js/uikit.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/js/uikit-icons.min.js"></script>

    <!-- ==========================================
         JAVASCRIPT CLIENTES
    ========================================== -->

    <script>

            "use strict";

            const CONFIG_CLIENTES = {
                idEmpresa: @Model.IdEmpresa,
                paginaTamano: 10
            };

            let clientes = [];
            let clientesFiltrados = [];
            let paginaActual = 1;
            let enviandoFormulario = false;
            let toastTimeout = null;

            const $ = id => document.getElementById(id);

            // ==========================================
            // UTILIDADES
            // ==========================================

            function escapar(valor) {

                return String(valor ?? "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#39;");

            }

            function normalizarTexto(valor) {

                return String(valor ?? "")
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .toLowerCase()
                    .trim();

            }

            function normalizarTipo(valor) {

                const tipo = normalizarTexto(valor);

                if (
                    tipo === "empresa" ||
                    tipo === "juridica" ||
                    tipo === "juridico"
                ) {
                    return "juridico";
                }

                return "natural";

            }

            function nombreCliente(cliente) {

                return cliente.razonSocial ||
                    cliente.nombreCompleto ||
                    [
                        cliente.nombres,
                        cliente.apellidos
                    ].filter(Boolean).join(" ") ||
                    "Cliente sin nombre";

            }

            function valorCampo(id) {

                return $(id)?.value.trim() ?? "";

            }

            function tokenAntiforgery() {

                return document.querySelector(
                    '#formTokenClientes input[name="__RequestVerificationToken"]'
                )?.value ?? "";

            }

            function mostrarToast(mensaje, error = false) {

                document.querySelector(".kx-toast")?.remove();

                if (toastTimeout) {
                    clearTimeout(toastTimeout);
                }

                const toast = document.createElement("div");

                toast.className =
                    "kx-toast" + (error ? " error" : "");

                toast.textContent = mensaje;

                document.body.appendChild(toast);

                toastTimeout = setTimeout(() => {
                    toast.remove();
                }, 4000);

            }

            function mensajeFormulario(mensaje) {

                const elemento = $("mensajeFormulario");

                elemento.textContent = mensaje;
                elemento.hidden = !mensaje;

            }

            // ==========================================
            // REQUEST A RAZOR
            // ==========================================

            async function solicitar(
                handler,
                metodo = "GET",
                datos = null,
                parametros = {}
            ) {

                const url = new URL(
                    window.location.pathname,
                    window.location.origin
                );

                url.searchParams.set("handler", handler);

                Object.entries(parametros).forEach(([clave, valor]) => {
                    url.searchParams.set(clave, valor);
                });

                const opciones = {
                    method: metodo,
                    credentials: "same-origin",
                    headers: {
                        "Accept": "application/json"
                    }
                };

                if (metodo !== "GET") {

                    opciones.headers["RequestVerificationToken"] =
                        tokenAntiforgery();

                }

                if (datos !== null) {

                    opciones.headers["Content-Type"] =
                        "application/json";

                    opciones.body = JSON.stringify(datos);

                }

                const response = await fetch(url, opciones);

                const texto = await response.text();

                let resultado;

                try {

                    resultado = JSON.parse(texto);

                }
                catch {

                    if (
                        response.status === 401 ||
                        response.redirected
                    ) {

                        throw new Error(
                            "Tu sesión ha expirado. Inicia sesión nuevamente."
                        );

                    }

                    throw new Error(
                        "El servidor devolvió una respuesta no válida."
                    );

                }

                if (!response.ok || resultado.success !== true) {

                    throw new Error(
                        resultado.message ||
                        `Error HTTP ${response.status}`
                    );

                }

                return resultado;

            }

            // ==========================================
            // LISTAR CLIENTES
            // ==========================================

            async function cargarClientes(silencioso = false) {

                $("tablaClientes").innerHTML = `
                                                    <tr>
                                                        <td colspan="6" class="kx-empty">
                                                            Cargando clientes...
                                                        </td>
                                                    </tr>
                                                `;

                try {

                    const resultado = await solicitar("Listar");

                    clientes = Array.isArray(resultado.data?.items)
                        ? resultado.data.items
                        : [];

                    actualizarIndicadores();

                    aplicarFiltros();

                }
                catch (error) {

                    clientes = [];
                    clientesFiltrados = [];

                    actualizarIndicadores();

                    $("tablaClientes").innerHTML = `
                                                        <tr>
                                                            <td colspan="6" class="kx-empty">
                                                                ${escapar(error.message)}
                                                            </td>
                                                        </tr>
                                                    `;

                    $("contadorClientes").textContent = "0 clientes";
                    $("textoPaginacion").textContent = "Sin datos";
                    $("paginaAnterior").disabled = true;
                    $("paginaSiguiente").disabled = true;

                    if (!silencioso) mostrarToast(error.message, true);

                }

            }

            // ==========================================
            // INDICADORES
            // ==========================================

            function actualizarIndicadores() {

                const total = clientes.length;

                const activos = clientes.filter(
                    x => x.estado === true
                ).length;

                const juridicos = clientes.filter(
                    x => normalizarTipo(x.tipoCliente) === "juridico"
                ).length;

                $("statTotal").textContent = total;
                $("statActivos").textContent = activos;
                $("statJuridicos").textContent = juridicos;
                $("statInactivos").textContent = total - activos;

            }

            // ==========================================
            // FILTROS
            // ==========================================

            function aplicarFiltros() {

                const busqueda =
                    normalizarTexto($("buscarClientes").value);

                const tipo = $("filtroTipo").value;

                const estado = $("filtroEstado").value;

                clientesFiltrados = clientes.filter(cliente => {

                    const texto = normalizarTexto([
                        nombreCliente(cliente),
                        cliente.numeroDocumento,
                        cliente.tipoDocumento,
                        cliente.correo,
                        cliente.telefono
                    ].join(" "));

                    if (busqueda && !texto.includes(busqueda)) {
                        return false;
                    }

                    if (
                        tipo &&
                        normalizarTipo(cliente.tipoCliente) !== tipo
                    ) {
                        return false;
                    }

                    if (
                        estado === "activo" &&
                        cliente.estado !== true
                    ) {
                        return false;
                    }

                    if (
                        estado === "inactivo" &&
                        cliente.estado === true
                    ) {
                        return false;
                    }

                    return true;

                });

                paginaActual = 1;

                renderizarClientes();

            }

            // ==========================================
            // TABLA
            // ==========================================

            function renderizarClientes() {

                const tbody = $("tablaClientes");

                const total = clientesFiltrados.length;

                const totalPaginas = Math.max(
                    1,
                    Math.ceil(total / CONFIG_CLIENTES.paginaTamano)
                );

                paginaActual = Math.min(
                    paginaActual,
                    totalPaginas
                );

                const inicio =
                    (paginaActual - 1) *
                    CONFIG_CLIENTES.paginaTamano;

                const registros = clientesFiltrados.slice(
                    inicio,
                    inicio + CONFIG_CLIENTES.paginaTamano
                );

                $("contadorClientes").textContent =
                    `${total} clientes`;

                $("textoPaginacion").textContent =
                    total === 0
                        ? "0 registros"
                        : `Mostrando ${inicio + 1} - ${Math.min(
                            inicio + registros.length,
                            total
                        )} de ${total}`;

                $("paginaAnterior").disabled =
                    paginaActual <= 1;

                $("paginaSiguiente").disabled =
                    paginaActual >= totalPaginas;

                if (!registros.length) {

                    tbody.innerHTML = `
                                                        <tr>
                                                            <td colspan="6" class="kx-empty">
                                                                No se encontraron clientes.
                                                            </td>
                                                        </tr>
                                                    `;

                    return;

                }

                tbody.innerHTML = registros.map(cliente => {

                    const id = Number(cliente.idCliente);

                    const nombre = nombreCliente(cliente);

                    const inicial = nombre.charAt(0).toUpperCase();

                    const activo = cliente.estado === true;

                    const tipo = normalizarTipo(cliente.tipoCliente);

                    return `
                                                        <tr>

                                                            <td>

                                                                <div class="kx-client">

                                                                    <div class="kx-avatar">
                                                                        ${escapar(inicial)}
                                                                    </div>

                                                                    <div>

                                                                        <strong>
                                                                            ${escapar(nombre)}
                                                                        </strong>

                                                                        <small>
                                                                            Cliente #${id}
                                                                        </small>

                                                                    </div>

                                                                </div>

                                                            </td>

                                                            <td>
                                                                ${escapar(cliente.tipoDocumento)}
                                                                <br>
                                                                <strong>
                                                                    ${escapar(cliente.numeroDocumento)}
                                                                </strong>
                                                            </td>

                                                            <td>

                                                                <span class="kx-badge type">
                                                                    ${tipo === "juridico"
                            ? "Jurídico"
                            : "Natural"}
                                                                </span>

                                                            </td>

                                                            <td>
                                                                <div class="kx-contact">
                                                                    <span class="kx-contact-phone" title="${escapar(cliente.telefono || 'Sin teléfono')}">
                                                                        ${escapar(cliente.telefono || "Sin teléfono")}
                                                                    </span>
                                                                    <small class="kx-contact-mail" title="${escapar(cliente.correo || 'Sin correo')}">
                                                                        ${escapar(cliente.correo || "Sin correo")}
                                                                    </small>
                                                                </div>
                                                            </td>

                                                            <td>

                                                                <span class="kx-badge ${activo
                            ? "active"
                            : "inactive"}">

                                                                    ${activo ? "Activo" : "Inactivo"}

                                                                </span>

                                                            </td>

                                                            <td>

                                                                <div class="kx-table-actions">

                                                                    <button type="button"
                                                                            class="kx-icon-btn"
                                                                            data-accion="editar"
                                                                            data-id="${id}"
                                                                            title="Editar cliente"
                                                                            aria-label="Editar cliente">

                                                                        <span uk-icon="file-edit"></span>

                                                                    </button>

                                                                    <button type="button"
                                                                            class="kx-icon-btn"
                                                                            data-accion="estado"
                                                                            data-id="${id}"
                                                                            title="${activo
                            ? "Desactivar"
                            : "Activar"}"
                                                                            aria-label="${activo
                            ? "Desactivar"
                            : "Activar"}">

                                                                        <span uk-icon="${activo
                            ? "ban"
                            : "check"}"></span>

                                                                    </button>

                                                                </div>

                                                            </td>

                                                        </tr>
                                                    `;

                }).join("");

                // UIkit detecta los elementos [uk-icon] añadidos dinámicamente.
                // NO ejecutar UIkit.icon(tbody): tbody no es un icono y
                // esa llamada puede reemplazar el contenido de la tabla.

            }

            // ==========================================
            // MODALES
            // ==========================================

            function abrirModal(id) {

                $(id).hidden = false;

                document.body.style.overflow = "hidden";

            }

            function cerrarModal(id) {

                $(id).hidden = true;

                if (
                    $("modalCliente").hidden &&
                    $("modalDetalle").hidden
                ) {

                    document.body.style.overflow = "";

                }

            }

            function limpiarFormulario() {

                $("formCliente").reset();

                $("idCliente").value = "0";

                $("listaContactos").innerHTML = "";
                $("listaDirecciones").innerHTML = "";

                mensajeFormulario("");

                cambiarTipoCliente();

            }

            function nuevoCliente() {

                limpiarFormulario();

                $("tituloModalCliente").textContent =
                    "Registrar cliente";

                abrirModal("modalCliente");

                $("numeroDocumento").focus();

            }

            function cambiarTipoCliente() {

                const juridico =
                    $("tipoCliente").value === "juridico";

                $("grupoNombres").hidden = juridico;
                $("grupoApellidos").hidden = juridico;

                $("grupoRazonSocial").hidden = !juridico;

                $("nombres").required = !juridico;
                $("apellidos").required = !juridico;
                $("razonSocial").required = juridico;

                if (juridico) {

                    $("tipoDocumento").value = "RUC";

                }
                else if ($("tipoDocumento").value === "RUC") {

                    $("tipoDocumento").value = "DNI";

                }

            }

            // ==========================================
            // CONTACTOS
            // ==========================================

            function agregarContacto(datos = {}) {

                const contenedor = document.createElement("div");

                contenedor.className = "kx-extra-card";

                contenedor.innerHTML = `
                                                    <div class="kx-extra-header">

                                                        <strong>Contacto</strong>

                                                        <button type="button"
                                                                class="kx-icon-btn"
                                                                data-eliminar-extra
                                                                aria-label="Eliminar contacto">

                                                            <span uk-icon="trash"></span>

                                                        </button>

                                                    </div>

                                                    <div class="kx-form-grid">

                                                        <div class="kx-field">

                                                            <label>Nombre</label>

                                                            <input class="kx-input"
                                                                   data-campo="nombres"
                                                                   maxlength="150" />

                                                        </div>

                                                        <div class="kx-field">

                                                            <label>Cargo</label>

                                                            <input class="kx-input"
                                                                   data-campo="cargo"
                                                                   maxlength="100" />

                                                        </div>

                                                        <div class="kx-field">

                                                            <label>Teléfono</label>

                                                            <input class="kx-input"
                                                                   data-campo="telefono"
                                                                   maxlength="20" />

                                                        </div>

                                                        <div class="kx-field">

                                                            <label>Correo</label>

                                                            <input class="kx-input"
                                                                   type="email"
                                                                   data-campo="correo"
                                                                   maxlength="250" />

                                                        </div>

                                                        <div class="kx-field full">

                                                            <label class="kx-check">

                                                                <input type="checkbox"
                                                                       data-campo="esPrincipal" />

                                                                Contacto principal

                                                            </label>

                                                        </div>

                                                    </div>
                                                `;

                ["nombres", "cargo", "telefono", "correo"]
                    .forEach(campo => {

                        contenedor.querySelector(
                            `[data-campo="${campo}"]`
                        ).value = datos[campo] ?? "";

                    });

                contenedor.querySelector(
                    '[data-campo="esPrincipal"]'
                ).checked = datos.esPrincipal === true;

                $("listaContactos").appendChild(contenedor);

                return contenedor;

            }

            function obtenerContactos() {

                return [
                    ...$("listaContactos").children
                ].map(card => ({

                    nombres: card.querySelector(
                        '[data-campo="nombres"]'
                    ).value.trim(),

                    cargo: card.querySelector(
                        '[data-campo="cargo"]'
                    ).value.trim(),

                    telefono: card.querySelector(
                        '[data-campo="telefono"]'
                    ).value.trim(),

                    correo: card.querySelector(
                        '[data-campo="correo"]'
                    ).value.trim(),

                    esPrincipal: card.querySelector(
                        '[data-campo="esPrincipal"]'
                    ).checked,

                    estado: true

                }));

            }

            // ==========================================
            // DIRECCIONES
            // ==========================================

            function agregarDireccion(datos = {}) {

                const contenedor = document.createElement("div");

                contenedor.className = "kx-extra-card";

                contenedor.innerHTML = `
                                                    <div class="kx-extra-header">

                                                        <strong>Dirección</strong>

                                                        <button type="button"
                                                                class="kx-icon-btn"
                                                                data-eliminar-extra
                                                                aria-label="Eliminar dirección">

                                                            <span uk-icon="trash"></span>

                                                        </button>

                                                    </div>

                                                    <div class="kx-form-grid">

                                                        <div class="kx-field">

                                                            <label>Tipo</label>

                                                            <input class="kx-input"
                                                                   data-campo="tipoDireccion"
                                                                   placeholder="Fiscal, entrega..." />

                                                        </div>

                                                        <div class="kx-field">

                                                            <label>Ubigeo</label>

                                                            <input class="kx-input"
                                                                   data-campo="ubigeo"
                                                                   maxlength="6" />

                                                        </div>

                                                        <div class="kx-field full">

                                                            <label>Dirección</label>

                                                            <input class="kx-input"
                                                                   data-campo="direccion" />

                                                        </div>

                                                        <div class="kx-field">

                                                            <label>Distrito</label>

                                                            <input class="kx-input"
                                                                   data-campo="distrito" />

                                                        </div>

                                                        <div class="kx-field">

                                                            <label>Provincia</label>

                                                            <input class="kx-input"
                                                                   data-campo="provincia" />

                                                        </div>

                                                        <div class="kx-field">

                                                            <label>Departamento</label>

                                                            <input class="kx-input"
                                                                   data-campo="departamento" />

                                                        </div>

                                                        <div class="kx-field full">

                                                            <label>Referencia</label>

                                                            <input class="kx-input"
                                                                   data-campo="referencia" />

                                                        </div>

                                                        <div class="kx-field full">

                                                            <label class="kx-check">

                                                                <input type="checkbox"
                                                                       data-campo="esPrincipal" />

                                                                Dirección principal

                                                            </label>

                                                        </div>

                                                    </div>
                                                `;

                [
                    "tipoDireccion",
                    "ubigeo",
                    "direccion",
                    "distrito",
                    "provincia",
                    "departamento",
                    "referencia"
                ].forEach(campo => {

                    contenedor.querySelector(
                        `[data-campo="${campo}"]`
                    ).value = datos[campo] ?? "";

                });

                contenedor.querySelector(
                    '[data-campo="esPrincipal"]'
                ).checked = datos.esPrincipal === true;

                $("listaDirecciones").appendChild(contenedor);

                return contenedor;

            }

            function obtenerDirecciones() {

                return [
                    ...$("listaDirecciones").children
                ].map(card => {

                    const leer = campo => {

                        return card.querySelector(
                            `[data-campo="${campo}"]`
                        ).value.trim();

                    };

                    return {

                        tipoDireccion: leer("tipoDireccion"),
                        direccion: leer("direccion"),
                        referencia: leer("referencia"),
                        distrito: leer("distrito"),
                        provincia: leer("provincia"),
                        departamento: leer("departamento"),
                        ubigeo: leer("ubigeo"),

                        esPrincipal: card.querySelector(
                            '[data-campo="esPrincipal"]'
                        ).checked,

                        estado: true

                    };

                });

            }

            // ==========================================
            // EDITAR
            // ==========================================

            async function editarCliente(id) {

                try {

                    const resultado = await solicitar(
                        "Obtener",
                        "GET",
                        null,
                        { idCliente: id }
                    );

                    const cliente = resultado.data;

                    limpiarFormulario();

                    $("idCliente").value = cliente.idCliente;

                    $("tipoCliente").value =
                        normalizarTipo(cliente.tipoCliente);

                    cambiarTipoCliente();

                    $("tipoDocumento").value =
                        String(cliente.tipoDocumento || "DNI")
                            .toUpperCase();

                    $("numeroDocumento").value =
                        cliente.numeroDocumento || "";

                    $("razonSocial").value =
                        cliente.razonSocial || "";

                    $("nombres").value =
                        cliente.nombres || "";

                    $("apellidos").value =
                        cliente.apellidos || "";

                    $("telefono").value =
                        cliente.telefono || "";

                    $("correo").value =
                        cliente.correo || "";

                    (cliente.contactos || []).forEach(
                        agregarContacto
                    );

                    (cliente.direcciones || []).forEach(
                        agregarDireccion
                    );

                    $("tituloModalCliente").textContent =
                        "Editar cliente";

                    abrirModal("modalCliente");

                }
                catch (error) {

                    mostrarToast(error.message, true);

                }

            }

            // ==========================================
            // GUARDAR
            // ==========================================

            async function guardarCliente(event) {

                event.preventDefault();

                if (enviandoFormulario) {
                    return;
                }

                mensajeFormulario("");

                const form = $("formCliente");

                if (!form.checkValidity()) {

                    form.reportValidity();

                    return;

                }

                const idCliente =
                    Number($("idCliente").value || 0);

                const tipoCliente =
                    $("tipoCliente").value;

                const tipoDocumento =
                    $("tipoDocumento").value;

                const documento =
                    valorCampo("numeroDocumento");

                if (
                    tipoDocumento === "DNI" &&
                    !/^\d{8}$/.test(documento)
                ) {

                    mensajeFormulario(
                        "El DNI debe contener exactamente 8 dígitos."
                    );

                    return;

                }

                if (
                    tipoDocumento === "RUC" &&
                    !/^\d{11}$/.test(documento)
                ) {

                    mensajeFormulario(
                        "El RUC debe contener exactamente 11 dígitos."
                    );

                    return;

                }

                if (
                    obtenerContactos().filter(
                        x => x.esPrincipal
                    ).length > 1
                ) {

                    mensajeFormulario(
                        "Solo puedes seleccionar un contacto principal."
                    );

                    return;

                }

                if (
                    obtenerDirecciones().filter(
                        x => x.esPrincipal
                    ).length > 1
                ) {

                    mensajeFormulario(
                        "Solo puedes seleccionar una dirección principal."
                    );

                    return;

                }

                const request = {

                    idEmpresa: CONFIG_CLIENTES.idEmpresa,

                    tipoCliente: tipoCliente,

                    tipoDocumento: tipoDocumento,

                    numeroDocumento: documento,

                    razonSocial: tipoCliente === "juridico"
                        ? valorCampo("razonSocial")
                        : null,

                    nombres: tipoCliente === "natural"
                        ? valorCampo("nombres")
                        : null,

                    apellidos: tipoCliente === "natural"
                        ? valorCampo("apellidos")
                        : null,

                    telefono: valorCampo("telefono"),

                    correo: valorCampo("correo") || null,

                    contactos: obtenerContactos(),

                    direcciones: obtenerDirecciones()

                };

                enviandoFormulario = true;

                const boton = $("guardarCliente");

                boton.disabled = true;

                try {

                    const editar = idCliente > 0;

                    const resultado = await solicitar(
                        editar ? "Actualizar" : "Registrar",
                        "POST",
                        request,
                        editar ? { idCliente } : {}
                    );

                    cerrarModal("modalCliente");

                    mostrarToast(
                        resultado.message ||
                        "Cliente guardado correctamente."
                    );

                    await cargarClientes();

                }
                catch (error) {

                    mensajeFormulario(error.message);

                }
                finally {

                    enviandoFormulario = false;

                    boton.disabled = false;

                }

            }

            // ==========================================
            // DETALLE
            // ==========================================

            async function verDetalle(id) {

                $("contenidoDetalle").textContent =
                    "Cargando información...";

                abrirModal("modalDetalle");

                try {

                    const resultado = await solicitar(
                        "Obtener",
                        "GET",
                        null,
                        { idCliente: id }
                    );

                    const cliente = resultado.data;

                    const indicadores = cliente.indicadores || {};

                    const contactos = cliente.contactos || [];

                    const direcciones = cliente.direcciones || [];

                    const dinero = valor => {

                        return new Intl.NumberFormat(
                            "es-PE",
                            {
                                style: "currency",
                                currency: "PEN"
                            }
                        ).format(Number(valor || 0));

                    };

                    $("contenidoDetalle").innerHTML = `

                                                        <div class="kx-detail-grid">

                                                            <div class="kx-detail-item">

                                                                <small>Cliente</small>

                                                                <strong>
                                                                    ${escapar(nombreCliente(cliente))}
                                                                </strong>

                                                            </div>

                                                            <div class="kx-detail-item">

                                                                <small>Documento</small>

                                                                <strong>
                                                                    ${escapar(cliente.tipoDocumento)}
                                                                    ${escapar(cliente.numeroDocumento)}
                                                                </strong>

                                                            </div>

                                                            <div class="kx-detail-item">

                                                                <small>Teléfono</small>

                                                                <strong>
                                                                    ${escapar(cliente.telefono || "No registrado")}
                                                                </strong>

                                                            </div>

                                                            <div class="kx-detail-item">

                                                                <small>Correo</small>

                                                                <strong>
                                                                    ${escapar(cliente.correo || "No registrado")}
                                                                </strong>

                                                            </div>

                                                            <div class="kx-detail-item">

                                                                <small>Total de ventas</small>

                                                                <strong>
                                                                    ${Number(indicadores.totalVentas ?? 0)}
                                                                </strong>

                                                            </div>

                                                            <div class="kx-detail-item">

                                                                <small>Total comprado</small>

                                                                <strong style="color:var(--gold)">
                                                                    ${dinero(indicadores.totalComprado)}
                                                                </strong>

                                                            </div>

                                                        </div>

                                                        <h3 style="color:var(--gold);margin-top:28px">
                                                            Contactos (${contactos.length})
                                                        </h3>

                                                        ${contactos.length
                            ? contactos.map(x => `

                                                                <div class="kx-detail-item"
                                                                     style="margin-bottom:10px">

                                                                    <strong>
                                                                        ${escapar(x.nombres)}
                                                                    </strong>

                                                                    <p style="color:var(--muted)">
                                                                        ${escapar(x.cargo || "")}
                                                                        <br>
                                                                        ${escapar(x.telefono || "")}
                                                                        <br>
                                                                        ${escapar(x.correo || "")}
                                                                    </p>

                                                                </div>

                                                            `).join("")
                            : `<p style="color:var(--muted)">
                                                                No hay contactos registrados.
                                                               </p>`
                        }

                                                        <h3 style="color:var(--gold);margin-top:28px">
                                                            Direcciones (${direcciones.length})
                                                        </h3>

                                                        ${direcciones.length
                            ? direcciones.map(x => `

                                                                <div class="kx-detail-item"
                                                                     style="margin-bottom:10px">

                                                                    <strong>
                                                                        ${escapar(x.tipoDireccion || "Dirección")}
                                                                    </strong>

                                                                    <p style="color:var(--muted)">
                                                                        ${escapar(x.direccion)}
                                                                        <br>
                                                                        ${escapar(x.distrito)}
                                                                        ${escapar(x.provincia)}
                                                                        ${escapar(x.departamento)}
                                                                    </p>

                                                                </div>

                                                            `).join("")
                            : `<p style="color:var(--muted)">
                                                                No hay direcciones registradas.
                                                               </p>`
                        }

                                                    `;

                }
                catch (error) {

                    $("contenidoDetalle").textContent =
                        error.message;

                    mostrarToast(error.message, true);

                }

            }

            // ==========================================
            // ESTADO
            // ==========================================

            async function cambiarEstado(id) {
                const cliente = clientes.find(
                    x => Number(x.idCliente) === Number(id)
                );
                if (!cliente) return;

                const activar = cliente.estado !== true;
                const mensaje = activar
                    ? "¿Deseas activar este cliente?"
                    : "¿Deseas desactivar este cliente?";
                if (!window.confirm(mensaje)) return;

                const boton = document.querySelector(
                    `#tablaClientes [data-accion="estado"][data-id="${id}"]`
                );
                if (boton) boton.disabled = true;

                let respuesta;
                let errorOperacion = null;
                try {
                    respuesta = await solicitar(
                        activar ? "Activar" : "Desactivar",
                        "POST", null, { idCliente: id }
                    );
                } catch (error) {
                    errorOperacion = error;
                }

                // Un POST puede haber cambiado el estado aunque la respuesta
                // devuelva un formato inesperado. Verificamos con un GET real.
                let estadoVerificado = null;
                try {
                    const consulta = await solicitar(
                        "Obtener", "GET", null, { idCliente: id }
                    );
                    if (typeof consulta.data?.estado === "boolean") {
                        estadoVerificado = consulta.data.estado;
                    }
                } catch (error) {
                    // La verificación falló; no se afirma éxito.
                }

                if (estadoVerificado === activar) {
                    // Actualizamos el estado local primero: la recarga fallida
                    // nunca debe convertir un éxito confirmado en toast rojo.
                    cliente.estado = activar;
                    actualizarIndicadores();
                    aplicarFiltros();
                    mostrarToast(activar
                        ? "Cliente activado correctamente."
                        : "Cliente desactivado correctamente.");
                } else if (errorOperacion) {
                    mostrarToast(errorOperacion.message, true);
                } else if (estadoVerificado !== null) {
                    mostrarToast("No se confirmó el cambio de estado. Revisa el cliente.", true);
                } else {
                    // La petición fue aceptada pero la verificación no se pudo
                    // completar: no afirmamos ni éxito ni fallo del cambio.
                    mostrarToast("Solicitud recibida; no se pudo verificar el estado. Actualiza la lista.", true);
                }
                if (boton?.isConnected) boton.disabled = false;
            }

            // ==========================================
            // EVENTOS
            // ==========================================

            document.addEventListener(
                "DOMContentLoaded",
                function() {

                    cargarClientes();

                    $("recargarClientes").addEventListener(
                        "click",
                        cargarClientes
                    );

                    $("abrirNuevoCliente").addEventListener(
                        "click",
                        nuevoCliente
                    );

                    $("buscarClientes").addEventListener(
                        "input",
                        aplicarFiltros
                    );

                    $("filtroTipo").addEventListener(
                        "change",
                        aplicarFiltros
                    );

                    $("filtroEstado").addEventListener(
                        "change",
                        aplicarFiltros
                    );

                    $("tipoCliente").addEventListener(
                        "change",
                        cambiarTipoCliente
                    );

                    $("formCliente").addEventListener(
                        "submit",
                        guardarCliente
                    );

                    $("agregarContacto").addEventListener(
                        "click",
                        () => agregarContacto()
                    );

                    $("agregarDireccion").addEventListener(
                        "click",
                        () => agregarDireccion()
                    );

                    $("paginaAnterior").addEventListener(
                        "click",
                        function() {

                            if (paginaActual > 1) {

                                paginaActual--;

                                renderizarClientes();

                            }

                        }
                    );

                    $("paginaSiguiente").addEventListener(
                        "click",
                        function() {

                            const totalPaginas = Math.ceil(
                                clientesFiltrados.length /
                                CONFIG_CLIENTES.paginaTamano
                            );

                            if (paginaActual < totalPaginas) {

                                paginaActual++;

                                renderizarClientes();

                            }

                        }
                    );

                    $("tablaClientes").addEventListener(
                        "click",
                        function(event) {

                            const boton = event.target.closest(
                                "[data-accion]"
                            );

                            if (!boton) {
                                return;
                            }

                            const id = Number(boton.dataset.id);

                            if (!Number.isInteger(id) || id <= 0) {
                                return;
                            }

                            switch (boton.dataset.accion) {

                                case "editar":
                                    editarCliente(id);
                                    break;

                                case "estado":
                                    cambiarEstado(id);
                                    break;

                            }

                        }
                    );

                    document.querySelectorAll(
                        "[data-cerrar-modal]"
                    ).forEach(boton => {

                        boton.addEventListener(
                            "click",
                            () => cerrarModal("modalCliente")
                        );

                    });

                    document.querySelectorAll(
                        "[data-cerrar-detalle]"
                    ).forEach(boton => {

                        boton.addEventListener(
                            "click",
                            () => cerrarModal("modalDetalle")
                        );

                    });

                    document.addEventListener(
                        "click",
                        function(event) {

                            const boton = event.target.closest(
                                "[data-eliminar-extra]"
                            );

                            if (boton) {

                                boton.closest(".kx-extra-card")?.remove();

                            }

                        }
                    );

                    document.addEventListener(
                        "keydown",
                        function(event) {

                            if (event.key !== "Escape") {
                                return;
                            }

                            if (!$("modalDetalle").hidden) {

                                cerrarModal("modalDetalle");

                            }
                            else if (!$("modalCliente").hidden) {

                                cerrarModal("modalCliente");

                            }

                        }
                    );

                }
            );

    </script>

</body>
</html>