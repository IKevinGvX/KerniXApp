<!-- =========================================================
     KERNIX - UX DEL ANÁLISIS
     ========================================================= -->

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            const form =
                document.querySelector(
                    '.ka-console form'
                );

            const button =
                document.querySelector(
                    '.ka-analyze'
                );

            if (!form || !button) {
                return;
            }


            form.addEventListener(
                "submit",
                function() {

                    button.disabled = true;

                    button.style.opacity = ".78";

                    button.style.cursor =
                        "wait";

                    button.innerHTML =
                        `
                            <span
                                uk-spinner="ratio:.55">
                            </span>

                            ANALIZANDO...
                            `;

                }
            );

        }
    );

</script>