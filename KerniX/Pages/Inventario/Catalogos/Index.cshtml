    </div>

</div>


<script>
    const KerniXCatalogos = (() => {

           "use strict";


    function bloquearPantalla(
        activo
            ) {
        document.body.style.overflow =
                    activo
                ? "hidden"
                : "";
            }


    function prepararEnvio(
        form
            ) {
        form?.addEventListener(
                    "submit",
            () => {

                const boton =
                    form.querySelector(
                                'button[type="submit"]'
                        );

                if (!boton) {
                    return;
                    }

                boton.disabled =
                    true;

                    boton.dataset.textoAnterior =
                        boton.textContent || "";

                boton.textContent =
                    "Guardando...";
                }
            );
        }


        const modalCategoria =
                document.getElementById(
            "modalCategoria"
        );

        const formCategoria =
                document.getElementById(
            "formCategoria"
        );

         const tituloCategoria =
                document.getElementById(
            "tituloCategoria"
        );

         const categoriaId =
                document.getElementById(
            "categoriaId"
        );

        const categoriaNombre =
                document.getElementById(
            "categoriaNombre"
        );

        const categoriaDescripcion =
                document.getElementById(
                "categoriaDescripcion"
        );

         const categoriaEstado =
            document.getElementById(
                "categoriaEstado"
        );

         const grupoEstadoCategoria =
            document.getElementById(
            "grupoEstadoCategoria"
            );


            const modalUnidad =
        document.getElementById(
            "modalUnidad"
                );

            const formUnidad =
                document.getElementById(
            "formUnidad"
            );

         const tituloUnidad =
            document.getElementById(
            "tituloUnidad"
                );

            const unidadId =
                document.getElementById(
                "unidadId"
        );

            const unidadCodigo =
            document.getElementById(
            "unidadCodigo"
            );

               const unidadNombre =
            document.getElementById(
            "unidadNombre"
                );

        const unidadAbreviatura =
               document.getElementById(
            "unidadAbreviatura"
            );

          const unidadEstado =
             document.getElementById(
                "unidadEstado"
        );

            const grupoEstadoUnidad =
            document.getElementById(
            "grupoEstadoUnidad"
            );


            const modalMarca =
            document.getElementById(
                "modalMarca"
            );

            const formMarca =
                document.getElementById(
                "formMarca"
                );

            const tituloMarca =
            document.getElementById(
                "tituloMarca"
                );

        const marcaId =
                document.getElementById(
                "marcaId"
            );

        const marcaNombre =
            document.getElementById(
                    "marcaNombre"
            );

            const marcaDescripcion =
            document.getElementById(
                "marcaDescripcion"
                );

            const marcaEstado =
                document.getElementById(
                "marcaEstado"
            );

        const grupoEstadoMarca =
            document.getElementById(
                    "grupoEstadoMarca"
            );


        function abrirNuevaCategoria() {

            tituloCategoria.textContent =
                "Nueva categoría";

            formCategoria.action =
                "/Inventario/Catalogos/Index?handler=CrearCategoria";

            categoriaId.value =
            "0";

                categoriaNombre.value =
            "";

            categoriaDescripcion.value =
                "";

            categoriaEstado.checked =
                true;

            grupoEstadoCategoria.style.display =
                "none";

            modalCategoria.classList.add(
                "open"
            );

            bloquearPantalla(
                true
            );

        setTimeout(
            () =>
                        categoriaNombre.focus(),
                60
            );
            }


            function editarCategoria(
        boton
            ) {

        tituloCategoria.textContent =
                "Editar categoría";

        formCategoria.action =
                "/Inventario/Catalogos/Index?handler=EditarCategoria";

            categoriaId.value =
            boton.dataset.id || "0";

            categoriaNombre.value =
                boton.dataset.nombre || "";

        categoriaDescripcion.value =
            boton.dataset.descripcion || "";

        categoriaEstado.checked =
                boton.dataset.estado === "1";

             grupoEstadoCategoria.style.display =
                "block";

                modalCategoria.classList.add(
            "open"
            );

             bloquearPantalla(
                true
        );
        }


        function cerrarCategoria() {

            modalCategoria.classList.remove(
                "open"
                );

            if (
            !modalUnidad.classList.contains(
                    "open"
            )
                &&
                !modalMarca.classList.contains(
                    "open"
            )
            ) {
                bloquearPantalla(
                false
                );
            }
            }


             function abrirNuevaUnidad() {

            tituloUnidad.textContent =
            "Nueva unidad de medida";

                formUnidad.action =
                "/Inventario/Catalogos/Index?handler=CrearUnidad";

            unidadId.value =
            "0";

        unidadCodigo.value =
            "";

            unidadNombre.value =
                "";

            unidadAbreviatura.value =
                "";

            unidadEstado.checked =
                    true;

            grupoEstadoUnidad.style.display =
                "none";

               modalUnidad.classList.add(
                "open"
                );

                   bloquearPantalla(

                true
           );

            setTimeout(
                () =>
                    unidadCodigo.focus(),
                    60
                );
        }


              function editarUnidad(
            boton
            ) {

                   tituloUnidad.textContent =
                  "Editar unidad de medida";

                formUnidad.action =
                "/Inventario/Catalogos/Index?handler=EditarUnidad";

            unidadId.value =
                    boton.dataset.id || "0";

            unidadCodigo.value =
                boton.dataset.codigo || "";

                unidadNombre.value =
                boton.dataset.nombre || "";

              unidadAbreviatura.value =
                    boton.dataset.abreviatura || "";

             unidadEstado.checked =
                    boton.dataset.estado === "1";

             grupoEstadoUnidad.style.display =
                "block";

                modalUnidad.classList.add(
                    "open"
            );

            bloquearPantalla(
                true
            );
            }


            function cerrarUnidad() {

                modalUnidad.classList.remove(
                    "open"
                );

                if (
                    !modalCategoria.classList.contains(
                        "open"
                    )
                    &&
                    !modalMarca.classList.contains(
                        "open"
                    )
                ) {
                    bloquearPantalla(
                        false
                    );
                }
            }


            function abrirNuevaMarca() {

                tituloMarca.textContent =
                    "Nueva marca";

                formMarca.action =
                    "/Inventario/Catalogos/Index?handler=CrearMarca";

                marcaId.value =
                    "0";

                marcaNombre.value =
                    "";

                marcaDescripcion.value =
                    "";

                marcaEstado.checked =
                    true;

                grupoEstadoMarca.style.display =
                    "none";

                modalMarca.classList.add(
                    "open"
                );

                bloquearPantalla(
                    true
                );

                setTimeout(
                    () =>
                        marcaNombre.focus(),
                    60
                );
            }


            function editarMarca(
                boton
            ) {

                tituloMarca.textContent =
                    "Editar marca";

                formMarca.action =
                    "/Inventario/Catalogos/Index?handler=EditarMarca";

                marcaId.value =
                    boton.dataset.id || "0";

                marcaNombre.value =
                    boton.dataset.nombre || "";

                marcaDescripcion.value =
                    boton.dataset.descripcion || "";

                marcaEstado.checked =
                    boton.dataset.estado === "1";

                grupoEstadoMarca.style.display =
                    "block";

                modalMarca.classList.add(
                    "open"
                );

                bloquearPantalla(
                    true
                );
            }


            function cerrarMarca() {

                modalMarca.classList.remove(
                    "open"
                );

                if (
                    !modalCategoria.classList.contains(
                        "open"
                    )
                    &&
                    !modalUnidad.classList.contains(
                        "open"
                    )
                ) {
                    bloquearPantalla(
                        false
                    );
                }
            }


            modalCategoria?.addEventListener(
                "click",
                function(
                    event
                ) {

                    if (
                        event.target ===
                        modalCategoria
                    ) {
                        cerrarCategoria();
                    }
                }
            );


            modalUnidad?.addEventListener(
                "click",
                function(
                    event
                ) {

                    if (
                        event.target ===
                        modalUnidad
                    ) {
                        cerrarUnidad();
                    }
                }
            );


            modalMarca?.addEventListener(
                "click",
                function(
                    event
                ) {

                    if (
                        event.target ===
                        modalMarca
                    ) {
                        cerrarMarca();
                    }
                }
            );


            document.addEventListener(
                "keydown",
                function(
                    event
                ) {

                    if (
                        event.key ===
                        "Escape"
                    ) {
                        cerrarCategoria();
                        cerrarUnidad();
                        cerrarMarca();
                    }
                }
            );


            prepararEnvio(
                formCategoria
            );

            prepararEnvio(
                formUnidad
            );

            prepararEnvio(
                formMarca
            );


            return {
                abrirNuevaCategoria,
                editarCategoria,
                cerrarCategoria,
                abrirNuevaUnidad,
                editarUnidad,
                cerrarUnidad,
                abrirNuevaMarca,
                editarMarca,
                cerrarMarca
            };

        })();
</script>
