<!-- =============================================================
     PROGRESO
============================================================= -->

<script>

    (() => {

        const bar =
            document.getElementById(
                "welcomeProgress"
            );

        const percentage =
            document.getElementById(
                "welcomePercentage"
            );

        const status =
            document.getElementById(
                "welcomeStatus"
            );


        if (!bar ||
            !percentage ||
            !status) {

            return;
        }


        let progress = 0;


        function updateProgress() {

            progress +=
                Math.random() * 8 + 3;


            if (progress >= 100) {

                progress = 100;

                bar.style.width =
                    "100%";

                percentage.textContent =
                    "100%";

                status.textContent =
                    "Espacio de trabajo preparado.";

                return;
            }


            const value =
                Math.floor(progress);


            bar.style.width =
                value + "%";


            percentage.textContent =
                value + "%";


            if (value < 30) {

                status.textContent =
                    "Cargando módulos del sistema...";

            }

            else if (value < 60) {

                status.textContent =
                    "Preparando ventas e inventario...";

            }

            else if (value < 85) {

                status.textContent =
                    "Sincronizando información...";

            }

            else {

                status.textContent =
                    "Finalizando espacio de trabajo...";

            }


            setTimeout(
                updateProgress,
                100
            );

        }


        setTimeout(
            updateProgress,
            250
        );

    })();

</script>

