    <script>
           window.kernixConfiguracionVenta = {
                porcentajeImpuesto: Number("@Model.PorcentajeImpuesto.ToString(CultureInfo.InvariantCulture)"),
            descuentoMaximo: Number("@Model.DescuentoMaximo.ToString(CultureInfo.InvariantCulture)"),

             permitirVentaSinStock:
                @Model.PermitirVentaSinStock.ToString().ToLowerInvariant(),

              validarStockAntesVenta:
                @Model.ValidarStockAntesVenta.ToString().ToLowerInvariant(),

                    permitirCambioPrecio:
                        @Model.PermitirCambioPrecio.ToString().ToLowerInvariant(),

                    permitirVentaCredito:
                        @Model.PermitirVentaCredito.ToString().ToLowerInvariant(),

               idEmpresa: @Model.IdEmpresa,
                    idSucursal: @Model.IdSucursal,
                    idAlmacen: @Model.IdAlmacen
                };

                console.log(
                    "[KerniX] CONFIGURACION:",
              window.kernixConfiguracionVenta
                );
    </script>

    <script src="~/js/ventas/nueva.js"
