@page
@model KerniX.Pages.Ventas.NuevaModel
@using System.Globalization

@{
    Layout = null;
    ViewData["Title"] = "Nueva Venta";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] | KerniX
    </title>


    <!-- UIKIT -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/css/uikit.min.css" />


    <!-- ESTILOS -->

    <link rel="stylesheet"
          href="~/css/ventas/nueva.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/ventas/nueva-ajustes.css"
          asp-append-version="true" />


</head>


<body class="@(Model.PedidoOrigen is not null ? "kxdesdepedido" : "")">


    <!-- =========================================================
         MODAL NUEVO CLIENTE
         ========================================================= -->

    <div id="modalNuevoCliente"
         class="kxcliente-modal"
         hidden>

        <div id="overlayNuevoCliente"
             class="kxcliente-modal-fondo">
        </div>


        <section class="kxcliente-modal-dialogo"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="tituloNuevoCliente">


            <header class="kxcliente-modal-cabecera">

                <div>

                    <span class="kxcliente-modal-mini">
                        CLIENTES
                    </span>

                    <h2 id="tituloNuevoCliente">
                        Nuevo cliente
                    </h2>

                    <p>
                        Registra un cliente sin salir de la venta.
                    </p>

                </div>


                <button type="button"
                        id="cerrarModalNuevoCliente"
                        class="kxcliente-modal-cerrar"
                        aria-label="Cerrar">

                    <span uk-icon="icon: close"></span>

                </button>

            </header>


            <div class="kxcliente-modal-cuerpo">


                <div class="kxcliente-form-grid">


                    <div class="kxcliente-campo">

                        <label for="nuevoTipoCliente">
                            Tipo de cliente
                        </label>

                        <select id="nuevoTipoCliente">

                            <option value="NATURAL">
                                Persona natural
                            </option>

                            <option value="JURIDICO">
                                Empresa / Persona jurídica
                            </option>

                        </select>

                    </div>


                    <div class="kxcliente-campo">

                        <label for="nuevoTipoDocumento">
                            Tipo de documento
                        </label>

                        <select id="nuevoTipoDocumento">

                            <option value="DNI">
                                DNI
                            </option>

                            <option value="RUC">
                                RUC
                            </option>

                            <option value="CE">
                                Carné de extranjería
                            </option>

                        </select>

                    </div>


                    <div class="kxcliente-campo">

                        <label for="nuevoNumeroDocumento">
                            Número de documento
                        </label>

                        <input type="text"
                               id="nuevoNumeroDocumento"
                               maxlength="20"
                               autocomplete="off"
                               placeholder="Ej. 70000002" />

                    </div>


                    <div class="kxcliente-campo">

                        <label for="nuevoTelefono">
                            Teléfono
                        </label>

                        <input type="text"
                               id="nuevoTelefono"
                               maxlength="20"
                               autocomplete="off"
                               placeholder="999111222" />

                    </div>


                    <div class="kxcliente-campo">

                        <label for="nuevoNombres">
                            Nombres
                        </label>

                        <input type="text"
                               id="nuevoNombres"
                               maxlength="150"
                               autocomplete="off"
                               placeholder="Andrea" />

                    </div>


                    <div class="kxcliente-campo">

                        <label for="nuevoApellidos">
                            Apellidos
                        </label>

                        <input type="text"
                               id="nuevoApellidos"
                               maxlength="150"
                               autocomplete="off"
                               placeholder="Flores Ramos" />

                    </div>


                    <div class="kxcliente-campo kxcliente-campo-ancho">

                        <label for="nuevoRazonSocial">
                            Razón social
                        </label>

                        <input type="text"
                               id="nuevoRazonSocial"
                               maxlength="200"
                               autocomplete="off"
                               placeholder="Solo para persona jurídica" />

                    </div>


                    <div class="kxcliente-campo kxcliente-campo-ancho">

                        <label for="nuevoCorreo">
                            Correo
                        </label>

                        <input type="email"
                               id="nuevoCorreo"
                               maxlength="200"
                               autocomplete="off"
                               placeholder="cliente@correo.com" />

                    </div>


                    <div class="kxcliente-subtitulo kxcliente-campo-ancho">

                        <strong>
                            Contacto principal
                        </strong>

                        <span>
                            Datos opcionales del contacto del cliente.
                        </span>

                    </div>


                    <div class="kxcliente-campo">

                        <label for="nuevoCargoContacto">
                            Cargo
                        </label>

                        <input type="text"
                               id="nuevoCargoContacto"
                               maxlength="100"
                               autocomplete="off"
                               placeholder="Ej. Administrador" />

                    </div>


                    <div class="kxcliente-campo">

                        <label for="nuevoTipoDireccion">
                            Tipo de dirección
                        </label>

                        <select id="nuevoTipoDireccion">

                            <option value="FISCAL">
                                Fiscal
                            </option>

                            <option value="ENTREGA">
                                Entrega
                            </option>

                            <option value="DOMICILIO">
                                Domicilio
                            </option>

                        </select>

                    </div>


                    <div class="kxcliente-subtitulo kxcliente-campo-ancho">

                        <strong>
                            Dirección
                        </strong>

                    </div>


                    <div class="kxcliente-campo kxcliente-campo-ancho">

                        <label for="nuevoDireccion">
                            Dirección
                        </label>

                        <input type="text"
                               id="nuevoDireccion"
                               maxlength="250"
                               autocomplete="off"
                               placeholder="Av. / Calle / Jr." />

                    </div>


                    <div class="kxcliente-campo">

                        <label for="nuevoDistrito">
                            Distrito
                        </label>

                        <input type="text"
                               id="nuevoDistrito"
                               maxlength="100"
                               autocomplete="off"
                               placeholder="Distrito" />

                    </div>


                    <div class="kxcliente-campo">

                        <label for="nuevoProvincia">
                            Provincia
                        </label>

                        <input type="text"
                               id="nuevoProvincia"
                               maxlength="100"
                               autocomplete="off"
                               placeholder="Provincia" />

                    </div>


                    <div class="kxcliente-campo">

                        <label for="nuevoDepartamento">
                            Departamento
                        </label>

                        <input type="text"
                               id="nuevoDepartamento"
                               maxlength="100"
                               autocomplete="off"
                               placeholder="Departamento" />

                    </div>


                    <div class="kxcliente-campo">

                        <label for="nuevoUbigeo">
                            Ubigeo
                        </label>

                        <input type="text"
                               id="nuevoUbigeo"
                               maxlength="6"
                               inputmode="numeric"
                               autocomplete="off"
                               placeholder="150110" />

                    </div>


                    <div class="kxcliente-campo kxcliente-campo-ancho">

                        <label for="nuevoReferencia">
                            Referencia
                        </label>

                        <input type="text"
                               id="nuevoReferencia"
                               maxlength="250"
                               autocomplete="off"
                               placeholder="Referencia de la dirección" />

                    </div>

                </div>


                <div id="mensajeNuevoCliente"
                     class="kxcliente-modal-mensaje"
                     hidden>
                </div>

            </div>


            <footer class="kxcliente-modal-acciones">

                <button type="button"
                        id="cancelarNuevoCliente"
                        class="kxbotonsecundario">

                    Cancelar

                </button>


                <button type="button"
                        id="guardarNuevoCliente"
                        class="kxcliente-boton-guardar">

                    <span uk-icon="icon: check"></span>

                    Guardar cliente

                </button>

            </footer>

        </section>

    </div>



    <!-- =========================================================
         TOKEN POST
         ========================================================= -->

    <form method="post"
          id="formTokenNuevaVenta"
          hidden>

        @Html.AntiForgeryToken()

    </form>



    <div class="kxventa">


        <!-- =========================================================
             SIDEBAR
             ========================================================= -->

        <aside class="kxsidebar">


            <div class="kxmarca">

                <div class="kxlogo">
                    K
                </div>

                <div class="kxmarcatexto">

                    <strong>
                        KerniX
                    </strong>

                    <span>
                        Ventas Inteligentes
                    </span>

                </div>

            </div>


            <nav class="kxmenu">


                <a href="/Ventas/PrincipalVentas"
                   class="kxmenuitem">

                    <span uk-icon="icon: grid"></span>

                    <span>
                        Dashboard
                    </span>

                </a>


                <a href="/Ventas/Nueva"
                   class="kxmenuitem activo">

                    <span uk-icon="icon: cart"></span>

                    <span>
                        Nueva Venta
                    </span>

                </a>


                <a href="/Ventas/Cotizaciones"
                   class="kxmenuitem">

                    <span uk-icon="icon: file-text"></span>

                    <span>
                        Cotizaciones
                    </span>

                </a>


                <a href="/Pedidos/Index"
                   class="kxmenuitem">

                    <span uk-icon="icon: list"></span>

                    <span>
                        Pedidos
                    </span>

                </a>


                <a href="/Ventas/Pagos"
                   class="kxmenuitem">

                    <span uk-icon="icon: credit-card"></span>

                    <span>
                        Pagos
                    </span>

                </a>


                <a href="/Ventas/Comprobantes"
                   class="kxmenuitem">

                    <span uk-icon="icon: print"></span>

                    <span>
                        Comprobantes
                    </span>

                </a>


                <a href="/Ventas/Devoluciones"
                   class="kxmenuitem">

                    <span uk-icon="icon: history"></span>

                    <span>
                        Devoluciones
                    </span>

                </a>


                <a href="/Ventas/Reclamos"
                   class="kxmenuitem">

                    <span uk-icon="icon: warning"></span>

                    <span>
                        Reclamos
                    </span>

                </a>

            </nav>

        </aside>



        <!-- =========================================================
             CONTENIDO
             ========================================================= -->

        <main class="kxcontenido">


            <!-- =====================================================
                 DATOS PEDIDO
                 ===================================================== -->
            @if (Model.PedidoOrigen is not null)
            {
                <script id="kernixPedidoOrigenJson"
                        type="application/json">

                                @Html.Raw(
                                        System.Text.Json.JsonSerializer.Serialize(
                                                Model.PedidoOrigen,
                                                new System.Text.Json.JsonSerializerOptions
                                                {
                                                        PropertyNamingPolicy =
                                                                System.Text.Json.JsonNamingPolicy.CamelCase
                                                }
                                        )
                                )

                </script>
            }



            <!-- =====================================================
                 CABECERA
                 ===================================================== -->

            <header class="kxcabecera">

                <div>

                    <p class="kxseccion">
                        Gestión Comercial
                    </p>

                    <h1>
                        Nueva Venta
                    </h1>

                    <p class="kxdescripcion">
                        Registra productos, cliente y forma de pago.
                    </p>

                </div>


                <div class="kxacciones">

                    <a href="/Ventas/PrincipalVentas"
                       class="kxbotonsecundario">

                        <span uk-icon="icon: arrow-left"></span>

                        Volver

                    </a>

                </div>

            </header>



            <!-- =====================================================
                 GRID
                 ===================================================== -->

            <div class="kxventagrid">


                <!-- =================================================
                     IZQUIERDA
                     ================================================= -->

                <section class="kxventaizquierda">


                    <!-- =============================================
                         CLIENTE
                         ============================================= -->

                    <article class="kxpanel">


                        <div class="kxpanelcabecera">

                            <div class="kxpaneltitulo">

                                <span class="kxnumero">
                                    01
                                </span>

                                <div>

                                    <span class="kxpanelmini">
                                        Cliente
                                    </span>

                                    <h2>
                                        Datos del cliente
                                    </h2>

                                </div>

                            </div>

                        </div>


                        <div class="kxpanelacciones">

                            <button type="button"
                                    id="abrirModalNuevoCliente"
                                    class="kxbotonsecundario">

                                <span uk-icon="icon: plus-circle"></span>

                                Nuevo cliente

                            </button>

                        </div>


                        <div class="kxclientegrid">


                            <div class="kxcampo kxcampogrande">

                                <label for="buscarCliente">
                                    Buscar cliente
                                </label>


                                <div class="kxclientebuscador">


                                    <div class="kxinputicono">

                                        <span uk-icon="icon: search"></span>

                                        <input type="text"
                                               id="buscarCliente"
                                               autocomplete="off"
                                               placeholder="Nombre, DNI, RUC, teléfono o correo..." />

                                    </div>


                                    <div id="resultadosClientes"
                                         class="kxresultadosclientes"
                                         hidden>
                                    </div>


                                </div>

                            </div>



                            <input type="hidden"
                                   id="idClienteSeleccionado"
                                   value="@(Model.PedidoOrigen is not null
                                       ? Model.PedidoClienteId
                                       : 0)" />


                            <input type="hidden"
                                   id="tipoDocumentoCliente"
                                   value="@(Model.PedidoOrigen is not null
                                       ? Model.PedidoClienteTipoDocumento
                                       : "")" />


                            <input type="hidden"
                                   id="codigoDocumentoCliente"
                                   value="" />


                            <input type="hidden"
                                   id="direccionCliente"
                                   value="" />


                            <input type="hidden"
                                   id="comprobanteCliente"
                                   value="BOLETA" />



                            <div class="kxcampo">

                                <label for="documentoCliente">
                                    Documento
                                </label>

                                <input type="text"
                                       id="documentoCliente"
                                       value="@(Model.PedidoOrigen is not null
                                           ? Model.PedidoClienteNumeroDocumento
                                           : "")"
                                       placeholder="DNI / RUC"
                                       readonly />

                            </div>



                            <div class="kxcampo">

                                <label for="telefonoCliente">
                                    Teléfono
                                </label>

                                <input type="text"
                                       id="telefonoCliente"
                                       value="@(Model.PedidoOrigen is not null
                                           ? Model.PedidoClienteTelefono
                                           : "")"
                                       placeholder="+51..."
                                       readonly />

                            </div>

                        </div>



                        <div class="kxclienteseleccionado"
                             id="clienteSeleccionado"
                            @(Model.PedidoOrigen is null ? "hidden" : "")>


                            <div class="kxclienteavatar"
                                 id="clienteAvatar">

                                @(string.IsNullOrWhiteSpace(
                                    Model.PedidoClienteNombre)
                                    ? "C"
                                    : Model.PedidoClienteNombre
                                        .Substring(0, 1)
                                        .ToUpperInvariant())

                            </div>


                            <div class="kxclienteprincipal">

                                <strong id="clienteNombre">

                                    @(Model.PedidoOrigen is not null
                                        ? Model.PedidoClienteNombre
                                        : "")

                                </strong>


                                <span id="clienteDocumentoTexto">

                                    @(Model.PedidoOrigen is not null
                                        ? $"{Model.PedidoClienteTipoDocumento} {Model.PedidoClienteNumeroDocumento}".Trim()
                                        : "")

                                </span>


                                <small id="clienteCorreo">

                                    @(Model.PedidoOrigen is not null
                                        ? Model.PedidoClienteCorreo
                                        : "")

                                </small>

                            </div>


                            <button type="button"
                                    id="quitarCliente"
                                    class="kxbotonicono"
                                    title="Quitar cliente"
                                @(Model.PedidoOrigen is not null
    ? "disabled"
    : "")>

                                <span uk-icon="icon: close"></span>

                            </button>


                        </div>


                    </article>



                    <!-- =============================================
                         TIPO COMPROBANTE
                         ============================================= -->

                    <article class="kxpanel">


                        <div class="kxpanelcabecera">

                            <div class="kxpaneltitulo">

                                <span class="kxnumero">
                                    02
                                </span>

                                <div>

                                    <span class="kxpanelmini">
                                        Comprobante
                                    </span>

                                    <h2>
                                        Tipo de comprobante
                                    </h2>

                                </div>

                            </div>

                        </div>


                        <div class="kxmetodospago">


                            <label class="kxmetodopago">

                                <input type="radio"
                                       name="TipoComprobante"
                                       value="BOLETA"
                                       checked />

                                <span>
                                    Boleta
                                </span>

                            </label>


                            <label class="kxmetodopago">

                                <input type="radio"
                                       name="TipoComprobante"
                                       value="FACTURA" />

                                <span>
                                    Factura
                                </span>

                            </label>


                            <label class="kxmetodopago">

                                <input type="radio"
                                       name="TipoComprobante"
                                       value="NOTA_VENTA" />

                                <span>
                                    Nota de venta
                                </span>

                            </label>


                            <label class="kxmetodopago">

                                <input type="radio"
                                       name="TipoComprobante"
                                       value="SIN_COMPROBANTE" />

                                <span>
                                    Sin comprobante
                                </span>

                            </label>


                        </div>


                    </article>



                    <!-- =============================================
                         PRODUCTOS
                         ============================================= -->

                    <article class="kxpanel kxpanelbusqueda">


                        <div class="kxpanelcabecera">

                            <div class="kxpaneltitulo">

                                <span class="kxnumero">
                                    03
                                </span>

                                <div>

                                    <span class="kxpanelmini">
                                        Productos
                                    </span>

                                    <h2>
                                        Agregar productos
                                    </h2>

                                </div>

                            </div>

                        </div>


                        <div class="kxbuscadorproducto">

                            <span uk-icon="icon: search"></span>

                            <input type="text"
                                   id="buscarProducto"
                                   autocomplete="off"
                                   placeholder="Nombre, código, barras, categoría o marca..." />

                        </div>


                        <div class="kxproductosgrid"
                             id="productosDisponibles">

                            <div class="kxvacioproductos">

                                Escribe al menos 2 caracteres
                                para buscar productos.

                            </div>

                        </div>


                    </article>



                    <!-- =============================================
                         CARRITO
                         ============================================= -->

                    <article class="kxpanel kxpanelcarrito">


                        <div class="kxpanelcabecera">


                            <div class="kxpaneltitulo">

                                <span class="kxnumero">
                                    04
                                </span>

                                <div>

                                    <span class="kxpanelmini">
                                        Detalle
                                    </span>

                                    <h2>
                                        Productos de la venta
                                    </h2>

                                </div>

                            </div>


                            <span class="kxcontador"
                                  id="cantidadProductos">

                                0 productos

                            </span>


                        </div>



                        <div class="kxtablacontenedor">


                            <table class="kxtabla">


                                <thead>

                                    <tr>

                                        <th>
                                            Producto
                                        </th>

                                        <th>
                                            Precio base
                                        </th>

                                        <th>
                                            Cantidad
                                        </th>

                                        <th>
                                            Descuento
                                        </th>

                                        <th>
                                            IGV
                                        </th>

                                        <th>
                                            Total c/ IGV
                                        </th>

                                        <th>
                                        </th>

                                    </tr>

                                </thead>


                                <tbody id="detalleVenta">

                                    <tr id="filaVacia">

                                        <td colspan="7"
                                            class="kxvacio">

                                            No has agregado productos a la venta.

                                        </td>

                                    </tr>

                                </tbody>


                            </table>


                        </div>


                    </article>


                </section>



                <!-- =================================================
                     DERECHA
                     ================================================= -->

                <aside class="kxventaderecha">


                    <!-- =============================================
                         RESUMEN
                         ============================================= -->

                    <article class="kxpanel kxresumen">


                        <div class="kxpanelcabecera">

                            <div class="kxpaneltitulo">

                                <span class="kxnumero">
                                    05
                                </span>

                                <div>

                                    <span class="kxpanelmini">
                                        Resumen
                                    </span>

                                    <h2>
                                        Total de venta
                                    </h2>

                                </div>

                            </div>

                        </div>



                        <div class="kxresumenlinea">

                            <span>
                                Subtotal
                            </span>

                            <strong id="subtotalVenta">
                                S/ 0.00
                            </strong>

                        </div>



                        <div class="kxresumenlinea">

                            <span>
                                Descuento
                            </span>

                            <strong id="descuentoVenta">
                                - S/ 0.00
                            </strong>

                        </div>



                        <div class="kxresumenlinea">

                            <span>

                                @Model.CodigoImpuesto
                                (@Model.PorcentajeImpuesto.ToString("0.##")%)

                            </span>

                            <strong id="igvVenta">
                                S/ 0.00
                            </strong>

                        </div>



                        <div class="kxresumentotal">

                            <span>
                                Total
                            </span>

                            <strong id="totalVenta">
                                S/ 0.00
                            </strong>

                        </div>


                    </article>



                    <!-- =============================================
                         MÉTODO PAGO
                         ============================================= -->

                    <article class="kxpanel">


                        <div class="kxpanelcabecera">

                            <div class="kxpaneltitulo">

                                <span class="kxnumero">
                                    06
                                </span>

                                <div>

                                    <span class="kxpanelmini">
                                        Cobro
                                    </span>

                                    <h2>
                                        Método de pago
                                    </h2>

                                </div>

                            </div>

                        </div>



                        <div class="kxmetodospago">


                            <label class="kxmetodopago">

                                <input type="radio"
                                       name="MetodoPago"
                                       value="Efectivo"
                                       checked />

                                <span class="kxmetodopagoicono">
                                    S/
                                </span>

                                <span>
                                    Efectivo
                                </span>

                            </label>



                            <label class="kxmetodopago">

                                <input type="radio"
                                       name="MetodoPago"
                                       value="Yape" />

                                <span class="kxmetodopagoicono morado">
                                    Y
                                </span>

                                <span>
                                    Yape
                                </span>

                            </label>



                            <label class="kxmetodopago">

                                <input type="radio"
                                       name="MetodoPago"
                                       value="Plin" />

                                <span class="kxmetodopagoicono verde">
                                    P
                                </span>

                                <span>
                                    Plin
                                </span>

                            </label>



                            <label class="kxmetodopago">

                                <input type="radio"
                                       name="MetodoPago"
                                       value="Tarjeta" />

                                <span class="kxmetodopagoicono azul">

                                    <span uk-icon="icon: credit-card"></span>

                                </span>

                                <span>
                                    Tarjeta
                                </span>

                            </label>


                        </div>



                        <div class="kxcampo">

                            <label>
                                Monto recibido
                            </label>


                            <div class="kxinputmoneda">

                                <span>
                                    S/
                                </span>

                                <input type="number"
                                       id="montoRecibido"
                                       value="0"
                                       min="0"
                                       step="0.01" />

                            </div>

                        </div>



                        <div class="kxvuelto">

                            <span>
                                Vuelto
                            </span>

                            <strong id="vueltoVenta">
                                S/ 0.00
                            </strong>

                        </div>


                    </article>



                    <!-- =============================================
                         ACCIONES
                         ============================================= -->

                    <div class="kxaccionesventa">


                        <button type="button"
                                id="limpiarVenta"
                                class="kxbotonsecundario kxbotongrande">

                            <span uk-icon="icon: refresh"></span>

                            Limpiar venta

                        </button>



                        <button type="button"
                                id="confirmarVenta"
                                class="kxbotonprincipal kxbotongrande">

                            <span uk-icon="icon: check"></span>

                            Confirmar venta

                        </button>


                    </div>



                    <!-- =============================================
                         COMPROBANTE EMITIDO
                         ============================================= -->

                    <section id="comprobanteEmitido"
                             class="kxpanel kxcomprobante"
                             hidden
                             aria-live="polite">


                        <div class="kxpanelcabecera">

                            <div class="kxpaneltitulo">

                                <h2>
                                    Comprobante registrado
                                </h2>

                            </div>

                        </div>


                        <div class="kxresumenlinea">

                            <span>
                                Tipo
                            </span>

                            <strong id="comprobanteEmitidoTipo">
                            </strong>

                        </div>


                        <div class="kxresumenlinea">

                            <span>
                                Número
                            </span>

                            <strong id="comprobanteEmitidoNumero">
                            </strong>

                        </div>


                        <div class="kxpanelacciones">

                            <button id="enviarBoleta"
                                    type="button"
                                    class="kxbotonsecundario"
                                    hidden>

                                Copiar datos del comprobante

                            </button>

                        </div>


                    </section>


                </aside>


            </div>


        </main>


    </div>



    <!-- =========================================================
