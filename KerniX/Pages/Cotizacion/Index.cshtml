                valores:
                        @Html.Raw(valoresJson)

                };


            window.kernixCotizaciones = [

                    @foreach (var item in Model.Cotizaciones)
                {
                    <text>
                            {
                                id:
                                        @item.IdCotizacion,

                            numero:
                            @Html.Raw(
                            JsonSerializer.Serialize(
                            item.NumeroCotizacion
                            )
                            ),

                            cliente:
                            @Html.Raw(
                            JsonSerializer.Serialize(
                            item.Cliente
                            )
                            ),

                            documento:
                            @Html.Raw(
                            JsonSerializer.Serialize(
                            item.NumeroDocumento
                            )
                            ),

                            estado:
                            @Html.Raw(
                            JsonSerializer.Serialize(
                            item.Estado
                            )
                            ),

                            total:
                            @item.Total.ToString(
                            CultureInfo.InvariantCulture
                            )
                                },
                    </text>
                    }

                ];

