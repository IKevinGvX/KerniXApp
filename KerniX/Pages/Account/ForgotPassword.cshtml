@page "/Account/ForgotPassword"
@model KerniX.Pages.Account.ForgotPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Recuperar contraseña | KerniX ERP";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#040914" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/css/uikit.min.css" />
    <link rel="stylesheet" href="~/css/recuperacion.css" asp-append-version="true" />
</head>
<body class="kxrp-body">
    <div class="kxrp-stage">
        <span class="kxrp-ambient kxrp-ambient-one" aria-hidden="true"></span>
        <span class="kxrp-ambient kxrp-ambient-two" aria-hidden="true"></span>
        <div class="kxrp-wrap">
            <header class="kxrp-topbar">
                <a href="/Account/Login" class="kxrp-brand" aria-label="KerniX ERP - Ir al inicio de sesión">
                    <img src="~/images/login/kernix-logo.png" asp-append-version="true" alt="" class="kxrp-brand-logo" />
                    <span class="kxrp-brand-text"><strong>KerniX <em>ERP</em></strong><small>Sistema Inteligente de Gestión Empresarial</small></span>
                </a>
                <div class="kxrp-topbar-right"><span class="kxrp-status-led"></span> CENTRO DE SEGURIDAD <span class="kxrp-topbar-line"></span> <span class="kxrp-topbar-version">ACCESO SEGURO</span></div>
            </header>

            <main class="kxrp-layout" id="contenido">
                <section class="kxrp-card" aria-labelledby="kxrp-title">
                    <div class="kxrp-card-aura" aria-hidden="true"></div>
                    <div class="kxrp-card-content">
                        <div class="kxrp-breadcrumb"><span class="kxrp-pulse"></span> SEGURIDAD DE LA CUENTA <span class="kxrp-slash">/</span> RECUPERACIÓN</div>
                        @if (Model.SolicitudRecibida)
                        {
                            <div class="kxrp-emblem kxrp-emblem-success" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 12.5l5 5L20 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            </div>
                            <h1 class="kxrp-heading" id="kxrp-title">Solicitud <span>recibida</span></h1>
                            <p class="kxrp-lead">Si existe una cuenta activa asociada al correo, recibirás un enlace para restablecer tu contraseña.</p>
                            <div class="kxrp-info kxrp-info-success" role="status">
                                <span class="kxrp-info-icon" aria-hidden="true">✓</span>
                                <div><strong>Revisa tu correo</strong><span>Consulta también la carpeta Spam. El enlace tendrá una vigencia de 15 minutos.</span></div>
                            </div>
                            <a class="kxrp-button kxrp-primary" href="/Account/Login"><span>Volver al inicio de sesión</span><span aria-hidden="true">→</span></a>
                            <a class="kxrp-secondary-link" href="/Account/ForgotPassword">Solicitar un enlace nuevo</a>
                        }
                        else
                        {
                            <div class="kxrp-emblem" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 7 8.5 6 8.5-6" /></svg>
                            </div>
                            <h1 class="kxrp-heading" id="kxrp-title">Recuperar <span>contraseña</span></h1>
                            <p class="kxrp-lead">Ingresa el correo registrado en KerniX. Te enviaremos un enlace seguro para recuperar el acceso a tu cuenta.</p>

                            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                            {
                                <div class="kxrp-info kxrp-info-error" role="alert"><span aria-hidden="true">!</span><div>@Model.ErrorMessage</div></div>
                            }
                            <form method="post" class="kxrp-form" id="kxrp-forgot-form" autocomplete="on">
                                @Html.AntiForgeryToken()
                                <label class="kxrp-label" for="kxrp-email">Correo electrónico registrado</label>
                                <div class="kxrp-input-wrap">
                                    <span class="kxrp-input-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
                                    </span>
                                    <input id="kxrp-email" name="Input.Correo" type="email" class="kxrp-input" required maxlength="150" autocomplete="email" inputmode="email" placeholder="usuario@empresa.com" value="@Model.Input.Correo" aria-describedby="kxrp-email-help" />
                                </div>
                                <span class="kxrp-field-error">@Html.ValidationMessageFor(m => m.Input.Correo)</span>
                                <div class="kxrp-hint" id="kxrp-email-help">Usa el correo asociado a tu usuario de KerniX ERP.</div>
                                <button class="kxrp-button kxrp-primary" type="submit" id="kxrp-submit">
                                    <svg class="kxrp-button-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4 20-7Z" /><path d="M22 2 11 13" /></svg>
                                    <span data-submit-label>Enviar enlace de recuperación</span>
                                    <span aria-hidden="true" class="kxrp-button-arrow">→</span>
                                </button>
                            </form>
                            <a class="kxrp-secondary-link" href="/Account/Login"><span aria-hidden="true">←</span> Volver al inicio de sesión</a>
                        }
                        <div class="kxrp-divider"></div>
                        <div class="kxrp-security-note">
                            <span class="kxrp-note-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg></span>
                            <span><strong>Privacidad y protección</strong> Nunca compartas tu enlace. Caduca en <b>15 minutos</b> y solo puede utilizarse una vez.</span>
                        </div>
                    </div>
                </section>

                <aside class="kxrp-visual" aria-label="KerniX ERP, operaciones inteligentes">
                    <div class="kxrp-visual-cover" aria-hidden="true"></div>
                    <div class="kxrp-orbit kxrp-orbit-a" aria-hidden="true"></div>
                    <div class="kxrp-orbit kxrp-orbit-b" aria-hidden="true"></div>
                    <div class="kxrp-art-halo" aria-hidden="true"></div>
                    <div class="kxrp-visual-top"><span class="kxrp-diamond">✦</span> PROTECCIÓN INTELIGENTE <span class="kxrp-signal">● SISTEMA KERNIX</span></div>
                    <div class="kxrp-visual-caption"><span class="kxrp-visual-eyebrow">SEGURIDAD PARA TUS OPERACIONES</span><h2>Tu negocio.<br /><span>Bajo control.</span></h2><p>Ventas, inventario e inteligencia empresarial conectados en un solo entorno.</p></div>
                    <div class="kxrp-visual-tags"><span><i class="kxrp-tag-dot"></i> Ventas</span><span><i class="kxrp-tag-dot"></i> Inventario</span><span><i class="kxrp-tag-dot"></i> Inteligencia</span></div>
                </aside>
            </main>
            <footer class="kxrp-footer"><span>© @DateTime.UtcNow.Year KerniX ERP</span><span><span class="kxrp-footer-dot"></span> Plataforma de gestión empresarial</span></footer>
        </div>
    </div>
    <script src="~/js/recuperacion.js" asp-append-version="true"></script>
</body>
</html>
