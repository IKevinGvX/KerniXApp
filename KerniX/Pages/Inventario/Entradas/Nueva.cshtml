@page "/Inventario/Entradas/Nueva"
@model KerniX.Pages.Inventario.Entradas.NuevaModel

@{
    ViewData["Title"] = "Nueva Entrada de Stock";
}

<style>
    :root {
        --kx-bg: #07111f;
        --kx-panel: #0b1728;
        --kx-panel-2: #0e1d31;
        --kx-gold: #ffc107;
        --kx-cyan: #00d9ff;
        --kx-text: #f5f7fb;
        --kx-muted: #8fa3bb;
        --kx-danger: #ff5d73;
        --kx-success: #2ee6a6;
    }

    * {
        box-sizing: border-box;
    }

    .kx-entry-page {
        min-height: 100vh;
        background: radial-gradient(circle at top right, rgba(0,217,255,.08), transparent 32%), radial-gradient(circle at top left, rgba(255,193,7,.08), transparent 26%), var(--kx-bg);
        color: var(--kx-text);
        padding: 32px 22px 60px;
    }

    .kx-entry-shell {
        width: min(1180px, 100%);
        margin: 0 auto;
    }

    .kx-entry-header {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .kx-breadcrumb {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
        margin-bottom: 11px;
        color: var(--kx-muted);
        font-size: .88rem;
    }

        .kx-breadcrumb a {
            color: var(--kx-cyan);
            text-decoration: none;
        }

    .kx-title {
        margin: 0;
        font-size: clamp(1.8rem, 4vw, 2.65rem);
        line-height: 1.1;
        letter-spacing: -.035em;
    }

        .kx-title strong {
            color: var(--kx-gold);
            font-weight: 800;
        }

    .kx-subtitle {
        color: var(--kx-muted);
        margin: 10px 0 0;
        max-width: 720px;
        line-height: 1.6;
    }

    .kx-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .kx-btn {
        min-height: 43px;
        padding: 0 16px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,.12);
        background: rgba(255,255,255,.04);
        color: #fff;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        cursor: pointer;
        transition: .2s ease;
    }

        .kx-btn:hover {
            transform: translateY(-1px);
            border-color: rgba(0,217,255,.45);
            color: #fff;
        }

    .kx-btn-primary {
        border-color: rgba(255,193,7,.55);
        background: linear-gradient(135deg, rgba(255,193,7,.18), rgba(255,159,28,.08));
        color: #ffe28a;
    }

    .kx-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(290px, .75fr);
        gap: 22px;
        align-items: start;
    }

    .kx-card {
        background: linear-gradient(180deg, rgba(255,255,255,.025), rgba(255,255,255,.012)), var(--kx-panel);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,.24);
        overflow: hidden;
    }

    .kx-card-head {
        padding: 20px 22px;
        border-bottom: 1px solid rgba(255,255,255,.07);
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: center;
    }

    .kx-card-title {
        margin: 0;
        font-size: 1.06rem;
        font-weight: 800;
    }

    .kx-chip {
        border: 1px solid rgba(0,217,255,.25);
        color: #8deeff;
        background: rgba(0,217,255,.07);
        padding: 5px 10px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 700;
    }

    .kx-card-body {
        padding: 22px;
    }

    .kx-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .kx-field {
        min-width: 0;
    }

    .kx-field-full {
        grid-column: 1 / -1;
    }

    .kx-label {
        display: block;
        margin-bottom: 8px;
        font-size: .86rem;
        color: #c6d4e5;
        font-weight: 750;
    }

    .kx-required {
        color: var(--kx-gold);
    }

    .kx-input,
    .kx-select,
    .kx-textarea {
        width: 100%;
        border: 1px solid rgba(255,255,255,.1);
        background: #081423;
        color: #fff;
        border-radius: 12px;
        outline: none;
        transition: .2s ease;
        font: inherit;
    }

    .kx-input,
    .kx-select {
        min-height: 47px;
        padding: 0 13px;
    }

    .kx-textarea {
        min-height: 115px;
        resize: vertical;
        padding: 13px;
        line-height: 1.55;
    }

        .kx-input:focus,
        .kx-select:focus,
        .kx-textarea:focus {
            border-color: rgba(0,217,255,.58);
            box-shadow: 0 0 0 3px rgba(0,217,255,.08);
        }

    .kx-help {
        display: block;
        margin-top: 7px;
        color: var(--kx-muted);
        font-size: .78rem;
        line-height: 1.45;
    }

    .kx-validation-summary,
    .kx-error {
        border: 1px solid rgba(255,93,115,.35);
        background: rgba(255,93,115,.08);
        color: #ffadb9;
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 18px;
    }

        .kx-validation-summary ul {
            margin: 0;
            padding-left: 19px;
        }

        .kx-validation-summary li + li {
            margin-top: 5px;
        }

    .kx-submit-row {
        margin-top: 22px;
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,.07);
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .kx-submit {
        min-height: 48px;
        min-width: 190px;
        border: 1px solid rgba(255,193,7,.55);
        border-radius: 13px;
        background: linear-gradient(135deg, #d69d00, #ffb000);
        color: #151000;
        font-weight: 900;
        cursor: pointer;
        padding: 0 20px;
        transition: .2s ease;
    }

        .kx-submit:hover {
            transform: translateY(-1px);
            filter: brightness(1.06);
        }

    .kx-summary {
        position: sticky;
        top: 18px;
    }

    .kx-summary-block {
        display: grid;
        gap: 14px;
    }

    .kx-summary-item {
        padding: 14px;
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 14px;
    }

    .kx-summary-label {
        display: block;
        color: var(--kx-muted);
        font-size: .76rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 5px;
    }

    .kx-summary-value {
        display: block;
        color: #fff;
        font-size: 1rem;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

        .kx-summary-value.gold {
            color: #ffd65c;
        }

    .kx-quantity {
        font-size: 2rem;
        color: var(--kx-success);
        font-weight: 900;
        letter-spacing: -.03em;
    }

    .kx-note {
        margin-top: 18px;
        padding: 15px;
        border-radius: 14px;
        background: rgba(0,217,255,.055);
        border: 1px solid rgba(0,217,255,.18);
        color: #a9dce7;
        line-height: 1.55;
        font-size: .84rem;
    }

        .kx-note strong {
            color: #fff;
        }

    @@media (max-width: 900px) {
        .kx-grid {
            grid-template-columns: 1fr;
        }

        .kx-summary {
            position: static;
        }
    }

    @@media (max-width: 650px) {
        .kx-entry-page {
            padding: 22px 13px 40px;
        }

        .kx-entry-header {
            flex-direction: column;
        }

        .kx-form-grid {
            grid-template-columns: 1fr;
        }

        .kx-field-full {
            grid-column: auto;
        }

        .kx-submit-row {
            flex-direction: column-reverse;
        }

            .kx-submit,
            .kx-submit-row .kx-btn {
                width: 100%;
            }
    }
</style>

<div class="kx-entry-page">
    <div class="kx-entry-shell">

        <header class="kx-entry-header">
            <div>
                <div class="kx-breadcrumb">
                    <a href="/Inventario">Inventario</a>
                    <span>›</span>
                    <a href="/Inventario/Entradas">Entradas</a>
                    <span>›</span>
                    <span>Nueva</span>
                </div>

                <h1 class="kx-title">
                    Nueva <strong>Entrada de Stock</strong>
                </h1>

                <p class="kx-subtitle">
                    Registra un ingreso autorizado de existencias.
                    La operación actualizará el stock y generará
                    automáticamente su movimiento de Kardex.
                </p>
            </div>

            <div class="kx-actions">
                <a href="/Inventario" class="kx-btn">← Inventario</a>
                <a href="/Inventario/Entradas" class="kx-btn kx-btn-primary">Ver Entradas</a>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
        {
            <div class="kx-error">
                <strong>No se pudo registrar la entrada.</strong>
                <div style="margin-top:6px;">@Model.MensajeError</div>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="kx-validation-summary">
                <ul>
                    @foreach (var estado in ViewData.ModelState.Values)
                    {
                        foreach (var error in estado.Errors)
                        {
                            <li>
                                @(string.IsNullOrWhiteSpace(error.ErrorMessage)
                                    ? error.Exception?.Message
                                    : error.ErrorMessage)
                            </li>
                        }
                    }
                </ul>
            </div>
        }

        <form method="post"
              action="/Inventario/Entradas/Nueva"
              id="formEntradaStock"
              autocomplete="off">

            @Html.AntiForgeryToken()

            <div class="kx-grid">
                <section class="kx-card">
                    <div class="kx-card-head">
                        <h2 class="kx-card-title">Datos de la entrada</h2>
                        <span class="kx-chip">Empresa @Model.IdEmpresa · Sucursal @Model.IdSucursal</span>
                    </div>

                    <div class="kx-card-body">
                        <div class="kx-form-grid">

                            <div class="kx-field">
                                <label for="idAlmacen" class="kx-label">
                                    Almacén <span class="kx-required">*</span>
                                </label>

                                <select id="idAlmacen"
                                        name="Input.IdAlmacen"
                                        class="kx-select"
                                        required>
                                    @if (Model.Input.IdAlmacen <= 0)
                                    {
                                        <option value="0" selected>Seleccionar almacén</option>
                                    }
                                    else
                                    {
                                        <option value="0">Seleccionar almacén</option>
                                    }

                                    @foreach (var almacen in Model.Catalogos.Almacenes)
                                    {
                                        if (almacen.IdAlmacen == Model.Input.IdAlmacen)
                                        {
                                            <option value="@almacen.IdAlmacen"
                                                    data-nombre="@almacen.Nombre"
                                                    data-sucursal="@almacen.Sucursal"
                                                    selected>
                                                @almacen.Codigo · @almacen.Nombre
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@almacen.IdAlmacen"
                                                    data-nombre="@almacen.Nombre"
                                                    data-sucursal="@almacen.Sucursal">
                                                @almacen.Codigo · @almacen.Nombre
                                            </option>
                                        }
                                    }
                                </select>

                                <span class="kx-help">Solo almacenes activos de tu sucursal.</span>
                            </div>

                            <div class="kx-field">
                                <label for="codigoMovimiento" class="kx-label">
                                    Tipo de entrada <span class="kx-required">*</span>
                                </label>

                                <select id="codigoMovimiento"
                                        name="Input.CodigoMovimiento"
                                        class="kx-select"
                                        required>
                                    @foreach (var tipo in Model.Catalogos.TiposMovimiento)
                                    {
                                        if (string.Equals(tipo.Codigo, Model.Input.CodigoMovimiento, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@tipo.Codigo"
                                                    data-nombre="@tipo.Nombre"
                                                    selected>
                                                @tipo.Nombre
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@tipo.Codigo"
                                                    data-nombre="@tipo.Nombre">
                                                @tipo.Nombre
                                            </option>
                                        }
                                    }
                                </select>

                                <span class="kx-help">El tipo debe tener naturaleza de ingreso.</span>
                            </div>

                            <div class="kx-field kx-field-full">
                                <label for="idProducto" class="kx-label">
                                    Producto <span class="kx-required">*</span>
                                </label>

                                <select id="idProducto"
                                        name="Input.IdProducto"
                                        class="kx-select"
                                        required>
                                    @if (Model.Input.IdProducto <= 0)
                                    {
                                        <option value="0" selected>Seleccionar producto</option>
                                    }
                                    else
                                    {
                                        <option value="0">Seleccionar producto</option>
                                    }

                                    @foreach (var producto in Model.Catalogos.Productos)
                                    {
                                        if (producto.IdProducto == Model.Input.IdProducto)
                                        {
                                            <option value="@producto.IdProducto"
                                                    data-codigo="@producto.Codigo"
                                                    data-nombre="@producto.Nombre"
                                                    data-compra="@Model.DecimalHtml(producto.PrecioCompra)"
                                                    selected>
                                                @producto.Codigo · @producto.Nombre
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@producto.IdProducto"
                                                    data-codigo="@producto.Codigo"
                                                    data-nombre="@producto.Nombre"
                                                    data-compra="@Model.DecimalHtml(producto.PrecioCompra)">
                                                @producto.Codigo · @producto.Nombre
                                            </option>
                                        }
                                    }
                                </select>

                                <span class="kx-help">Solo productos activos con control de stock habilitado.</span>
                            </div>

                            <div class="kx-field">
                                <label for="cantidad" class="kx-label">
                                    Cantidad <span class="kx-required">*</span>
                                </label>

                                <input id="cantidad"
                                       name="Input.Cantidad"
                                       type="number"
                                       class="kx-input"
                                       value="@Model.DecimalHtml(Model.Input.Cantidad)"
                                       min="0.0001"
                                       step="0.0001"
                                       inputmode="decimal"
                                       required />

                                <span class="kx-help">Debe ser mayor que cero.</span>
                            </div>

                            <div class="kx-field">
                                <label for="referencia" class="kx-label">Referencia</label>

                                <input id="referencia"
                                       name="Input.Referencia"
                                       type="text"
                                       class="kx-input"
                                       value="@Model.Input.Referencia"
                                       maxlength="100"
                                       placeholder="Ej. GUIA-001 / FACT-123" />

                                <span class="kx-help">Documento o código que origina el ingreso.</span>
                            </div>

                            <div class="kx-field kx-field-full">
                                <label for="motivo" class="kx-label">Motivo / observación</label>

                                <textarea id="motivo"
                                          name="Input.Motivo"
                                          class="kx-textarea"
                                          maxlength="300"
                                          placeholder="Describe brevemente el motivo de la entrada...">@Model.Input.Motivo</textarea>

                                <span class="kx-help">Máximo 300 caracteres.</span>
                            </div>
                        </div>

                        <div class="kx-submit-row">
                            <a href="/Inventario/Entradas" class="kx-btn">Cancelar</a>

                            <button type="submit"
                                    class="kx-submit"
                                    id="btnRegistrarEntrada">
                                Registrar Entrada
                            </button>
                        </div>
                    </div>
                </section>

                <aside class="kx-card kx-summary">
                    <div class="kx-card-head">
                        <h2 class="kx-card-title">Resumen</h2>
                        <span class="kx-chip">Kardex</span>
                    </div>

                    <div class="kx-card-body">
                        <div class="kx-summary-block">
                            <div class="kx-summary-item">
                                <span class="kx-summary-label">Almacén</span>
                                <span id="resumenAlmacen" class="kx-summary-value">-</span>
                            </div>

                            <div class="kx-summary-item">
                                <span class="kx-summary-label">Producto</span>
                                <span id="resumenProducto" class="kx-summary-value gold">-</span>
                            </div>

                            <div class="kx-summary-item">
                                <span class="kx-summary-label">Tipo</span>
                                <span id="resumenTipo" class="kx-summary-value">Entrada</span>
                            </div>

                            <div class="kx-summary-item">
                                <span class="kx-summary-label">Cantidad a ingresar</span>
                                <span id="resumenCantidad" class="kx-quantity">+1</span>
                            </div>

                            <div class="kx-summary-item">
                                <span class="kx-summary-label">Precio compra referencial</span>
                                <span id="resumenPrecioCompra" class="kx-summary-value">S/ 0.00</span>
                            </div>
                        </div>

                        <div class="kx-note">
                            <strong>Al confirmar:</strong>
                            SQL Server registrará el movimiento, tomará el stock anterior,
                            sumará la cantidad y guardará el stock nuevo en una única operación controlada.
                        </div>
                    </div>
                </aside>
            </div>
        </form>
    </div>
</div>

<script>
    (() => {
        const almacen = document.getElementById("idAlmacen");
        const producto = document.getElementById("idProducto");
        const tipo = document.getElementById("codigoMovimiento");
        const cantidad = document.getElementById("cantidad");

        const resumenAlmacen = document.getElementById("resumenAlmacen");
        const resumenProducto = document.getElementById("resumenProducto");
        const resumenTipo = document.getElementById("resumenTipo");
        const resumenCantidad = document.getElementById("resumenCantidad");
        const resumenPrecioCompra = document.getElementById("resumenPrecioCompra");

        function opcionSeleccionada(select) {
            if (!select || select.selectedIndex < 0) return null;
            return select.options[select.selectedIndex];
        }

        function actualizarResumen() {
            const oa = opcionSeleccionada(almacen);
            const op = opcionSeleccionada(producto);
            const ot = opcionSeleccionada(tipo);

            resumenAlmacen.textContent =
                oa && Number(oa.value) > 0
                    ? (oa.dataset.nombre || oa.textContent.trim())
                    : "-";

            resumenProducto.textContent =
                op && Number(op.value) > 0
                    ? `${op.dataset.codigo || ""} · ${op.dataset.nombre || ""}`
                    : "-";

            resumenTipo.textContent =
                ot ? (ot.dataset.nombre || ot.textContent.trim()) : "-";

            const valorCantidad = Number(cantidad?.value || 0);
            resumenCantidad.textContent = valorCantidad > 0 ? `+${valorCantidad}` : "+0";

            const precio = Number(op?.dataset.compra || 0);
            resumenPrecioCompra.textContent = `S/ ${precio.toFixed(2)}`;
        }

        almacen?.addEventListener("change", actualizarResumen);
        producto?.addEventListener("change", actualizarResumen);
        tipo?.addEventListener("change", actualizarResumen);
        cantidad?.addEventListener("input", actualizarResumen);

        actualizarResumen();
    })();
</script>
