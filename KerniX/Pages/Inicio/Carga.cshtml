
@page
@model KerniX.Pages.Inicio.CargaModel

@{
    Layout = null;
    ViewData["Title"] = "Preparando KerniX";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <style>
        :root {
            --kx-bg: #020712;
            --kx-panel: #07111e;
            --kx-gold: #ffb817;
            --kx-gold-light: #ffe189;
            --kx-purple: #bd4dff;
            --kx-blue: #37a9ff;
            --kx-cyan: #22e0db;
            --kx-green: #39df72;
            --kx-white: #ffffff;
            --kx-muted: #8f9bac;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
        }

        body {
            overflow: hidden;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #020712;
            color: var(--kx-white);
        }


        /* =========================================================
           PÁGINA / FONDO KERNIX
        ========================================================= */

        #kx-loading-page {
            width: 100vw;
            height: 100vh;
            min-height: 650px;

            position: relative;
            isolation: isolate;
            overflow: hidden;

            display: grid;
            grid-template-rows: 95px minmax(0, 1fr) 90px;

            padding: 0 clamp(25px, 4vw, 70px);

            background-color: #020712;

            background-image:
                linear-gradient(
                    180deg,
                    rgba(0, 5, 14, .28) 0%,
                    rgba(1, 7, 18, .40) 48%,
                    rgba(0, 4, 12, .35) 100%
                ),
                url("/images/login/kernix-login-bg.png");

            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
        }


        /* Capa de contraste */
        #kx-loading-page::before {
            content: "";

            position: absolute;
            inset: 0;

            z-index: 0;

            pointer-events: none;

            background:
                radial-gradient(
                    ellipse at 50% 43%,
                    rgba(1, 7, 18, .56) 0%,
                    rgba(1, 7, 18, .43) 30%,
                    rgba(0, 5, 14, .18) 65%,
                    rgba(0, 3, 10, .30) 100%
                );
        }


        /* Borde exterior */
        #kx-loading-page::after {
            content: "";

            position: absolute;
            inset: 10px;

            z-index: 100;

            pointer-events: none;

            border: 1px solid rgba(255, 184, 23, .55);

            box-shadow:
                inset 0 0 18px rgba(255, 184, 23, .03),
                0 0 10px rgba(255, 184, 23, .04);
        }


        /* =========================================================
           ESQUINAS
        ========================================================= */

        .kx-corner {
            width: 55px;
            height: 55px;

            position: absolute;

            z-index: 101;

            pointer-events: none;
        }

        .kx-corner.tl {
            top: 10px;
            left: 10px;

            border-top: 2px solid var(--kx-gold);
            border-left: 2px solid var(--kx-gold);
        }

        .kx-corner.tr {
            top: 10px;
            right: 10px;

            border-top: 2px solid var(--kx-gold);
            border-right: 2px solid var(--kx-gold);
        }

        .kx-corner.bl {
            bottom: 10px;
            left: 10px;

            border-bottom: 2px solid var(--kx-gold);
            border-left: 2px solid var(--kx-gold);
        }

        .kx-corner.br {
            bottom: 10px;
            right: 10px;

            border-bottom: 2px solid var(--kx-gold);
            border-right: 2px solid var(--kx-gold);
        }


        /* =========================================================
           HEADER
        ========================================================= */

        .kx-header {
            width: 100%;
            max-width: 1500px;

            margin: 0 auto;

            display: flex;
            align-items: center;
            justify-content: space-between;

            position: relative;

            z-index: 10;
        }

        .kx-brand {
            display: flex;
            align-items: center;

            gap: 16px;
        }

        .kx-logo {
            width: 74px;
            height: 74px;

            display: flex;
            align-items: center;
            justify-content: center;

            flex: 0 0 74px;

            font-family: Georgia, "Times New Roman", serif;

            font-size: 60px;
            font-weight: 900;
            line-height: 1;

            background:
                linear-gradient(
                    180deg,
                    #fff1ad 0%,
                    #ffc12e 30%,
                    #b96600 68%,
                    #ffd96b 100%
                );

            -webkit-background-clip: text;
            background-clip: text;

            color: transparent;

            filter:
                drop-shadow(0 0 5px rgba(255, 236, 150, .4))
                drop-shadow(0 0 16px rgba(255, 164, 0, .38));
        }

        .kx-brand-title {
            margin: 0;

            color: white;

            font-size: 29px;
            font-weight: 800;
            line-height: 1;
        }

        .kx-brand-title span {
            color: var(--kx-gold);
        }

        .kx-brand-subtitle {
            margin-top: 7px;

            color: #a9b2c0;

            font-size: 11px;
        }


        /* =========================================================
           USUARIO
        ========================================================= */

        .kx-user {
            min-width: 315px;

            display: flex;
            align-items: center;

            gap: 13px;

            padding: 10px 15px;

            border: 1px solid rgba(255, 184, 23, .40);
            border-radius: 12px;

            background:
                linear-gradient(
                    180deg,
                    rgba(8, 16, 28, .88),
                    rgba(3, 9, 17, .92)
                );

            box-shadow:
                inset 0 1px rgba(255,255,255,.03),
                0 8px 30px rgba(0,0,0,.22);

            backdrop-filter: blur(8px);
        }

        .kx-user-icon {
            width: 48px;
            height: 48px;

            flex: 0 0 48px;

            display: flex;
            align-items: center;
            justify-content: center;

            position: relative;

            border: 1px solid rgba(255,184,23,.75);
            border-radius: 50%;

            color: var(--kx-gold);

            box-shadow:
                0 0 12px rgba(255,184,23,.11);
        }

        .kx-user-head {
            width: 11px;
            height: 11px;

            position: absolute;
            top: 10px;

            border: 2px solid currentColor;
            border-radius: 50%;
        }

        .kx-user-body {
            width: 20px;
            height: 12px;

            position: absolute;
            bottom: 8px;

            border: 2px solid currentColor;
            border-bottom: 0;

            border-radius: 12px 12px 0 0;
        }

        .kx-user strong {
            display: block;

            color: #ffd868;

            font-size: 12px;
        }

        .kx-user span {
            display: block;

            margin-top: 4px;

            color: var(--kx-muted);

            font-size: 9px;
        }


        /* =========================================================
           MAIN
        ========================================================= */

        .kx-main {
            width: 100%;
            max-width: 1450px;
            height: 100%;
            min-height: 0;

            margin: 0 auto;

            display: grid;

            grid-template-rows:
                minmax(220px, .95fr)
                auto
                auto
                auto
                auto;

            align-content: center;

            position: relative;

            z-index: 5;
        }


        /* =========================================================
           PORTAL
        ========================================================= */

        .kx-portal {
            min-height: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            position: relative;
        }

        .kx-portal-stage {
            width: 600px;
            height: 230px;

            max-width: 70vw;

            position: relative;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .kx-portal-glow {
            width: 420px;
            height: 190px;

            position: absolute;

            left: 50%;
            top: 49%;

            transform: translate(-50%, -50%);

            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    rgba(255,186,35,.34),
                    rgba(127,48,255,.11) 46%,
                    transparent 73%
                );

            filter: blur(22px);

            animation:
                kxGlow 2.1s ease-in-out infinite;
        }


        /* =========================================================
           ANILLOS
        ========================================================= */

        .kx-ring {
            position: absolute;

            left: 50%;
            top: 45%;

            border-radius: 50%;

            pointer-events: none;
        }

        .kx-ring.one {
            width: 180px;
            height: 180px;

            border:
                2px solid rgba(255,190,41,.70);

            box-shadow:
                0 0 14px rgba(255,184,23,.25),
                inset 0 0 18px rgba(255,184,23,.07);

            animation:
                kxSpin 14s linear infinite;
        }

        .kx-ring.two {
            width: 220px;
            height: 220px;

            border:
                1px dashed rgba(191,76,255,.55);

            box-shadow:
                0 0 13px rgba(187,67,255,.15);

            animation:
                kxSpinReverse 19s linear infinite;
        }

        .kx-ring.three {
            width: 265px;
            height: 265px;

            border:
                1px solid rgba(48,112,255,.16);

            animation:
                kxSpin 28s linear infinite;
        }

        .kx-orbit-dot {
            width: 8px;
            height: 8px;

            position: absolute;

            left: 50%;
            top: 8px;

            transform: translateX(-50%);

            border-radius: 50%;

            background: #ffe79c;

            box-shadow:
                0 0 8px white,
                0 0 16px #ffb817;
        }


        /* =========================================================
           K CENTRAL
        ========================================================= */

        .kx-portal-letter {
            position: relative;

            z-index: 10;

            margin-top: -30px;

            font-family:
                Georgia,
                "Times New Roman",
                serif;

            font-size: 108px;
            font-weight: 900;
            line-height: 1;

            background:
                linear-gradient(
                    180deg,
                    #fff4bd 0%,
                    #ffc334 28%,
                    #9f5200 70%,
                    #ffd66a 100%
                );

            -webkit-background-clip: text;
            background-clip: text;

            color: transparent;

            filter:
                drop-shadow(0 0 8px rgba(255,219,112,.72))
                drop-shadow(0 0 24px rgba(255,132,0,.34));
        }


        /* =========================================================
           PLATAFORMA
        ========================================================= */

        .kx-platform {
            width: 245px;
            height: 48px;

            position: absolute;

            left: 50%;
            bottom: 3px;

            transform: translateX(-50%);

            border-radius: 50%;

            background:
                radial-gradient(
                    ellipse,
                    #ffe88c 0%,
                    #fcb216 8%,
                    #6b3b00 17%,
                    #171006 46%,
                    transparent 70%
                );

            box-shadow:
                0 0 10px #ffbd22,
                0 0 28px rgba(255,135,0,.46);
        }

        .kx-platform::before {
            content: "";

            width: 185px;
            height: 30px;

            position: absolute;

            left: 50%;
            top: 50%;

            transform: translate(-50%, -50%);

            border:
                2px solid rgba(255,177,22,.65);

            border-radius: 50%;

            box-shadow:
                inset 0 0 11px rgba(255,174,22,.32);
        }

        .kx-platform::after {
            content: "";

            width: 90px;
            height: 11px;

            position: absolute;

            left: 50%;
            top: 50%;

            transform: translate(-50%, -50%);

            border-radius: 50%;

            background: #fff6bb;

            box-shadow:
                0 0 10px white,
                0 0 20px #ffb817,
                0 0 35px rgba(255,139,0,.78);
        }


        /* =========================================================
           TORRES
        ========================================================= */

        .kx-tower {
            width: 32px;
            height: 115px;

            position: absolute;

            bottom: 32px;

            clip-path:
                polygon(
                    50% 0%,
                    100% 18%,
                    100% 82%,
                    50% 100%,
                    0 82%,
                    0 18%
                );

            background:
                linear-gradient(
                    180deg,
                    #0b2d63,
                    #081224 60%,
                    #020611
                );

            border:
                1px solid rgba(51,148,255,.35);

            box-shadow:
                0 0 10px rgba(52,145,255,.22);
        }

        .kx-tower::after {
            content: "";

            width: 4px;
            height: 40px;

            position: absolute;

            left: 50%;
            top: 35px;

            transform: translateX(-50%);

            background: #32bdff;

            box-shadow:
                0 0 10px #32bdff;
        }

        .kx-tower.left {
            left: 85px;
        }

        .kx-tower.right {
            right: 85px;
        }

        .kx-tower.left2 {
            left: 150px;
            bottom: 26px;

            height: 82px;

            background:
                linear-gradient(
                    180deg,
                    #382060,
                    #100d27 60%,
                    #030611
                );
        }

        .kx-tower.right2 {
            right: 150px;
            bottom: 26px;

            height: 82px;

            background:
                linear-gradient(
                    180deg,
                    #15334a,
                    #071520 60%,
                    #030611
                );
        }


        /* =========================================================
           INTRO
        ========================================================= */

        .kx-intro {
            text-align: center;

            position: relative;

            z-index: 10;
        }

        .kx-intro-small {
            color: #d4a53b;

            font-size: 9px;
            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: 1.8px;
        }

        .kx-intro h1 {
            margin: 5px 0 0;

            color: white;

            font-size:
                clamp(27px, 2.5vw, 39px);

            font-weight: 700;

            line-height: 1.05;

            text-shadow:
                0 3px 15px rgba(0,0,0,.55);
        }

        .kx-intro h1 span {
            color: var(--kx-gold);
        }

        .kx-intro p {
            margin: 6px 0 0;

            color: #c0c9d6;

            font-size: 12px;

            text-shadow:
                0 2px 7px rgba(0,0,0,.8);
        }


        /* =========================================================
           PROGRESO
        ========================================================= */

        .kx-progress {
            width: min(680px, 82%);

            margin: 13px auto 0;

            position: relative;

            z-index: 10;
        }

        .kx-progress-info {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-bottom: 5px;

            color: #d9e0e9;

            font-size: 10px;
        }

        .kx-progress-info strong {
            color: var(--kx-gold);

            font-size: 16px;

            text-shadow:
                0 0 10px rgba(255,184,23,.34);
        }

        .kx-progress-track {
            width: 100%;
            height: 14px;

            position: relative;

            overflow: hidden;

            padding: 2px;

            border:
                1px solid rgba(255,184,23,.78);

            border-radius: 30px;

            background:
                rgba(0,0,0,.58);

            box-shadow:
                inset 0 0 9px rgba(0,0,0,.8),
                0 0 10px rgba(255,184,23,.08);
        }

        .kx-progress-bar {
            width: 0%;
            height: 100%;

            border-radius: 30px;

            background:
                linear-gradient(
                    90deg,
                    #8e5800 0%,
                    #d98b00 33%,
                    #ffb817 68%,
                    #ffe58e 100%
                );

            box-shadow:
                0 0 11px rgba(255,181,0,.65);

            transition:
                width .20s ease;
        }

        .kx-progress-light {
            width: 6px;
            height: 18px;

            position: absolute;

            top: -3px;
            left: 0%;

            border-radius: 50%;

            background: white;

            box-shadow:
                0 0 7px white,
                0 0 16px #ffc227;

            transition:
                left .20s ease;
        }


        /* =========================================================
           PASOS
        ========================================================= */

        .kx-steps {
            width: min(860px, 94%);

            margin: 16px auto 0;

            display: flex;
            align-items: flex-start;
            justify-content: center;

            position: relative;

            z-index: 10;
        }

        .kx-step {
            width: 112px;
            flex: 0 0 112px;

            text-align: center;

            opacity: .32;

            transition:
                opacity .25s ease,
                transform .25s ease;
        }

        .kx-step.active,
        .kx-step.completed {
            opacity: 1;
        }

        .kx-step.active {
            transform:
                translateY(-3px);
        }

        .kx-step-icon {
            width: 56px;
            height: 56px;

            margin: 0 auto 6px;

            position: relative;

            display: flex;
            align-items: center;
            justify-content: center;

            color: var(--kx-gold);

            font-size: 22px;
            font-weight: 800;
        }

        .kx-step-icon::before {
            content: "";

            position: absolute;

            inset: 6px;

            transform: rotate(30deg);

            border:
                1px solid currentColor;

            border-radius: 9px;

            background:
                linear-gradient(
                    145deg,
                    rgba(16,26,39,.96),
                    rgba(3,8,18,.98)
                );

            box-shadow:
                0 0 9px currentColor;
        }

        .kx-step-icon > span {
            position: relative;

            z-index: 2;
        }

        .kx-step.ai .kx-step-icon {
            color: #db6bff;
        }

        .kx-step strong {
            display: block;

            color: white;

            font-size: 10px;

            text-shadow:
                0 2px 6px #000;
        }

        .kx-step-status {
            display: block;

            margin-top: 3px;

            color: #7f8a9b;

            font-size: 8px;
        }

        .kx-step.completed .kx-step-status {
            color: var(--kx-green);
        }

        .kx-step.active .kx-step-status {
            color: var(--kx-gold);
        }

        .kx-step.ai.active .kx-step-status {
            color: #dc73ff;
        }

        .kx-step-line {
            width: 53px;
            flex: 0 0 53px;

            height: 1px;

            margin-top: 27px;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    rgba(255,184,23,.80),
                    transparent
                );

            box-shadow:
                0 0 5px rgba(255,184,23,.19);
        }


        /* =========================================================
           MÓDULOS
        ========================================================= */

        .kx-modules {
            width: min(920px, 94%);

            margin: 16px auto 0;

            display: grid;

            grid-template-columns:
                repeat(3, minmax(0, 1fr));

            gap: 14px;

            position: relative;

            z-index: 10;
        }

        .kx-module {
            min-height: 118px;

            display: grid;

            grid-template-columns:
                78px minmax(0, 1fr);

            grid-template-rows:
                1fr auto;

            align-items: center;

            gap: 5px 12px;

            padding: 12px 14px;

            border-radius: 11px;

            position: relative;

            overflow: hidden;

            background:
                linear-gradient(
                    180deg,
                    rgba(8,17,29,.91),
                    rgba(3,9,18,.95)
                );

            backdrop-filter: blur(8px);

            box-shadow:
                0 10px 35px rgba(0,0,0,.22);

            transition:
                transform .25s ease,
                background .25s ease;
        }

        .kx-module:hover {
            transform:
                translateY(-3px);

            background:
                linear-gradient(
                    180deg,
                    rgba(11,25,42,.96),
                    rgba(3,9,18,.98)
                );
        }

        .kx-module.sales {
            border:
                1px solid rgba(255,184,23,.55);
        }

        .kx-module.inventory {
            border:
                1px solid rgba(184,74,255,.55);
        }

        .kx-module.ai {
            border:
                1px solid rgba(205,80,255,.57);
        }

        .kx-module-icon {
            width: 68px;
            height: 68px;

            margin: auto;

            position: relative;

            display: flex;
            align-items: center;
            justify-content: center;

            color: var(--kx-gold);

            font-size: 29px;
            font-weight: 800;
        }

        .kx-module-icon::before {
            content: "";

            position: absolute;

            inset: 5px;

            transform:
                rotate(30deg);

            border:
                2px solid currentColor;

            border-radius: 12px;

            background:
                linear-gradient(
                    145deg,
                    #101c2b,
                    #020711
                );

            box-shadow:
                0 0 12px rgba(255,184,23,.30),
                inset 0 0 15px rgba(255,255,255,.03);
        }

        .kx-module-icon span {
            position: relative;

            z-index: 2;
        }

        .kx-module.inventory .kx-module-icon {
            color: var(--kx-purple);
        }

        .kx-module.inventory .kx-module-icon::before {
            box-shadow:
                0 0 15px rgba(184,76,255,.43);
        }

        .kx-module.ai .kx-module-icon {
            color: #dc6cff;
        }

        .kx-module.ai .kx-module-icon::before {
            box-shadow:
                0 0 16px rgba(210,75,255,.48);
        }

        .kx-module-content strong {
            display: block;

            color: white;

            font-size: 13px;
        }

        .kx-module-content small {
            display: block;

            margin-top: 5px;

            color: #aab4c1;

            font-size: 9px;
            line-height: 1.45;
        }

        .kx-module-status {
            grid-column: 1 / -1;

            display: flex;
            align-items: center;
            justify-content: center;

            gap: 6px;

            margin-top: 2px;

            color: #a8b2c0;

            font-size: 9px;
        }

        .kx-status-dot {
            width: 6px;
            height: 6px;

            border-radius: 50%;

            background:
                var(--kx-green);

            box-shadow:
                0 0 7px var(--kx-green);
        }

        .kx-module.inventory .kx-status-dot {
            background:
                var(--kx-purple);

            box-shadow:
                0 0 7px var(--kx-purple);
        }

        .kx-module.ai .kx-status-dot {
            background: #dc6cff;

            box-shadow:
                0 0 7px #dc6cff;
        }


        /* =========================================================
           FOOTER
        ========================================================= */

        .kx-footer {
            width: 100%;
            max-width: 1200px;

            margin: 0 auto;

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            align-items: center;

            position: relative;

            z-index: 10;

            border-top:
                1px solid rgba(255,184,23,.35);
        }

        .kx-footer-item {
            min-width: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            gap: 12px;
        }

        .kx-footer-icon {
            width: 58px;
            height: 58px;

            flex: 0 0 58px;

            display: flex;
            align-items: center;
            justify-content: center;

            position: relative;

            font-size: 27px;

            color: var(--kx-gold);
        }

        .kx-footer-icon::before {
            content: "";

            position: absolute;

            inset: 5px;

            border:
                1px solid currentColor;

            border-radius: 50%;

            opacity: .55;

            box-shadow:
                0 0 11px currentColor;
        }

        .kx-footer-icon.purple {
            color: var(--kx-purple);
        }

        .kx-footer-icon.blue {
            color: var(--kx-blue);
        }

        .kx-footer-item strong {
            display: block;

            color: #e4e8ee;

            font-size: 10px;
        }

        .kx-footer-item small {
            display: block;

            margin-top: 3px;

            color: #8994a3;

            font-size: 8px;
        }


        /* =========================================================
           ANIMACIONES
        ========================================================= */

        @@keyframes kxGlow {

            0%,
            100% {
                opacity: .64;

                transform:
                    translate(-50%, -50%)
                    scale(.96);
            }

            50% {
                opacity: 1;

                transform:
                    translate(-50%, -50%)
                    scale(1.05);
            }
        }

        @@keyframes kxSpin {

            from {
                transform:
                    translate(-50%, -50%)
                    rotate(0deg);
            }

            to {
                transform:
                    translate(-50%, -50%)
                    rotate(360deg);
            }
        }

        @@keyframes kxSpinReverse {

            from {
                transform:
                    translate(-50%, -50%)
                    rotate(360deg);
            }

            to {
                transform:
                    translate(-50%, -50%)
                    rotate(0deg);
            }
        }


        /* =========================================================
           PANTALLAS BAJAS
        ========================================================= */

        @@media (max-height: 760px) and (min-width: 801px) {

            #kx-loading-page {
                grid-template-rows:
                    72px minmax(0, 1fr) 62px;
            }

            .kx-logo {
                width: 54px;
                height: 54px;

                flex-basis: 54px;

                font-size: 45px;
            }

            .kx-brand-title {
                font-size: 23px;
            }

            .kx-portal-stage {
                height: 165px;
            }

            .kx-portal-letter {
                font-size: 82px;
            }

            .kx-ring.one {
                width: 135px;
                height: 135px;
            }

            .kx-ring.two {
                width: 170px;
                height: 170px;
            }

            .kx-ring.three {
                width: 205px;
                height: 205px;
            }

            .kx-tower {
                height: 82px;
            }

            .kx-platform {
                width: 190px;
            }

            .kx-intro h1 {
                font-size: 28px;
            }

            .kx-modules {
                margin-top: 10px;
            }

            .kx-module {
                min-height: 90px;
            }

            .kx-module-icon {
                width: 58px;
                height: 58px;
            }
        }


        /* =========================================================
           MÓVIL
        ========================================================= */

        @@media (max-width: 800px) {

            html,
            body {
                height: auto;

                overflow-x: hidden;
                overflow-y: auto;
            }

            #kx-loading-page {
                width: 100%;
                height: auto;

                min-height: 100dvh;

                display: block;

                padding:
                    14px 17px 25px;

                background-attachment: scroll;

                background-position:
                    center top;
            }

            .kx-header {
                min-height: 70px;
            }

            .kx-user {
                display: none;
            }

            .kx-logo {
                width: 54px;
                height: 54px;

                flex-basis: 54px;

                font-size: 44px;
            }

            .kx-brand-title {
                font-size: 22px;
            }

            .kx-brand-subtitle {
                display: none;
            }

            .kx-main {
                display: block;
            }

            .kx-portal {
                height: 210px;

                margin-top: 10px;
            }

            .kx-portal-stage {
                width: 100%;
                height: 210px;

                max-width: 100%;
            }

            .kx-portal-letter {
                font-size: 86px;
            }

            .kx-ring.one {
                width: 145px;
                height: 145px;
            }

            .kx-ring.two {
                width: 180px;
                height: 180px;
            }

            .kx-ring.three {
                width: 215px;
                height: 215px;
            }

            .kx-tower.left {
                left: 35px;
            }

            .kx-tower.right {
                right: 35px;
            }

            .kx-tower.left2 {
                left: 88px;
            }

            .kx-tower.right2 {
                right: 88px;
            }

            .kx-intro {
                margin-top: 10px;
            }

            .kx-intro h1 {
                font-size: 27px;
            }

            .kx-progress {
                width: 95%;

                margin-top: 15px;
            }

            .kx-steps {
                width: 100%;

                margin-top: 20px;
            }

            .kx-step {
                width: 58px;

                flex-basis: 58px;
            }

            .kx-step-line {
                width: 17px;

                flex-basis: 17px;
            }

            .kx-step-icon {
                width: 43px;
                height: 43px;

                font-size: 15px;
            }

            .kx-step strong {
                font-size: 7px;
            }

            .kx-step-status {
                display: none;
            }

            .kx-modules {
                width: 100%;

                grid-template-columns: 1fr;

                gap: 12px;

                margin-top: 25px;
            }

            .kx-module {
                min-height: 105px;
            }

            .kx-footer {
                margin-top: 25px;

                padding-top: 16px;

                grid-template-columns: 1fr;

                gap: 15px;
            }

            .kx-footer-item {
                width: 270px;

                max-width: 90%;

                margin: 0 auto;

                justify-content: flex-start;
            }
        }

    </style>
</head>

<body>

    <div id="kx-loading-page">

        <!-- ESQUINAS -->
        <span class="kx-corner tl"></span>
        <span class="kx-corner tr"></span>
        <span class="kx-corner bl"></span>
        <span class="kx-corner br"></span>


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <header class="kx-header">

            <div class="kx-brand">

                <div class="kx-logo">
                    K
                </div>

                <div>

                    <h2 class="kx-brand-title">
                        Kerni<span>X</span>
                    </h2>

                    <div class="kx-brand-subtitle">
                        Gestión inteligente de ventas e inventario
                    </div>

                </div>

            </div>


            <div class="kx-user">

                <div class="kx-user-icon">
                    <span class="kx-user-head"></span>
                    <span class="kx-user-body"></span>
                </div>

                <div>

                    <strong>
                        Bienvenido, @Model.NombreCompleto
                    </strong>

                    <span>
                        @Model.Cargo
                    </span>

                    <span>
                        Tu espacio de trabajo estará listo en unos segundos.
                    </span>

                </div>

            </div>

        </header>


        <!-- =====================================================
             MAIN
        ====================================================== -->

        <main class="kx-main">


            <!-- PORTAL -->

            <section class="kx-portal">

                <div class="kx-portal-stage">

                    <div class="kx-portal-glow"></div>

                    <div class="kx-ring three"></div>

                    <div class="kx-ring two">
                        <span class="kx-orbit-dot"></span>
                    </div>

                    <div class="kx-ring one">
                        <span class="kx-orbit-dot"></span>
                    </div>

                    <div class="kx-tower left"></div>

                    <div class="kx-tower right"></div>

                    <div class="kx-tower left2"></div>

                    <div class="kx-tower right2"></div>

                    <div class="kx-portal-letter">
                        K
                    </div>

                    <div class="kx-platform"></div>

                </div>

            </section>


            <!-- INTRO -->

            <section class="kx-intro">

                <span class="kx-intro-small">
                    KerniX está preparando tu sesión
                </span>

                <h1>
                    Iniciando experiencia
                    <span>KerniX</span>
                </h1>

                <p id="kxLoadingText">
                    Verificando sesión y permisos...
                </p>

            </section>


            <!-- PROGRESS -->

            <section class="kx-progress">

                <div class="kx-progress-info">

                    <span id="kxProgressLabel">
                        Inicializando sistema
                    </span>

                    <strong id="kxPercentage">
                        0%
                    </strong>

                </div>

                <div class="kx-progress-track">

                    <div id="kxProgressBar"
                         class="kx-progress-bar">
                    </div>

                    <div id="kxProgressLight"
                         class="kx-progress-light">
                    </div>

                </div>

            </section>


            <!-- STEPS -->

            <section class="kx-steps">

                <article class="kx-step active"
                         data-step="1">

                    <div class="kx-step-icon">
                        <span>✓</span>
                    </div>

                    <strong>Sesión</strong>

                    <span class="kx-step-status">
                        Verificando
                    </span>

                </article>


                <div class="kx-step-line"></div>


                <article class="kx-step"
                         data-step="2">

                    <div class="kx-step-icon">
                        <span>🔒</span>
                    </div>

                    <strong>Permisos</strong>

                    <span class="kx-step-status">
                        Esperando
                    </span>

                </article>


                <div class="kx-step-line"></div>


                <article class="kx-step"
                         data-step="3">

                    <div class="kx-step-icon">
                        <span>◈</span>
                    </div>

                    <strong>Inventario</strong>

                    <span class="kx-step-status">
                        Esperando
                    </span>

                </article>


                <div class="kx-step-line"></div>


                <article class="kx-step"
                         data-step="4">

                    <div class="kx-step-icon">
                        <span>$</span>
                    </div>

                    <strong>Ventas</strong>

                    <span class="kx-step-status">
                        Esperando
                    </span>

                </article>


                <div class="kx-step-line"></div>


                <article class="kx-step ai"
                         data-step="5">

                    <div class="kx-step-icon">
                        <span>AI</span>
                    </div>

                    <strong>KerniX AI</strong>

                    <span class="kx-step-status">
                        Esperando
                    </span>

                </article>

            </section>


            <!-- MODULES -->

            <section class="kx-modules">

                <!-- VENTAS -->

                <article class="kx-module sales">

                    <div class="kx-module-icon">
                        <span>$</span>
                    </div>

                    <div class="kx-module-content">

                        <strong>
                            Ventas
                        </strong>

                        <small>
                            Pedidos, clientes y seguimiento comercial
                        </small>

                    </div>

                    <div class="kx-module-status">

                        <span class="kx-status-dot"></span>

                        Listo

                    </div>

                </article>


                <!-- INVENTARIO -->

                <article class="kx-module inventory">

                    <div class="kx-module-icon">
                        <span>◈</span>
                    </div>

                    <div class="kx-module-content">

                        <strong>
                            Inventario
                        </strong>

                        <small>
                            Productos, stock, almacenes y Kardex
                        </small>

                    </div>

                    <div class="kx-module-status">

                        <span class="kx-status-dot"></span>

                        Sincronizando

                    </div>

                </article>


                <!-- AI -->

                <article class="kx-module ai">

                    <div class="kx-module-icon">
                        <span>AI</span>
                    </div>

                    <div class="kx-module-content">

                        <strong>
                            KerniX AI
                        </strong>

                        <small>
                            Pronósticos, reposición y análisis inteligente
                        </small>

                    </div>

                    <div class="kx-module-status">

                        <span class="kx-status-dot"></span>

                        Inicializando

                    </div>

                </article>

            </section>

        </main>


        <!-- =====================================================
             FOOTER
        ====================================================== -->

        <footer class="kx-footer">

            <div class="kx-footer-item">

                <div class="kx-footer-icon">
                    ◆
                </div>

                <div>

                    <strong>
                        Seguro
                    </strong>

                    <small>
                        Protegemos tu información
                    </small>

                </div>

            </div>


            <div class="kx-footer-item">

                <div class="kx-footer-icon purple">
                    ☁
                </div>

                <div>

                    <strong>
                        Disponible 24/7
                    </strong>

                    <small>
                        Servicios siempre conectados
                    </small>

                </div>

            </div>


            <div class="kx-footer-item">

                <div class="kx-footer-icon blue">
                    ↗
                </div>

                <div>

                    <strong>
                        Analítica en tiempo real
                    </strong>

                    <small>
                        Decisiones basadas en datos
                    </small>

                </div>

            </div>

        </footer>

    </div>


    <script>

        (() => {

            const progressBar =
                document.getElementById("kxProgressBar");

            const progressLight =
                document.getElementById("kxProgressLight");

            const percentage =
                document.getElementById("kxPercentage");

            const progressLabel =
                document.getElementById("kxProgressLabel");

            const loadingText =
                document.getElementById("kxLoadingText");

            const steps =
                Array.from(
                    document.querySelectorAll(".kx-step")
                );


            const stages = [

                {
                    start: 0,
                    end: 20,

                    label:
                        "Verificando sesión",

                    text:
                        "Comprobando acceso y sesión segura..."
                },

                {
                    start: 21,
                    end: 40,

                    label:
                        "Cargando permisos",

                    text:
                        "Validando permisos y configuración del usuario..."
                },

                {
                    start: 41,
                    end: 60,

                    label:
                        "Sincronizando inventario",

                    text:
                        "Preparando productos, stock y Kardex..."
                },

                {
                    start: 61,
                    end: 80,

                    label:
                        "Preparando ventas",

                    text:
                        "Inicializando clientes y operaciones comerciales..."
                },

                {
                    start: 81,
                    end: 100,

                    label:
                        "Activando KerniX AI",

                    text:
                        "Preparando análisis, pronósticos y recomendaciones..."
                }

            ];


            let progress = 0;


            function getStageIndex(value) {

                if (value <= 20)
                    return 0;

                if (value <= 40)
                    return 1;

                if (value <= 60)
                    return 2;

                if (value <= 80)
                    return 3;

                return 4;
            }


            function updateSteps(activeIndex) {

                steps.forEach(
                    (step, index) => {

                        step.classList.remove(
                            "active",
                            "completed"
                        );

                        const status =
                            step.querySelector(
                                ".kx-step-status"
                            );


                        if (index < activeIndex) {

                            step.classList.add(
                                "completed"
                            );

                            if (status) {
                                status.textContent =
                                    "Completado";
                            }
                        }

                        else if (
                            index === activeIndex
                        ) {

                            step.classList.add(
                                "active"
                            );

                            if (status) {
                                status.textContent =
                                    "En proceso";
                            }
                        }

                        else {

                            if (status) {
                                status.textContent =
                                    "Esperando";
                            }
                        }

                    }
                );
            }


            function updateLoading() {

                progress +=
                    Math.random() * 1.7 + .55;


                if (progress > 100) {
                    progress = 100;
                }


                const value =
                    Math.floor(progress);


                progressBar.style.width =
                    value + "%";


                progressLight.style.left =
                    `calc(${value}% - 3px)`;


                percentage.textContent =
                    value + "%";


                const stageIndex =
                    getStageIndex(value);


                const currentStage =
                    stages[stageIndex];


                progressLabel.textContent =
                    currentStage.label;


                loadingText.textContent =
                    currentStage.text;


                updateSteps(stageIndex);


                if (progress < 100) {

                    setTimeout(
                        updateLoading,
                        80
                    );

                    return;
                }


                percentage.textContent =
                    "100%";


                progressLabel.textContent =
                    "KerniX listo";


                loadingText.textContent =
                    "Tu espacio de trabajo está preparado.";


                steps.forEach(
                    step => {

                        step.classList.remove(
                            "active"
                        );

                        step.classList.add(
                            "completed"
                        );

                        const status =
                            step.querySelector(
                                ".kx-step-status"
                            );

                        if (status) {
                            status.textContent =
                                "Completado";
                        }
                    }
                );


                /* ================================================
                   REDIRECCIÓN ORIGINAL
                   NO CAMBIAMOS BACKEND
                ================================================= */

                setTimeout(() => {

                    window.location.href =
                        "/Inicio/Index";

                }, 700);
            }


            setTimeout(
                updateLoading,
                500
            );

        })();

    </script>

</body>
</html>
