@page
@model KerniX.Pages.Cotizacion.IndexModel

@using System.Globalization
@using System.Text.Json

@{
    Layout = null;

    ViewData["Title"] = "Cotizaciones";


    /* ============================================================
       USUARIO
       ============================================================ */

    var nombreUsuario =
        HttpContext.Session.GetString("NombreUsuario")
        ?? "Administrador";

    var empleado =
        HttpContext.Session.GetString("Empleado")
        ?? nombreUsuario;

    var cargo =
        HttpContext.Session.GetString("Cargo")
        ?? "Administrador";

    var inicial =
        string.IsNullOrWhiteSpace(empleado)
            ? "A"
            : empleado.Substring(0, 1).ToUpper();


    /* ============================================================
       DATOS GRÁFICO
       ============================================================ */

    var estadosLabels =
        Model.Estados
            .Select(x => x.Estado)
            .ToList();

    var estadosValores =
        Model.Estados
            .Select(x => x.Cantidad)
            .ToList();

    var labelsJson =
        JsonSerializer.Serialize(
            estadosLabels
        );

    var valoresJson =
        JsonSerializer.Serialize(
            estadosValores
        );


    /* ============================================================
       CLIENTES PARA FILTRO
       ============================================================ */

    var clientes =
        Model.Cotizaciones
            .GroupBy(
                x => new
                {
                    x.IdCliente,
                    x.Cliente
                }
            )
            .Select(x => x.Key)
            .OrderBy(x => x.Cliente)
            .ToList();


    /* ============================================================
       TOP PRODUCTOS
       ============================================================ */

    decimal maxProducto =
        Model.TopProductos.Count > 0
            ? Model.TopProductos.Max(
                x => x.TotalCotizado
            )
            : 1;

    if (maxProducto <= 0)
    {
        maxProducto = 1;
    }
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color"
          content="#020812" />

    <title>
        Cotizaciones | KerniX
    </title>


    <!-- GOOGLE FONT -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />


    <!-- FONT AWESOME -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />


    <!-- CSS KERNIX -->

    <link rel="stylesheet"
          href="~/css/cotizacion/index.css"
          asp-append-version="true" />


    <style>

            /*
                     * =========================================================
                     * COMPLEMENTOS DEL INDEX
                     * =========================================================
                     */

            .kx-user-area {
                position: relative;
                cursor: pointer;
                user-select: none;
            }


            /* =========================================================
                       USER DROPDOWN
                       ========================================================= */

            .kx-user-dropdown {
                position: absolute;
                top: calc(100% + 13px);
                right: 0;
                z-index: 6000;
                display: none;
                width: 220px;
                overflow: hidden;
                border: 1px solid #1c3c59;
                border-radius: 10px;
                background: #061321;
                box-shadow: 0 20px 50px rgba(0, 0, 0, .55);
            }

                .kx-user-dropdown.show {
                    display: block;
                }

            .kx-user-dropdown-header {
                padding: 14px;
                border-bottom: 1px solid #17304a;
            }

                .kx-user-dropdown-header strong {
                    display: block;
                    color: #ffffff;
                    font-size: 11px;
                }

                .kx-user-dropdown-header span {
                    display: block;
                    margin-top: 4px;
                    color: #71879d;
                    font-size: 8px;
                }

            .kx-user-dropdown a {
                display: flex;
                align-items: center;
                min-height: 40px;
                padding: 0 13px;
                gap: 10px;
                color: #b7c7d7;
                text-decoration: none;
                font-size: 10px;
            }

                .kx-user-dropdown a:hover {
                    color: white;
                    background: #0a2035;
                }

                .kx-user-dropdown a i {
                    width: 16px;
                    color: #f6b91f;
                }

                .kx-user-dropdown a.logout {
                    color: #ff8787;
                    border-top: 1px solid #17304a;
                }

                    .kx-user-dropdown a.logout i {
                        color: #ff5b5b;
                    }


            /* =========================================================
                       DATE POPUP
                       ========================================================= */

            .kx-top-range {
                position: relative;
                cursor: pointer;
            }

            .kx-range-popup {
                position: absolute;
                top: calc(100% + 12px);
                right: 0;
                z-index: 5500;
                display: none;
                width: 320px;
                padding: 14px;
                border: 1px solid #76540d;
                border-radius: 10px;
                background: #061321;
                box-shadow: 0 20px 50px rgba(0, 0, 0, .55);
                cursor: default;
            }

                .kx-range-popup.show {
                    display: block;
                }

            .kx-range-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 9px;
            }

            .kx-range-field label {
                display: block;
                margin-bottom: 6px;
                color: #8096aa;
                font-size: 8px;
            }

            .kx-range-field input {
                width: 100%;
                height: 35px;
                padding: 0 9px;
                color: #dce7f0;
                border: 1px solid #1b3a57;
                border-radius: 6px;
                outline: none;
                background: #040e19;
                font-size: 9px;
            }

                .kx-range-field input:focus {
                    border-color: #f6b91f;
                }

            .kx-range-actions {
                display: flex;
                margin-top: 11px;
                gap: 8px;
            }

                .kx-range-actions a,
                .kx-range-actions button {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    flex: 1;
                    height: 33px;
                    border-radius: 6px;
                    text-decoration: none;
                    font-size: 9px;
                    font-weight: 700;
                    cursor: pointer;
                }

            .kx-range-reset {
                color: #9aabba;
                border: 1px solid #1b3955;
                background: #071523;
            }

            .kx-range-apply {
                color: #07101a;
                border: 1px solid #ffe084;
                background: linear-gradient( 180deg, #ffd55a, #d49113 );
            }


            /* =========================================================
                       GLOBAL SEARCH RESULTS
                       ========================================================= */

            .kx-global-search {
                position: relative;
            }

            .kx-global-results {
                position: absolute;
                top: calc(100% + 10px);
                left: 0;
                z-index: 5000;
                display: none;
                width: 100%;
                max-height: 340px;
                overflow-y: auto;
                border: 1px solid #1a3a58;
                border-radius: 9px;
                background: #061321;
                box-shadow: 0 20px 45px rgba(0, 0, 0, .55);
            }

                .kx-global-results.show {
                    display: block;
                }

            .kx-global-result {
                display: flex;
                align-items: center;
                min-height: 50px;
                padding: 8px 11px;
                gap: 10px;
                border-bottom: 1px solid rgba(25, 55, 82, .7);
                color: #d9e5ef;
                text-decoration: none;
            }

                .kx-global-result:hover {
                    background: #0a2035;
                }

            .kx-global-result-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                width: 30px;
                height: 30px;
                color: #f6b91f;
                border: 1px solid #75520d;
                border-radius: 6px;
                background: rgba(246, 185, 31, .06);
            }

            .kx-global-result-data {
                min-width: 0;
            }

                .kx-global-result-data strong {
                    display: block;
                    overflow: hidden;
                    color: #e5edf5;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                    font-size: 9px;
                }

                .kx-global-result-data span {
                    display: block;
                    margin-top: 3px;
                    overflow: hidden;
                    color: #74899e;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                    font-size: 8px;
                }

            .kx-global-empty {
                padding: 25px;
                color: #62798f;
                text-align: center;
                font-size: 9px;
            }


            /* =========================================================
                       ROW ACTIONS
                       ========================================================= */

            .kx-actions {
                position: relative;
            }

            .kx-row-menu {
                position: absolute;
                top: 23px;
                right: 0;
                z-index: 3000;
                display: none;
                width: 155px;
                overflow: hidden;
                border: 1px solid #1b3b58;
                border-radius: 7px;
                background: #061321;
                box-shadow: 0 15px 30px rgba(0, 0, 0, .5);
            }

                .kx-row-menu.show {
                    display: block;
                }

                .kx-row-menu a {
                    display: flex;
                    align-items: center;
                    min-height: 34px;
                    padding: 0 10px;
                    gap: 8px;
                    color: #b9c7d5;
                    text-decoration: none;
                    font-size: 8px;
                }

                    .kx-row-menu a:hover {
                        color: white;
                        background: #0a2035;
                    }

                .kx-row-menu i {
                    width: 13px;
                    color: #f6b91f;
                }


            /* =========================================================
                       PAGINATION
                       ========================================================= */

            .kx-page-row.page-hidden {
                display: none;
            }


            /* =========================================================
                       3D CHART
                       ========================================================= */

            .kx-donut.kx-donut-3d {
                perspective: 900px;
            }

                .kx-donut.kx-donut-3d canvas {
                    filter: drop-shadow( 0 17px 10px rgba(0, 0, 0, .55) );
                }

            .kx-donut-center {
                z-index: 5;
            }


            /* =========================================================
                       NOTIFICATION PANELS
                       ========================================================= */

            .kx-top-panel {
                position: fixed;
                top: 62px;
                right: 20px;
                z-index: 7000;
                display: none;
                width: 310px;
                overflow: hidden;
                border: 1px solid #1b3b58;
                border-radius: 10px;
                background: #061321;
                box-shadow: 0 20px 55px rgba(0, 0, 0, .58);
            }

                .kx-top-panel.show {
                    display: block;
                }

            .kx-top-panel-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                min-height: 45px;
                padding: 0 13px;
                border-bottom: 1px solid #17304a;
            }

                .kx-top-panel-header strong {
                    color: #ffffff;
                    font-size: 11px;
                }

                .kx-top-panel-header span {
                    color: #f6b91f;
                    font-size: 8px;
                }

            .kx-top-panel-item {
                display: flex;
                align-items: center;
                min-height: 55px;
                padding: 8px 12px;
                gap: 9px;
                border-bottom: 1px solid rgba(23, 48, 74, .75);
            }

            .kx-top-panel-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                width: 30px;
                height: 30px;
                color: #f6b91f;
                border: 1px solid #66490d;
                border-radius: 6px;
                background: rgba(246, 185, 31, .05);
            }

            .kx-top-panel-item strong {
                display: block;
                color: #dbe6f0;
                font-size: 8px;
            }

            .kx-top-panel-item span {
                display: block;
                margin-top: 3px;
                color: #70869b;
                font-size: 7px;
            }


            /* =========================================================
                       VIEW ALL
                       ========================================================= */

            .kx-view-all {
                color: #f6b91f;
                border: 0;
                background: none;
                font-size: 9px;
                cursor: pointer;
            }


            /* =========================================================
                       MOBILE
                       ========================================================= */

            @@media(max-width:700px) {

                .kx-user-dropdown {
                    position: fixed;
                    top: 60px;
                    right: 10px;
                }

                .kx-range-popup {
                    position: fixed;
                    top: 60px;
                    right: 10px;
                    left: 10px;
                    width: auto;
                }

                .kx-top-panel {
                    right: 10px;
                    left: 10px;
                    width: auto;
                }
            }

    </style>

</head>


