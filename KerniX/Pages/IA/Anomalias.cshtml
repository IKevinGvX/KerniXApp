        }

    .ka-explanation {
        min-width: 270px;
        color: #8ba7ba !important;
        font-size: 9px !important;
        line-height: 1.45;
    }


    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .ka-empty {
        padding: 24px 18px;
        text-align: center;
        color: #7895aa;
    }

    .ka-empty-icon {
        width: 50px;
        height: 50px;
        display: grid;
        place-items: center;
        margin: 0 auto 10px;
        color: var(--green);
        border: 1px solid rgba(53,230,173,.2);
        border-radius: 50%;
        background: rgba(53,230,173,.05);
        box-shadow: 0 0 25px rgba(53,230,173,.08);
    }

    .ka-empty strong {
        display: block;
        color: #d9e8f2;
        font-size: 13px;
    }

    .ka-empty p {
        max-width: 650px;
        margin: 7px auto 0;
        font-size: 10px;
        line-height: 1.55;
    }


    /* =========================================================
           FOOTER
           ========================================================= */

    .ka-footer {
        padding: 12px 5px 0;
        color: #49677d;
        font-size: 9px;
        text-align: center;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media(max-width:1100px) {

        .ka-kpis {
            grid-template-columns: repeat(3,1fr);
        }

        .ka-methods {
            grid-template-columns: 1fr 1fr;
        }
    }


    @@media(max-width:900px) {

        .ka-hero {
            grid-template-columns: 1fr;
            padding: 22px;
        }

        .ka-orb {
            display: none;
        }

        .ka-form {
            grid-template-columns: 1fr 1fr;
        }

        .ka-analyze {
            grid-column: 1 / -1;
            width: 100%;
        }

        .ka-grid2 {
            grid-template-columns: 1fr;
        }

        .ka-chart {
            height: 145px;
        }

        .ka-kpis {
            grid-template-columns: 1fr 1fr;
        }
    }


    @@media(max-width:620px) {

        .ka-container {
            width: calc(100% - 18px);
        }

        .ka-hero h1 {
            font-size: 34px;
        }

        .ka-form {
            grid-template-columns: 1fr;
        }

        .ka-analyze {
            grid-column: auto;
        }

        .ka-kpis {
            grid-template-columns: 1fr;
        }

        .ka-methods {
            grid-template-columns: 1fr;
        }

        .ka-console-head,
        .ka-panel-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .ka-period {
            flex-direction: column;
            gap: 4px;
        }
    }

</style>


<div class="ka-page">

    <main class="ka-container">


        <!-- =====================================================
             BREADCRUMB
             ===================================================== -->

        <nav class="ka-breadcrumb">

            <a href="/">
                Inicio
            </a>

            <span>/</span>

            <a href="/IA/Index">
                KerniX Intelligence
            </a>

            <span>/</span>

            <strong>
                Anomalías
            </strong>

        </nav>


        <!-- =====================================================
             HERO
             ===================================================== -->

        <section class="ka-hero">

            <div>

                <div class="ka-eyebrow">

                    <span class="ka-dot"></span>

                    KERNIX INTELLIGENCE · DETECCIÓN ESTADÍSTICA

                </div>


                <h1>

                    Detección de

                    <span>
                        anomalías
                    </span>

                </h1>


                <p>

                    Analiza las ventas reales de KerniX ERP,
                    identifica desviaciones relevantes y compara
                    el comportamiento diario con una línea base
                    estadística de 28 días.

                </p>


                <div class="ka-actions">

                    <a href="/IA/Index"
                       class="ka-btn">

                        <span uk-icon="icon:grid;ratio:.8"></span>

                        PANEL IA

                    </a>


                    <a href="/Ventas/PrincipalVentas"
                       class="ka-btn">

                        <span uk-icon="icon:cart;ratio:.8"></span>

                        VENTAS

                    </a>

                </div>

            </div>


            <div class="ka-orb"
                 aria-hidden="true">

                <div class="ka-core">

                    <span uk-icon="icon:warning;ratio:1.45"></span>

                </div>

            </div>

        </section>


        <!-- =====================================================
             MENSAJES
             ===================================================== -->
        @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
        {
            <div class="ka-message ka-error">

                <span uk-icon="warning"></span>

                @Model.MensajeError

            </div>
        }


        @if (!string.IsNullOrWhiteSpace(Model.Analisis.Aviso))
        {
            <div class="ka-message ka-info">

                <span uk-icon="info"></span>

                @Model.Analisis.Aviso

            </div>
        }


        <!-- =====================================================
             CONSOLA DE ANÁLISIS
             ===================================================== -->

        <section class="ka-console">

            <div class="ka-console-head">

                <div class="ka-title-row">

                    <div class="ka-title-icon">

                        <span uk-icon="icon:calendar;ratio:1"></span>

                    </div>

                    <div>

                        <span class="ka-kicker">
                            PERÍODO DE ANÁLISIS
                        </span>

                        <h2>
                            Selecciona el rango comercial
                        </h2>

                        <p>
                            El motor analizará únicamente el período seleccionado.
                        </p>

                    </div>

                </div>


                <span class="ka-live">
                    MOTOR ACTIVO
                </span>

            </div>


            <form method="get"
                  action="/IA/Anomalias">


                <div class="ka-form">


                    <!-- FECHA DESDE -->

                    <div class="ka-field">

                        <label for="FechaDesde">
                            FECHA INICIAL
                        </label>

                        <input id="FechaDesde"
                               name="FechaDesde"
                               type="date"
                               class="ka-date"
                               value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" />

                    </div>


                    <!-- FECHA HASTA -->

                    <div class="ka-field">

                        <label for="FechaHasta">
                            FECHA FINAL
                        </label>

                        <input id="FechaHasta"
                               name="FechaHasta"
                               type="date"
                               class="ka-date"
                               value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" />

                    </div>


                    <!-- BOTÓN -->

                    <button type="submit"
                            class="ka-analyze">

                        <span uk-icon="icon:search;ratio:.9"></span>

                        ANALIZAR PERÍODO

                    </button>

                </div>

            </form>


            <!-- =================================================
                 ATAJOS
                 ================================================= -->

            <div class="ka-presets">

                <span class="ka-kicker">
                    ACCESO RÁPIDO:
                </span>


                <a href="/IA/Anomalias?FechaDesde=@DateTime.Today.ToString("yyyy-MM-dd")&FechaHasta=@DateTime.Today.ToString("yyyy-MM-dd")"
                   class="ka-chip">

                    HOY

                </a>


                <a href="/IA/Anomalias?FechaDesde=@DateTime.Today.AddDays(-6).ToString("yyyy-MM-dd")&FechaHasta=@DateTime.Today.ToString("yyyy-MM-dd")"
                   class="ka-chip">

                    7 DÍAS

                </a>


                <a href="/IA/Anomalias?FechaDesde=@DateTime.Today.AddDays(-29).ToString("yyyy-MM-dd")&FechaHasta=@DateTime.Today.ToString("yyyy-MM-dd")"
                   class="ka-chip">

                    30 DÍAS

                </a>


                <a href="/IA/Anomalias?FechaDesde=@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"))&FechaHasta=@DateTime.Today.ToString("yyyy-MM-dd")"
                   class="ka-chip">

                    ESTE MES

                </a>

            </div>


            <!-- =================================================
                 PERÍODO ACTUAL
                 ================================================= -->

            <div class="ka-period">

                <span>

                    Período:

                    <strong>
                        @desdeTexto — @hastaTexto
                    </strong>

                </span>


                <span>

                    Duración:

                    <strong>
                        @Model.DiasPeriodo días
                    </strong>

                </span>

            </div>

        </section>


        <!-- =====================================================
             KPIs
             ===================================================== -->

        <section class="ka-kpis">


            <!-- ANOMALÍAS -->

            <article class="ka-kpi ka-red">

                <div class="ka-kpi-top">

                    <span class="ka-kpi-label">
                        Anomalías detectadas
                    </span>

                    <span class="ka-kpi-icon"
                          uk-icon="warning">
                    </span>

                </div>


                <strong>
                    @Model.Analisis.TotalAlertas
                </strong>


                <small>
                    Señales que requieren revisión
                </small>

            </article>


            <!-- DÍAS -->

            <article class="ka-kpi ka-gold">

                <div class="ka-kpi-top">

                    <span class="ka-kpi-label">
                        Días analizados
                    </span>

                    <span class="ka-kpi-icon"
                          uk-icon="calendar">
                    </span>

                </div>


                <strong>
                    @Model.DiasPeriodo
                </strong>


                <small>
                    Duración del período seleccionado
                </small>

            </article>


            <!-- ACTIVIDAD -->

            <article class="ka-kpi ka-cyan">

                <div class="ka-kpi-top">

                    <span class="ka-kpi-label">
                        Días con ventas
                    </span>

                    <span class="ka-kpi-icon"
                          uk-icon="cart">
                    </span>

                </div>


                <strong>
                    @Model.Analisis.DiasConVentas
                </strong>


                <small>
                    Fechas con actividad comercial
                </small>

            </article>

        </section>


        <!-- =====================================================
             DOS GRÁFICOS PRINCIPALES
             ===================================================== -->

        <div class="ka-grid2">


            <!-- =================================================
                 GRÁFICO 1 - IMPORTE
                 ================================================= -->

            <section class="ka-panel">

                <div class="ka-panel-head">

                    <div>

                        <span class="ka-kicker">
                            IMPORTE
                        </span>

                        <h2>
                            Ventas recientes
                        </h2>

                        <p>
                            Evolución del importe diario.
                        </p>

                    </div>


                    <span class="ka-badge">
                        @recientes.Count DÍAS
                    </span>

                </div>


                @if (recientes.Count > 0)
                {
                    <div class="ka-chart-pad">

                        <div class="ka-chart">

                            @foreach (var dia in recientes)
                            {
                                decimal altura =
                                    Math.Max(
                                        3M,
                                        dia.Total / maxReciente * 100M
                                    );

                                bool anomalia =
                                    fechasAnomalias.Contains(
                                        dia.Fecha.Date
                                    );


                                <div class="ka-bar-item @(anomalia ? "anomaly" : "")">


                                    <div class="ka-tooltip">

                                        <strong>
                                            @dia.Fecha.ToString("dd/MM/yyyy")
                                        </strong>

                                        <br />

                                        Importe:
                                        S/ @dia.Total.ToString("N2")

                                        <br />

                                        Operaciones:
                                        @dia.Operaciones

                                        @if (anomalia)
                                        {
                                            <br />

                                            <strong style="color:#ff7b8e;">
                                                ANOMALÍA DETECTADA
                                            </strong>
                                        }

                                    </div>


                                    <div class="ka-bar"
                                         style="height:@altura.ToString("0.##", CultureInfo.InvariantCulture)%">
                                    </div>


                                    <span class="ka-label">
                                        @dia.Fecha.ToString("dd/MM")
                                    </span>

                                </div>
                            }

                        </div>

                    </div>
                }
                else
                {
                    <div class="ka-empty">

                        <strong>
                            Sin datos comerciales
                        </strong>

                        <p>
                            No existen ventas suficientes para representar este gráfico.
                        </p>

                    </div>
                }

            </section>


            <!-- =================================================
                 GRÁFICO 2 - RESUMEN MENSUAL
                 ================================================= -->

            <section class="ka-panel">

                <div class="ka-panel-head">

                    <div>

                        <span class="ka-kicker">
                            RESUMEN
                        </span>

                        <h2>
                            Importe por mes
                        </h2>

                        <p>
                            Comparación mensual del período.
                        </p>

                    </div>


                    <span class="ka-badge">
                        @meses.Count MESES
                    </span>

                </div>


                @if (meses.Count > 0)
                {
                    <div class="ka-chart-pad">

                        <div class="ka-chart">

                            @foreach (var mes in meses)
                            {
                                decimal altura =
                                    Math.Max(
                                        3M,
                                        mes.Total / maxMes * 100M
                                    );


                                <div class="ka-bar-item">


                                    <div class="ka-tooltip">

                                        <strong>
                                            @mes.Fecha.ToString("MMMM yyyy")
                                        </strong>

                                        <br />

                                        Importe:
                                        S/ @mes.Total.ToString("N2")

                                        <br />

                                        Operaciones:
                                        @mes.Operaciones

                                    </div>


                                    <div class="ka-bar"
                                         style="height:@altura.ToString("0.##", CultureInfo.InvariantCulture)%">
                                    </div>


                                    <span class="ka-label">
                                        @mes.Fecha.ToString("MM/yy")
                                    </span>

                                </div>
                            }

                        </div>

                    </div>
                }
                else
                {
                    <div class="ka-empty">

                        <strong>
                            Sin información mensual
                        </strong>

                    </div>
                }

            </section>

        </div>
        <!-- =====================================================
             DETALLE CRONOLÓGICO - IMPORTE DIARIO
             ===================================================== -->

        <section class="ka-panel">

            <div class="ka-panel-head">

                <div>

                    <span class="ka-kicker">
                        DETALLE CRONOLÓGICO
                    </span>

                    <h2>
                        Importe diario · período completo
                    </h2>

                    <p>
                        Desplázate horizontalmente para revisar cada fecha.
                        Las barras rojas representan anomalías detectadas.
                    </p>

                </div>


                <span class="ka-badge">
                    @serie.Count DÍAS
                </span>

            </div>


            @if (serie.Count > 0)
            {
                <div class="ka-chart-pad">

                    <div class="ka-scroll">

                        <div class="ka-daily-track"
                             style="width:@Math.Max(760, serie.Count * 26)px">


                            @foreach (var dia in serie)
                            {
                                decimal altura =
                                    Math.Max(
                                        3M,
                                        dia.Intensidad
                                    );

                                bool anomalia =
                                    fechasAnomalias.Contains(
                                        dia.Fecha.Date
                                    );


                                <div class="ka-bar-item @(anomalia ? "anomaly" : "")">


                                    <!-- TOOLTIP -->

                                    <div class="ka-tooltip">

                                        <strong>
                                            @dia.Fecha.ToString("dd/MM/yyyy")
                                        </strong>

                                        <br />

                                        Importe:
                                        S/ @dia.Total.ToString("N2")

                                        <br />

                                        Operaciones:
                                        @dia.Operaciones

                                        @if (anomalia)
                                        {
                                            <br />

                                            <strong style="color:#ff7b8e;">
                                                ANOMALÍA DETECTADA
                                            </strong>
                                        }

                                    </div>


                                    <!-- BARRA -->

                                    <div class="ka-bar"
                                         style="height:@altura.ToString("0.##", CultureInfo.InvariantCulture)%">
                                    </div>


                                    <!-- FECHA -->

                                    <span class="ka-label">
                                        @dia.Fecha.ToString("dd/MM")
                                    </span>

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="ka-empty">

                    <div class="ka-empty-icon">

                        <span uk-icon="icon:database;ratio:1.2"></span>

                    </div>

                    <strong>
                        Sin datos para mostrar
                    </strong>

                    <p>
                        El período seleccionado no contiene
                        información suficiente para generar
                        el gráfico cronológico.
                    </p>

                </div>
            }

        </section>


        <!-- =====================================================
             OPERACIONES POR DÍA
             ===================================================== -->

        <section class="ka-panel">

            <div class="ka-panel-head">

                <div>

                    <span class="ka-kicker">
                        VOLUMEN COMERCIAL
                    </span>

                    <h2>
                        Operaciones por día
                    </h2>

                    <p>
                        Cantidad de ventas registradas por fecha,
                        separada del importe monetario.
                    </p>

                </div>


                <span class="ka-badge">
                    @serie.Count DÍAS
                </span>

            </div>


            @if (serie.Count > 0)
            {
                <div class="ka-chart-pad">

                    <div class="ka-scroll">

                        <div class="ka-daily-track ka-ops"
                             style="width:@Math.Max(760, serie.Count * 26)px">


                            @foreach (var dia in serie)
                            {
                                decimal altura =
                                    Math.Max(
                                        3M,
                                        ((decimal)dia.Operaciones / maxOps) * 100M
                                    );


                                <div class="ka-bar-item">


                                    <!-- TOOLTIP -->

                                    <div class="ka-tooltip">

                                        <strong>
                                            @dia.Fecha.ToString("dd/MM/yyyy")
                                        </strong>

                                        <br />

                                        Operaciones:
                                        @dia.Operaciones

                                        <br />

                                        Importe:
                                        S/ @dia.Total.ToString("N2")

                                    </div>


                                    <!-- BARRA -->

                                    <div class="ka-bar"
                                         style="height:@altura.ToString("0.##", CultureInfo.InvariantCulture)%">
                                    </div>


                                    <!-- FECHA -->

                                    <span class="ka-label">
                                        @dia.Fecha.ToString("dd/MM")
                                    </span>

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="ka-empty">

                    <div class="ka-empty-icon">

                        <span uk-icon="icon:cart;ratio:1.2"></span>

                    </div>

                    <strong>
                        Sin operaciones
                    </strong>

                    <p>
                        No existen operaciones comerciales
                        disponibles en el período seleccionado.
                    </p>

                </div>
            }

        </section>


        <!-- =====================================================
             METODOLOGÍA
             ===================================================== -->

        <section class="ka-panel">

            <div class="ka-panel-head">

                <div>

                    <span class="ka-kicker">
                        MOTOR ESTADÍSTICO
                    </span>

                    <h2>
                        Metodología de detección
                    </h2>

                    <p>
                        Cómo KerniX identifica comportamientos
                        comerciales fuera del patrón histórico.
                    </p>

                </div>


                <span class="ka-badge">
                    MODELO EXPLICABLE
                </span>

            </div>


            <div class="ka-methods">


                <!-- 01 -->

                <article class="ka-method">

                    <span class="ka-method-number">
                        01
                    </span>

                    <strong>
                        Historial
                    </strong>

                    <p>
                        Cada fecha se compara con los
                        28 días anteriores disponibles
                        para construir una referencia.
                    </p>

                </article>


                <!-- 02 -->

                <article class="ka-method">

                    <span class="ka-method-number">
                        02
                    </span>

                    <strong>
                        Mediana y MAD
                    </strong>

                    <p>
                        Se utiliza dispersión robusta para
                        reducir el impacto que pueden producir
                        valores extremos en la referencia.
                    </p>

                </article>


                <!-- 03 -->

                <article class="ka-method">

                    <span class="ka-method-number">
                        03
                    </span>

                    <strong>
                        Umbral
                    </strong>

                    <p>
                        La desviación debe superar los
                        criterios estadísticos configurados
                        antes de convertirse en una señal.
                    </p>

                </article>


                <!-- 04 -->

                <article class="ka-method">

                    <span class="ka-method-number">
                        04
                    </span>

                    <strong>
                        Revisión humana
                    </strong>

                    <p>
                        Una anomalía señala un comportamiento
                        que merece investigación. No confirma
                        automáticamente fraude ni error.
                    </p>

                </article>

            </div>

        </section>


        <!-- =====================================================
             RESULTADOS
             ===================================================== -->

        <section class="ka-panel"
                 id="resultados">

            <div class="ka-panel-head">

                <div>

                    <span class="ka-kicker">
                        RESULTADOS DEL MOTOR
                    </span>

                    <h2>
                        Anomalías que requieren revisión
                    </h2>

                    <p>
                        Señales estadísticas encontradas dentro
                        del período comercial analizado.
                    </p>

                </div>


                <span class="ka-badge">

                    @Model.Analisis.Anomalias.Count
                    RESULTADO(S)

                </span>

            </div>


            @if (Model.Analisis.Anomalias.Count > 0)
            {
                <div class="ka-table-wrap">

                    <table class="ka-table">

                        <thead>

                            <tr>

                                <th>
                                    FECHA
                                </th>

                                <th>
                                    SEÑAL
                                </th>

                                <th>
                                    VENTA OBSERVADA
                                </th>

                                <th>
                                    REFERENCIA HISTÓRICA
                                </th>

                                <th>
                                    DESVIACIÓN
                                </th>

                                <th>
                                    FIABILIDAD
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var a in Model.Analisis.Anomalias)
                            {
                                bool esAlza =
                                    a.Tipo.StartsWith(
                                        "Alza",
                                        StringComparison.OrdinalIgnoreCase
                                    );


                                <!-- FILA PRINCIPAL -->

                                <tr>

                                    <td class="ka-table-date">

                                        @a.Fecha.ToString("dd/MM/yyyy")

                                    </td>


                                    <td>

                                        <span class="ka-signal @(esAlza ? "up" : "down")">

                                            @if (esAlza)
                                            {
                                                <span>
                                                    ▲
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    ▼
                                                </span>
                                            }

                                            @a.Tipo

                                        </span>

                                    </td>


                                    <td class="ka-table-money">

                                        S/
                                        @a.TotalObservado.ToString("N2")

                                    </td>


                                    <td class="ka-table-reference">

                                        S/
                                        @a.MediaHistorica.ToString("N2")

                                    </td>


                                    <td>

                                        <span class="ka-z">

                                            @a.DesviacionesRobustas
                                            .ToString(
                                            "+0.00;-0.00;0.00"
                                            )

                                        </span>

                                    </td>


                                    <td>

                                        <span class="ka-confidence">

                                            @a.Certidumbre

                                        </span>

                                    </td>

                                </tr>


                                <!-- EXPLICACIÓN -->

                                <tr>

                                    <td colspan="6"
                                        class="ka-explanation">

                                        <strong style="color:#ffc62e;">
                                            ANÁLISIS:
                                        </strong>

                                        @a.Explicacion

                                        <span style="color:#4f7087;">
                                            ·
                                        </span>

                                        <strong style="color:#a9c2d2;">
                                            Actividad histórica:
                                        </strong>

                                        @a.DiasConActividad días

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="ka-empty">

                    <div class="ka-empty-icon">

                        <span uk-icon="icon:check;ratio:1.35"></span>

                    </div>


                    <strong>
                        Sin anomalías relevantes
                    </strong>


                    <p>

                        No se encontraron desviaciones que
                        superen los criterios estadísticos
                        actuales dentro del período analizado.

                    </p>

                </div>
            }

        </section>


        <!-- =====================================================
             INFORMACIÓN FINAL
             ===================================================== -->

