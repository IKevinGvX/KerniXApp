@page
@model KerniX.Pages.Configuracion.SeguridadModel

@{
    Layout = null;
    ViewData["Title"] = "Configuración de Seguridad";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - KerniX
    </title>

    <!-- UIKIT -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/css/uikit.min.css" />

    <style>

            :root {
                --kx-bg: #050d17;
                --kx-card: #0b1b2b;
                --kx-border: rgba(120, 160, 190, .18);
                --kx-gold: #e3b72f;
                --kx-gold-light: #f3cf65;
                --kx-blue: #3f9fe8;
                --kx-cyan: #58d4ff;
                --kx-text: #f4f7fb;
                --kx-muted: #8fa2b5;
                --kx-success: #4fd39a;
                --kx-danger: #ff6c6c;
                --kx-sidebar-width: 230px;
            }


            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }


            html,
            body {
                margin: 0;
                min-height: 100%;
                background: var(--kx-bg);
                color: var(--kx-text);
                font-family: "Segoe UI", Arial, sans-serif;
            }


            body {
                overflow-x: hidden;
            }


            a {
                text-decoration: none !important;
            }



            /* =========================================================
                       APP
                    ========================================================= */

            .kx-app {
                min-height: 100vh;
                display: grid;
                grid-template-columns: var(--kx-sidebar-width) minmax(0, 1fr);
                background: radial-gradient( circle at 90% 0%, rgba(63, 159, 232, .08), transparent 35% ), radial-gradient( circle at 35% 0%, rgba(227, 183, 47, .05), transparent 30% ), var(--kx-bg);
            }



            /* =========================================================
                       SIDEBAR
                    ========================================================= */

            .kx-sidebar {
                position: sticky;
                top: 0;
                height: 100vh;
                padding: 18px 14px;
                overflow-y: auto;
                border-right: 1px solid rgba(255, 255, 255, .06);
                background: linear-gradient( 180deg, #06101c, #071522 );
                z-index: 20;
            }


            .kx-logo {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 4px 6px 18px;
                border-bottom: 1px solid rgba(255, 255, 255, .07);
            }


            .kx-logo-icon {
                width: 38px;
                height: 38px;
                flex: 0 0 38px;
                display: grid;
                place-items: center;
                border-radius: 12px;
                color: #07111c;
                font-size: 12px;
                font-weight: 900;
                background: linear-gradient( 135deg, var(--kx-gold), var(--kx-gold-light) );
            }


            .kx-logo strong {
                display: block;
                color: white;
                font-size: 17px;
            }


            .kx-logo small {
                display: block;
                margin-top: 3px;
                color: #6f8397;
                font-size: 9px;
            }



            /* =========================================================
                       NAV
                    ========================================================= */

            .kx-nav {
                display: grid;
                gap: 7px;
                margin-top: 18px;
            }


                .kx-nav a {
                    min-height: 42px;
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    padding: 0 12px;
                    border-radius: 11px;
                    color: #aebccb;
                    font-size: 13px;
                    font-weight: 700;
                    transition: .2s ease;
                }


                    .kx-nav a:hover {
                        color: white;
                        background: rgba(255, 255, 255, .04);
                    }


                    .kx-nav a.active {
                        color: white;
                        border: 1px solid rgba(227, 183, 47, .65);
                        background: linear-gradient( 90deg, rgba(227, 183, 47, .12), rgba(63, 159, 232, .05) );
                    }


                        .kx-nav a.active [uk-icon] {
                            color: var(--kx-gold);
                        }



            /* =========================================================
                       MAIN
                    ========================================================= */

            .kx-main {
                min-width: 0;
                padding: 28px;
            }


            .kx-container {
                width: 100%;
                max-width: 1500px;
                margin: 0 auto;
            }



            /* =========================================================
                       HEADER
                    ========================================================= */

            .kx-header {
                position: relative;
                overflow: hidden;
                margin-bottom: 22px;
                padding: 26px 28px;
                border: 1px solid var(--kx-border);
                border-radius: 20px;
                background: linear-gradient( 135deg, rgba(227, 183, 47, .055), transparent 40% ), linear-gradient( 120deg, rgba(63, 159, 232, .08), transparent 65% ), rgba(8, 22, 36, .88);
            }


                .kx-header::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 100%;
                    height: 1px;
                    background: linear-gradient( 90deg, var(--kx-gold), rgba(227, 183, 47, .1), var(--kx-blue) );
                }


            .kx-back {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                color: #8fa4b8;
                font-size: 12px;
                font-weight: 700;
            }


                .kx-back:hover {
                    color: white;
                }


            .kx-header h1 {
                margin: 12px 0 5px;
                color: white;
                font-size: clamp( 27px, 3vw, 42px );
                font-weight: 800;
                letter-spacing: -.03em;
            }


            .kx-header p {
                margin: 0;
                color: var(--kx-muted);
                font-size: 14px;
            }


            .kx-header-badge {
                position: absolute;
                top: 24px;
                right: 24px;
                min-height: 36px;
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 0 13px;
                border: 1px solid rgba(88, 212, 255, .25);
                border-radius: 999px;
                background: rgba(88, 212, 255, .07);
                color: #c4f1ff;
                font-size: 11px;
                font-weight: 800;
            }



            /* =========================================================
                       ALERTAS
                    ========================================================= */

            .kx-alert {
                display: flex;
                align-items: flex-start;
                gap: 10px;
                margin-bottom: 18px;
                padding: 13px 15px;
                border-radius: 13px;
                font-size: 13px;
            }


                .kx-alert.success {
                    color: #baf4d9;
                    border: 1px solid rgba(79, 211, 154, .26);
                    background: rgba(79, 211, 154, .08);
                }


                .kx-alert.error {
                    color: #ffc3c3;
                    border: 1px solid rgba(255, 108, 108, .26);
                    background: rgba(255, 108, 108, .08);
                }



            /* =========================================================
                       GRID
                    ========================================================= */

            .kx-grid {
                display: grid;
                grid-template-columns: repeat( 2, minmax(0, 1fr) );
                gap: 20px;
            }



            /* =========================================================
                       CARD
                    ========================================================= */

            .kx-card {
                min-width: 0;
                overflow: hidden;
                border: 1px solid var(--kx-border);
                border-radius: 18px;
                background: linear-gradient( 135deg, rgba(255, 255, 255, .015), transparent 45% ), var(--kx-card);
            }


            .kx-card-header {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 20px 21px 15px;
                border-bottom: 1px solid rgba(255, 255, 255, .05);
            }


            .kx-card-icon {
                flex: 0 0 42px;
                width: 42px;
                height: 42px;
                display: grid;
                place-items: center;
                border-radius: 13px;
                color: var(--kx-gold);
                border: 1px solid rgba(227, 183, 47, .25);
                background: rgba(227, 183, 47, .06);
            }


            .kx-card-header h2 {
                margin: 0;
                color: white;
                font-size: 17px;
                font-weight: 800;
            }


            .kx-card-header p {
                margin: 3px 0 0;
                color: #7f93a6;
                font-size: 12px;
            }


            .kx-card-body {
                padding: 20px 21px 22px;
            }



            /* =========================================================
                       INPUTS
                    ========================================================= */

            .kx-field {
                min-width: 0;
                margin-bottom: 18px;
            }


                .kx-field label {
                    display: block;
                    margin-bottom: 7px;
                    color: #b9c6d3;
                    font-size: 12px;
                    font-weight: 700;
                }


            .kx-input {
                width: 100%;
                min-width: 0;
                height: 44px;
                padding: 0 13px;
                color: white;
                border: 1px solid rgba(132, 157, 180, .20);
                border-radius: 11px;
                outline: none;
                background: rgba(3, 12, 21, .72);
                font-size: 13px;
                transition: .2s ease;
            }


                .kx-input:focus {
                    border-color: rgba(227, 183, 47, .70);
                    box-shadow: 0 0 0 3px rgba(227, 183, 47, .08);
                }


            .kx-help {
                display: block;
                margin-top: 6px;
                color: #73879b;
                font-size: 11px;
                line-height: 1.45;
            }



            /* =========================================================
                       OPTION
                    ========================================================= */

            .kx-option {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                padding: 14px 15px;
                border: 1px solid rgba(255, 255, 255, .055);
                border-radius: 13px;
                background: rgba(255, 255, 255, .018);
            }


                .kx-option > div {
                    min-width: 0;
                    flex: 1;
                }


                .kx-option strong {
                    display: block;
                    color: white;
                    font-size: 13px;
                }


                .kx-option small {
                    display: block;
                    margin-top: 3px;
                    color: #7d90a3;
                    font-size: 11px;
                    line-height: 1.45;
                }



            /* =========================================================
                       SWITCH
                    ========================================================= */

            .kx-switch {
                position: relative;
                width: 44px;
                height: 24px;
                flex: 0 0 auto;
            }


                .kx-switch input[type="hidden"] {
                    display: none;
                }


                .kx-switch input[type="checkbox"] {
                    position: absolute;
                    width: 1px;
                    height: 1px;
                    opacity: 0;
                }


            .kx-slider {
                position: absolute;
                inset: 0;
                cursor: pointer;
                border: 1px solid rgba(132, 157, 180, .30);
                border-radius: 999px;
                background: #182737;
                transition: .2s ease;
            }


                .kx-slider::before {
                    content: "";
                    position: absolute;
                    top: 3px;
                    left: 3px;
                    width: 16px;
                    height: 16px;
                    border-radius: 50%;
                    background: #c4ced8;
                    transition: .2s ease;
                }


            .kx-switch
            input[type="checkbox"]:checked + .kx-slider {
                border-color: rgba(227, 183, 47, .65);
                background: rgba(227, 183, 47, .45);
            }


                .kx-switch
                input[type="checkbox"]:checked + .kx-slider::before {
                    transform: translateX(20px);
                    background: white;
                }



            /* =========================================================
                       SUMMARY
                    ========================================================= */

            .kx-summary {
                display: grid;
                gap: 0;
            }


            .kx-summary-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                padding: 13px 0;
                border-bottom: 1px solid rgba(255, 255, 255, .05);
            }


                .kx-summary-row:last-child {
                    border-bottom: none;
                }


                .kx-summary-row span {
                    color: #879bad;
                    font-size: 12px;
                }


                .kx-summary-row strong {
                    max-width: 60%;
                    color: white;
                    font-size: 13px;
                    text-align: right;
                    overflow-wrap: anywhere;
                }



            /* =========================================================
                       MINI STATS
                    ========================================================= */

            .kx-mini-grid {
                display: grid;
                grid-template-columns: repeat( 2, minmax(0, 1fr) );
                gap: 12px;
                margin-top: 16px;
            }


            .kx-mini {
                min-width: 0;
                padding: 14px;
                border: 1px solid rgba(255, 255, 255, .055);
                border-radius: 13px;
                background: rgba(255, 255, 255, .018);
            }


                .kx-mini span {
                    display: block;
                    color: #8195a8;
                    font-size: 10px;
                    font-weight: 800;
                    text-transform: uppercase;
                }


                .kx-mini strong {
                    display: block;
                    margin-top: 5px;
                    color: white;
                    font-size: 13px;
                }



            /* =========================================================
                       ACTIONS
                    ========================================================= */

            .kx-actions {
                display: flex;
                justify-content: flex-end;
                align-items: center;
                flex-wrap: wrap;
                gap: 10px;
                margin-top: 22px;
            }


            .kx-btn {
                min-height: 42px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 0 16px;
                border: 1px solid transparent;
                border-radius: 11px;
                font-size: 12px;
                font-weight: 800;
                cursor: pointer;
                transition: .2s ease;
            }


            .kx-btn-primary {
                color: #08111c;
                background: linear-gradient( 135deg, var(--kx-gold), var(--kx-gold-light) );
            }


                .kx-btn-primary:hover {
                    filter: brightness(1.06);
                    transform: translateY(-1px);
                }


            .kx-btn-secondary {
                color: #c7d2dd;
                border-color: rgba(132, 157, 180, .22);
                background: rgba(255, 255, 255, .025);
            }


                .kx-btn-secondary:hover {
                    color: white;
                    border-color: rgba(227, 183, 47, .35);
                }



            /* =========================================================
                       RESPONSIVE
                    ========================================================= */

            @@media (max-width: 1100px) {

                :root {
                    --kx-sidebar-width: 205px;
                }


                .kx-main {
                    padding: 22px;
                }
            }


            @@media (max-width: 900px) {

                .kx-grid {
                    grid-template-columns: 1fr;
                }
            }


            @@media (max-width: 760px) {

                .kx-app {
                    display: block;
                }


                .kx-sidebar {
                    position: relative;
                    height: auto;
                    border-right: none;
                    border-bottom: 1px solid rgba(255, 255, 255, .06);
                }


                .kx-nav {
                    display: flex;
                    overflow-x: auto;
                    gap: 7px;
                }


                    .kx-nav a {
                        flex: 0 0 auto;
                        white-space: nowrap;
                    }


                .kx-main {
                    padding: 14px;
                }


                .kx-header {
                    padding: 20px 18px;
                }


                .kx-header-badge {
                    position: static;
                    width: fit-content;
                    margin-top: 14px;
                }


                .kx-actions {
                    flex-direction: column-reverse;
                    align-items: stretch;
                }


                .kx-btn {
                    width: 100%;
                }
            }


            @@media (max-width: 480px) {

                .kx-main {
                    padding: 10px;
                }


                .kx-header,
                .kx-card {
                    border-radius: 14px;
                }


                .kx-card-header {
                    padding: 16px 15px 13px;
                }


                .kx-card-body {
                    padding: 16px 15px 18px;
                }


                .kx-option {
                    align-items: flex-start;
                }


                .kx-summary-row {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 4px;
                }


                    .kx-summary-row strong {
                        max-width: 100%;
                        text-align: left;
                    }


                .kx-mini-grid {
                    grid-template-columns: 1fr;
                }
            }

    </style>

</head>


<body>


    <div class="kx-app">


        <!-- ====================================================== -->
        <!-- SIDEBAR -->
        <!-- ====================================================== -->

        <aside class="kx-sidebar">


            <div class="kx-logo">

                <div class="kx-logo-icon">
                    KX
                </div>


                <div>

                    <strong>
                        KerniX
                    </strong>

                    <small>
                        Sistema Inteligente
                    </small>

                </div>

            </div>



            <nav class="kx-nav">


                <a href="/Inicio/Index">

                    <span uk-icon="icon: home; ratio: .85">
                    </span>

                    Inicio

                </a>


                <a href="/Ventas/Index">

                    <span uk-icon="icon: cart; ratio: .85">
                    </span>

                    Ventas

                </a>


                <a href="/Inventario/Index">

                    <span uk-icon="icon: database; ratio: .85">
                    </span>

                    Inventario

                </a>


                <a href="/Productos/Index">

                    <span uk-icon="icon: grid; ratio: .85">
                    </span>

                    Productos

                </a>


                <a href="/Clientes/Index">

                    <span uk-icon="icon: users; ratio: .85">
                    </span>

                    Clientes

                </a>


                <a href="/IA/Index">

                    <span uk-icon="icon: bolt; ratio: .85">
                    </span>

                    KerniX IA

                </a>


                <a href="/Configuracion/Index1"
                   class="active">

                    <span uk-icon="icon: settings; ratio: .85">
                    </span>

                    Configuración

                </a>


            </nav>


        </aside>



        <!-- ====================================================== -->
        <!-- MAIN -->
        <!-- ====================================================== -->

        <main class="kx-main">


            <div class="kx-container">


                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <header class="kx-header">


                    <a href="/Configuracion/Index1"
                       class="kx-back">

                        <span uk-icon="icon: arrow-left; ratio: .8">
                        </span>

                        Volver a configuración

                    </a>


                    <h1>
                        Configuración de Seguridad
                    </h1>


                    <p>
                        Define políticas de acceso,
                        sesión y contraseñas para proteger KerniX.
                    </p>


                    <div class="kx-header-badge">

                        <span uk-icon="icon: lock; ratio: .75">
                        </span>

                        Seguridad

                    </div>


                </header>



                <!-- ================================================= -->
                <!-- MENSAJES -->
                <!-- ================================================= -->
                @if (!string.IsNullOrWhiteSpace(
                                Model.MensajeExito))
                {

                    <div class="kx-alert success">

                        <span uk-icon="icon: check">
                        </span>

                        <span>
                            @Model.MensajeExito
                        </span>

                    </div>

                }


                @if (!string.IsNullOrWhiteSpace(
                    Model.MensajeError))
                {

                    <div class="kx-alert error">

                        <span uk-icon="icon: warning">
                        </span>

                        <span>
                            @Model.MensajeError
                        </span>

                    </div>

                }


                @if (!ViewData.ModelState.IsValid)
                {

                    <div class="kx-alert error">

                        <span uk-icon="icon: warning">
                        </span>

                        <div asp-validation-summary="All">
                        </div>

                    </div>

                }



                <!-- ================================================= -->
                <!-- FORM -->
                <!-- ================================================= -->

                <form method="post"
                      action="/Configuracion/Seguridad?handler=Guardar">


                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="IdEmpresa"
                           value="@Model.IdEmpresa" />



                    <div class="kx-grid">


                        <!-- ============================================= -->
                        <!-- ACCESO -->
                        <!-- ============================================= -->

                        <section class="kx-card">


                            <div class="kx-card-header">


                                <div class="kx-card-icon">

                                    <span uk-icon="icon: lock">
                                    </span>

                                </div>


                                <div>

                                    <h2>
                                        Protección de acceso
                                    </h2>

                                    <p>
                                        Control de intentos y bloqueos.
                                    </p>

                                </div>


                            </div>



                            <div class="kx-card-body">


                                <div class="kx-field">


                                    <label>
                                        Intentos máximos de acceso
                                    </label>


                                    <input type="number"
                                           name="IntentosLoginMaximos"
                                           value="@(Model.IntentosLoginMaximos ?? 5)"
                                           min="1"
                                           max="20"
                                           step="1"
                                           class="kx-input" />


                                    <small class="kx-help">

                                        Cantidad de intentos fallidos
                                        antes de bloquear la cuenta.

                                    </small>


                                </div>



                                <div class="kx-field">


                                    <label>
                                        Minutos de bloqueo
                                    </label>


                                    <input type="number"
                                           name="MinutosBloqueo"
                                           value="@(Model.MinutosBloqueo ?? 15)"
                                           min="1"
                                           max="1440"
                                           step="1"
                                           class="kx-input" />


                                    <small class="kx-help">

                                        Tiempo durante el cual
                                        permanecerá bloqueado el usuario.

                                    </small>


                                </div>



                                <div class="kx-mini-grid">


                                    <div class="kx-mini">

                                        <span>
                                            Intentos
                                        </span>

                                        <strong>
                                            @(Model.IntentosLoginMaximos ?? 5)
                                        </strong>

                                    </div>


                                    <div class="kx-mini">

                                        <span>
                                            Bloqueo
                                        </span>

                                        <strong>
                                            @(Model.MinutosBloqueo ?? 15) min
                                        </strong>

                                    </div>


                                </div>


                            </div>


                        </section>



                        <!-- ============================================= -->
                        <!-- SESIÓN -->
                        <!-- ============================================= -->

                        <section class="kx-card">


                            <div class="kx-card-header">


                                <div class="kx-card-icon">

                                    <span uk-icon="icon: clock">
                                    </span>

                                </div>


                                <div>

                                    <h2>
                                        Sesión
                                    </h2>

                                    <p>
                                        Duración y expiración de sesiones.
                                    </p>

                                </div>


                            </div>



                            <div class="kx-card-body">


                                <div class="kx-field">


                                    <label>
                                        Expiración de sesión
                                    </label>


                                    <input type="number"
                                           name="MinutosExpiracionSesion"
                                           value="@(Model.MinutosExpiracionSesion ?? 30)"
                                           min="5"
                                           max="1440"
                                           step="1"
                                           class="kx-input" />


                                    <small class="kx-help">

                                        Minutos de vigencia
                                        antes de finalizar la sesión.

                                    </small>


                                </div>



                                <div class="kx-summary">


                                    <div class="kx-summary-row">

                                        <span>
                                            Valor actual
                                        </span>

                                        <strong>
                                            @(Model.MinutosExpiracionSesion ?? 30)
                                            minutos
                                        </strong>

                                    </div>


                                    <div class="kx-summary-row">

                                        <span>
                                            Política
                                        </span>

                                        <strong>
                                            Expiración automática
                                        </strong>

                                    </div>


                                </div>


                            </div>


                        </section>



                        <!-- ============================================= -->
                        <!-- PASSWORD -->
                        <!-- ============================================= -->

                        <section class="kx-card">


                            <div class="kx-card-header">


                                <div class="kx-card-icon">

                                    <span uk-icon="icon: key">
                                    </span>

                                </div>


                                <div>

                                    <h2>
                                        Política de contraseña
                                    </h2>

                                    <p>
                                        Requisitos generales de seguridad.
                                    </p>

                                </div>


                            </div>



                            <div class="kx-card-body">


                                <div class="kx-field">


                                    <label>
                                        Longitud mínima
                                    </label>


                                    <input type="number"
                                           name="LongitudMinimaPassword"
                                           value="@(Model.LongitudMinimaPassword ?? 8)"
                                           min="6"
                                           max="128"
                                           step="1"
                                           class="kx-input" />


                                    <small class="kx-help">

                                        Número mínimo de caracteres
                                        requeridos para una contraseña.

                                    </small>


                                </div>



                                <div class="kx-field">


                                    <label>
                                        Días de vigencia
                                    </label>


                                    <input type="number"
                                           name="DiasVigenciaPassword"
                                           value="@(Model.DiasVigenciaPassword ?? 90)"
                                           min="0"
                                           max="3650"
                                           step="1"
                                           class="kx-input" />


                                    <small class="kx-help">

                                        Use 0 si no desea
                                        establecer vencimiento.

                                    </small>


                                </div>



                                <div class="kx-option">


                                    <div>

                                        <strong>
                                            Requerir cambio de contraseña
                                        </strong>

                                        <small>

                                            Solicita al usuario actualizar
                                            su contraseña según la política.

                                        </small>

                                    </div>



                                    <label class="kx-switch">


                                        <input type="hidden"
                                               name="RequerirCambioPassword"
                                               value="false" />


                                        <input type="checkbox"
                                               name="RequerirCambioPassword"
                                               value="true"
                                               checked="@Model.RequerirCambioPassword" />


                                        <span class="kx-slider">
                                        </span>


                                    </label>


                                </div>


                            </div>


                        </section>



                        <!-- ============================================= -->
                        <!-- RESUMEN -->
                        <!-- ============================================= -->

                        <section class="kx-card">


                            <div class="kx-card-header">


                                <div class="kx-card-icon">

                                    <span uk-icon="icon: shield">
                                    </span>

                                </div>


                                <div>

                                    <h2>
                                        Estado actual
                                    </h2>

                                    <p>
                                        Resumen de las políticas configuradas.
                                    </p>

                                </div>


                            </div>



                            <div class="kx-card-body">


                                <div class="kx-summary">


                                    <div class="kx-summary-row">

                                        <span>
                                            Empresa
                                        </span>

                                        <strong>
                                            #@Model.IdEmpresa
                                        </strong>

                                    </div>



                                    <div class="kx-summary-row">

                                        <span>
                                            Intentos máximos
                                        </span>

                                        <strong>
                                            @(Model.IntentosLoginMaximos ?? 5)
                                        </strong>

                                    </div>



                                    <div class="kx-summary-row">

                                        <span>
                                            Bloqueo
                                        </span>

                                        <strong>
                                            @(Model.MinutosBloqueo ?? 15) min
                                        </strong>

                                    </div>



                                    <div class="kx-summary-row">

                                        <span>
                                            Sesión
                                        </span>

                                        <strong>
                                            @(Model.MinutosExpiracionSesion ?? 30) min
                                        </strong>

                                    </div>



                                    <div class="kx-summary-row">

                                        <span>
                                            Longitud contraseña
                                        </span>

                                        <strong>
                                            @(Model.LongitudMinimaPassword ?? 8)
                                        </strong>

                                    </div>



                                    <div class="kx-summary-row">

                                        <span>
                                            Vigencia contraseña
                                        </span>

                                        <strong>
                                            @(Model.DiasVigenciaPassword ?? 90) días
                                        </strong>

                                    </div>



                                    <div class="kx-summary-row">

                                        <span>
                                            Cambio obligatorio
                                        </span>

                                        <strong>

                                            @(Model.RequerirCambioPassword
                                                ? "Activado"
                                                : "Desactivado")

                                        </strong>

                                    </div>


                                </div>


                            </div>


                        </section>


                    </div>



                    <!-- ================================================= -->
                    <!-- BOTONES -->
                    <!-- ================================================= -->

                    <div class="kx-actions">


                        <a href="/Configuracion/Index1"
                           class="kx-btn kx-btn-secondary">

                            <span uk-icon="icon: arrow-left; ratio: .8">
                            </span>

                            Cancelar

                        </a>



                        <button type="submit"
                                class="kx-btn kx-btn-primary">

                            <span uk-icon="icon: check; ratio: .85">
                            </span>

                            Guardar configuración

                        </button>


                    </div>


                </form>


            </div>


        </main>


    </div>



    <!-- UIKIT JS -->

    <script src="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/js/uikit.min.js">
    </script>

    <script src="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/js/uikit-icons.min.js">
    </script>


</body>

</html>