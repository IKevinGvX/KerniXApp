                        <strong>
                            Filtros
                        </strong>

                    </div>


                    <!-- FECHAS -->

                    <div class="kx-filter-control date-filter">

                        <label>
                            Rango de fechas
                        </label>


                        <div class="kx-date-pair">

                            <input type="date"
                                   name="FechaDesde"
                                   value="@Model.FechaDesde?.ToString("yyyy-MM-dd")" />

                            <span>
                                -
                            </span>

                            <input type="date"
                                   name="FechaHasta"
                                   value="@Model.FechaHasta?.ToString("yyyy-MM-dd")" />

                        </div>

                    </div>


                    <!-- CLIENTE -->

                    <div class="kx-filter-control">

                        <label>
                            Cliente
                        </label>

                        <select name="IdCliente">

                            <option value="">
                                Todos los clientes
                            </option>

                            @foreach (var cliente in clientes)
                            {
                                if (Model.IdCliente == cliente.IdCliente)
                                {
                                    <option value="@cliente.IdCliente"
                                            selected>

                                        @cliente.Cliente

                                    </option>
                                }
                                else
                                {
                                    <option value="@cliente.IdCliente">

                                        @cliente.Cliente

                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- ESTADO -->

                    <div class="kx-filter-control">

                        <label>
                            Estado
                        </label>

                        <select name="Estado">

                            <option value="">
                                Todos los estados
                            </option>


                            @{
                                string[] estadosDisponibles =
                                {
                                "Pendiente",
                                "Aprobada",
                                "Convertida",
                                "Rechazada"
                            };
                            }


                            @foreach (var estado in estadosDisponibles)
                            {
                                if (
                                    string.Equals(
                                        Model.Estado,
                                        estado,
                                        StringComparison.OrdinalIgnoreCase
                                    )
                                )
                                {
                                    <option value="@estado"
                                            selected>
                                        @estado
                                    </option>
                                }
                                else
                                {
                                    <option value="@estado">
                                        @estado
                                    </option>
                                }
                            }

                        </select>

