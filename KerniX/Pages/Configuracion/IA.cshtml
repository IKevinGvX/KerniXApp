@page
@model KerniX.Pages.Configuracion.IAModel

@{
    Layout = null;
    ViewData["Title"] = "Configuración de IA";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - KerniX
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/css/uikit.min.css" />

    <link rel="stylesheet"
          href="~/css/configuracion.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/general.css"
          asp-append-version="true" />

</head>


<body class="kx-body">

    <div class="kx-app">

        <!-- ===================================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================================== -->

        <aside class="kx-sidebar">

            <div class="kx-logo">

                <div class="kx-logo-icon">
                    KX
                </div>

                <div>

                    <strong>
                        KerniX
                    </strong>

                    <small>
                        Sistema Inteligente
                    </small>

                </div>

            </div>


            <nav class="kx-nav">

                <a href="/Inicio/Index">

                    <span uk-icon="icon: home"></span>

                    <span>
                        Inicio
                    </span>

                </a>


                <a href="/Ventas/Index">

                    <span uk-icon="icon: cart"></span>

                    <span>
                        Ventas
                    </span>

                </a>


                <a href="/Inventario/Index">

                    <span uk-icon="icon: database"></span>

                    <span>
                        Inventario
                    </span>

                </a>


                <a href="/Productos/Index">

                    <span uk-icon="icon: thumbnails"></span>

                    <span>
                        Productos
                    </span>

                </a>


                <a href="/Clientes/Index">

                    <span uk-icon="icon: users"></span>

                    <span>
                        Clientes
                    </span>

                </a>


                <a href="/IA/Index">

                    <span uk-icon="icon: bolt"></span>

                    <span>
                        KerniX IA
                    </span>

                </a>


                <a href="/Configuracion/Index1"
                   class="active">

                    <span uk-icon="icon: settings"></span>

                    <span>
                        Configuración
                    </span>

                </a>

            </nav>

        </aside>


        <!-- ===================================================== -->
        <!-- CONTENIDO -->
        <!-- ===================================================== -->

        <main class="kx-content">

            <!-- ================================================= -->
            <!-- CABECERA -->
            <!-- ================================================= -->

            <header class="kx-topbar">

                <div>

                    <a href="/Configuracion/Index1"
                       class="kx-back">

                        <span uk-icon="icon: arrow-left"></span>

                        Volver a configuración

                    </a>


                    <h1>
                        Configuración de KerniX IA
                    </h1>


                    <p>
                        Activa o desactiva las funciones inteligentes
                        disponibles en ventas e inventario.
                    </p>

                </div>

            </header>


            <!-- ================================================= -->
            <!-- MENSAJE EXITO -->
            <!-- ================================================= -->
            @if (!string.IsNullOrWhiteSpace(
                        Model.MensajeExito))
            {
                <div class="kx-alert-success">

                    <span uk-icon="icon: check"></span>

                    <span>
                        @Model.MensajeExito
                    </span>

                </div>
            }


            <!-- ================================================= -->
            <!-- MENSAJE ERROR -->
            <!-- ================================================= -->
            @if (!string.IsNullOrWhiteSpace(
                        Model.MensajeError))
            {
                <div class="kx-alert-error">

                    <span uk-icon="icon: warning"></span>

                    <span>
                        @Model.MensajeError
                    </span>

                </div>
            }


            <!-- ================================================= -->
            <!-- VALIDACIONES -->
            <!-- ================================================= -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="kx-alert-error">

                    <span uk-icon="icon: warning"></span>

                    <div asp-validation-summary="All">
                    </div>

                </div>
            }


            <!-- ================================================= -->
            <!-- FORMULARIO -->
            <!-- ================================================= -->

            <form method="post"
                  action="/Configuracion/IA?handler=Guardar">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="IdEmpresa"
                       value="@Model.IdEmpresa" />


                <div class="kx-settings-layout">


                    <!-- ========================================= -->
                    <!-- MOTOR IA -->
                    <!-- ========================================= -->

                    <section class="kx-card">

                        <div class="kx-card-header">

                            <div class="kx-card-icon">

                                <span uk-icon="icon: bolt">
                                </span>

                            </div>

                            <div>

                                <h2>
                                    Motor de Inteligencia Artificial
                                </h2>

                                <p>
                                    Control general de funciones inteligentes.
                                </p>

                            </div>

                        </div>


                        <div class="kx-option">

                            <div>

                                <strong>
                                    Activar KerniX IA
                                </strong>

                                <small>
                                    Habilita el uso de funciones
                                    inteligentes dentro del sistema.
                                </small>

                            </div>


                            <div>

                                <label class="kx-switch">

                                    <input type="checkbox"
                                           name="IaActiva"
                                           value="true"
                                           checked="@Model.IaActiva" />

                                    <span class="kx-slider"></span>

                                </label>


                                <input type="hidden"
                                       name="IaActiva"
                                       value="false" />

                            </div>

                        </div>


                        <div class="kx-summary-row">

                            <span>
                                Estado actual
                            </span>

                            <strong>

                                @(Model.IaActiva
                                    ? "ACTIVA"
                                    : "DESACTIVADA")

                            </strong>

                        </div>

                    </section>


                    <!-- ========================================= -->
                    <!-- PRONOSTICO -->
                    <!-- ========================================= -->

                    <section class="kx-card">

                        <div class="kx-card-header">

                            <div class="kx-card-icon">

                                <span uk-icon="icon: future">
                                </span>

                            </div>

                            <div>

                                <h2>
                                    Pronóstico de ventas
                                </h2>

                                <p>
                                    Analiza historial para estimar
                                    ventas futuras.
                                </p>

                            </div>

                        </div>


                        <div class="kx-option">

                            <div>

                                <strong>
                                    Habilitar pronóstico
                                </strong>

                                <small>
                                    Permite calcular tendencias
                                    y comportamiento esperado de ventas.
                                </small>

                            </div>


                            <div>

                                <label class="kx-switch">

                                    <input type="checkbox"
                                           name="IaPronosticoVentas"
                                           value="true"
                                           checked="@Model.IaPronosticoVentas" />

                                    <span class="kx-slider"></span>

                                </label>


                                <input type="hidden"
                                       name="IaPronosticoVentas"
                                       value="false" />

                            </div>

                        </div>


                        <div class="kx-form-group">

                            <label>
                                Días de historial
                            </label>

                            <input type="number"
                                   name="DiasHistoricoPronostico"
                                   value="@(Model.DiasHistoricoPronostico ?? 90)"
                                   min="7"
                                   max="3650"
                                   step="1"
                                   class="kx-input" />


                            <small class="kx-help">
                                Cantidad de días históricos utilizados
                                para analizar el comportamiento de ventas.
                            </small>

                        </div>

                    </section>


                    <!-- ========================================= -->
                    <!-- REPOSICION -->
                    <!-- ========================================= -->

                    <section class="kx-card">

                        <div class="kx-card-header">

                            <div class="kx-card-icon">

                                <span uk-icon="icon: refresh">
                                </span>

                            </div>

                            <div>

                                <h2>
                                    Reposición inteligente
                                </h2>

                                <p>
                                    Recomendaciones automáticas de reposición.
                                </p>

                            </div>

                        </div>


                        <div class="kx-option">

                            <div>

                                <strong>
                                    Recomendar reposición
                                </strong>

                                <small>
                                    Analiza stock mínimo,
                                    disponibilidad y rotación
                                    para sugerir compras.
                                </small>

                            </div>


                            <div>

                                <label class="kx-switch">

                                    <input type="checkbox"
                                           name="IaRecomendacionReposicion"
                                           value="true"
                                           checked="@Model.IaRecomendacionReposicion" />

                                    <span class="kx-slider"></span>

                                </label>


                                <input type="hidden"
                                       name="IaRecomendacionReposicion"
                                       value="false" />

                            </div>

                        </div>

                    </section>


                    <!-- ========================================= -->
                    <!-- ANOMALIAS -->
                    <!-- ========================================= -->

                    <section class="kx-card">

                        <div class="kx-card-header">

                            <div class="kx-card-icon">

                                <span uk-icon="icon: warning">
                                </span>

                            </div>

                            <div>

                                <h2>
                                    Detección de anomalías
                                </h2>

                                <p>
                                    Identificación de comportamientos inusuales.
                                </p>

                            </div>

                        </div>


                        <div class="kx-option">

                            <div>

                                <strong>
                                    Detectar anomalías
                                </strong>

                                <small>
                                    Busca patrones atípicos
                                    en ventas y movimientos de inventario.
                                </small>

                            </div>


                            <div>

                                <label class="kx-switch">

                                    <input type="checkbox"
                                           name="IaAlertasAnomalias"
                                           value="true"
                                           checked="@Model.IaAlertasAnomalias" />

                                    <span class="kx-slider"></span>

                                </label>


                                <input type="hidden"
                                       name="IaAlertasAnomalias"
                                       value="false" />

                            </div>

                        </div>

                    </section>


                    <!-- ========================================= -->
                    <!-- ESTADO -->
                    <!-- ========================================= -->

                    <section class="kx-card">

                        <div class="kx-card-header">

                            <div class="kx-card-icon">

                                <span uk-icon="icon: info">
                                </span>

                            </div>

                            <div>

                                <h2>
                                    Estado actual
                                </h2>

                                <p>
                                    Resumen de configuración inteligente.
                                </p>

                            </div>

                        </div>


                        <div class="kx-summary-row">

                            <span>
                                Empresa
                            </span>

                            <strong>
                                #@Model.IdEmpresa
                            </strong>

                        </div>


                        <div class="kx-summary-row">

                            <span>
                                KerniX IA
                            </span>

                            <strong>

                                @(Model.IaActiva
                                    ? "Activa"
                                    : "Desactivada")

                            </strong>

                        </div>


                        <div class="kx-summary-row">

                            <span>
                                Pronóstico
                            </span>

                            <strong>

                                @(Model.IaPronosticoVentas
                                    ? "Activo"
                                    : "Desactivado")

                            </strong>

                        </div>


                        <div class="kx-summary-row">

                            <span>
                                Reposición
                            </span>

                            <strong>

                                @(Model.IaRecomendacionReposicion
                                    ? "Activa"
                                    : "Desactivada")

                            </strong>

                        </div>


                        <div class="kx-summary-row">

                            <span>
                                Anomalías
                            </span>

                            <strong>

                                @(Model.IaAlertasAnomalias
                                    ? "Activa"
                                    : "Desactivada")

                            </strong>

                        </div>


                        <div class="kx-summary-row">

                            <span>
                                Historial
                            </span>

                            <strong>
                                @(Model.DiasHistoricoPronostico ?? 90) días
                            </strong>

                        </div>

                    </section>

                </div>


                <!-- ================================================= -->
                <!-- BOTONES -->
                <!-- ================================================= -->

                <div class="kx-form-actions">

                    <a href="/Configuracion/Index1"
                       class="kx-btn-secondary">

                        Cancelar

                    </a>


                    <a href="/IA/Index"
                       class="kx-btn-secondary">

                        Abrir asistente

                    </a>


                    <button type="submit"
                            class="kx-btn-primary">

                        <span uk-icon="icon: check"></span>

                        Guardar configuración

                    </button>

                </div>

            </form>

        </main>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/js/uikit.min.js">
    </script>

    <script src="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/js/uikit-icons.min.js">
    </script>

</body>

</html>