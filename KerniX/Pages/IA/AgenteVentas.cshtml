@page "/IA/AgenteVentas"
@model KerniX.Pages.IA.AgenteVentasModel
@{
    ViewData["Title"] = "Agente Comercial | KerniX IA";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/uikit@3.21.16/dist/css/uikit.min.css" />
<link rel="stylesheet" href="~/css/IA/kernix-ia.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/IA/agente-catalogo.css" asp-append-version="true" />

<div class="kx-ai-page kac-page" id="kacApp">
    <main class="kai-wrap">
        <nav class="kai-breadcrumb" aria-label="Ruta de navegación">
            <a href="/Inicio/Index">Inicio</a><span>/</span>
            <a href="/IA/Index">Centro IA</a><span>/</span><b>Agente comercial</b>
        </nav>

        <header class="kai-hero kai-hero-compact kac-hero">
            <div class="kai-hero-copy">
                <div class="kai-eyebrow"><span class="kai-dot"></span> KERNIX IA · AGENTE COMERCIAL · FASE 5</div>
                <h1>Agente <em>inteligente</em> y cotizaciones asistidas</h1>
                <p>Habla con la IA, selecciona productos reales y valida precios, importes y disponibilidad en SQL Server para generar un borrador comercial supervisado.</p>
                <div class="kai-actions">
                    <a href="/IA/Index" class="kai-btn"><span uk-icon="arrow-left"></span> Centro IA</a>
                    <a href="/Inventario/Productos" class="kai-btn kai-btn-blue"><span uk-icon="database"></span> Ver productos</a>
                    <a href="/Inicio/Index" class="kai-btn"><span uk-icon="home"></span> Inicio</a>
                </div>
            </div>
            <div class="kai-hero-symbol kai-hero-symbol-gold" aria-hidden="true"><span uk-icon="icon: commenting; ratio: 3"></span></div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
        {
            <div class="kai-alert" role="alert">@Model.MensajeError</div>
        }
        <div class="kai-info">
            <span uk-icon="info"></span>
            <div>
                <strong>Chat unificado · Ollama y catálogo SQL verificado</strong>
                <p>El chat busca productos de tu empresa. El botón «Validar borrador en SQL» relee los precios y las existencias desde el servidor antes de permitir copiar una propuesta. El borrador no es una cotización registrada ni reserva stock.</p>
            </div>
        </div>

        <div class="kac-layout">
            <div class="kac-left">
                <section class="kai-panel kac-livechat" aria-labelledby="kacAiTitle">
                    <div class="kai-panel-head">
                        <div>
                            <span class="kai-kicker">MOTOR CONVERSACIONAL · OLLAMA</span>
                            <h2 id="kacAiTitle">Habla con KerniX IA</h2>
                            <p>Ollama llama3.2 para conversaciones y clasificación; SQL Server para resultados comerciales verificables.</p>
                        </div>
                        <span class="kai-status kai-status-pending">IA local</span>
                    </div>
                    <div class="kac-chat-body kac-ai-messages" id="kacAiMessages" role="log" aria-live="polite" aria-label="Conversación con la IA">
                        <div class="kac-bubble kac-assistant">¡Hola! Soy KerniX IA. Pídeme «Dame una lista de tus productos» o «Quiero 5 laptops». Buscaré datos reales de tu empresa y te permitiré preparar una propuesta para revisión. No registraré ventas ni cotizaciones oficiales.</div>
                    </div>
                    <div class="kac-suggestions" aria-label="Ejemplos de solicitudes">
                        <button type="button" data-kac-prompt="Dame una lista de tus productos de venta">Ver catálogo</button>
                        <button type="button" data-kac-prompt="Quiero comprar 5 laptops, ¿tienes disponibles?">Buscar laptops</button>
                        <button type="button" data-kac-prompt="Cotízame 5 laptops disponibles">Cotizar 5 laptops</button>
                    </div>
                    <form class="kac-search-form" id="kacAiForm" method="post" action="/IA/AgenteVentas?handler=Conversar">
                        @Html.AntiForgeryToken()
                        <label for="kacAiPrompt">Escribe a la inteligencia artificial</label>
                        <div class="kac-search-row">
                            <input type="text" id="kacAiPrompt" name="mensaje" minlength="2" maxlength="1500" autocomplete="off" placeholder="Ej.: ¿Qué necesito para preparar una cotización?" required disabled="@(Model.Contexto is null)" />
                            <button type="submit" id="kacAiEnviar" class="kai-btn kai-btn-gold" disabled="@(Model.Contexto is null)"><span uk-icon="icon: bolt"></span> Enviar a IA</button>
                        </div>
                        <p class="kac-helper" id="kacAiEstado" role="status">Las consultas son de solo lectura. No compartas contraseñas ni información bancaria. El chat aún no conserva memoria de turnos anteriores.</p>
                    </form>
                </section>

                <section class="kai-panel kac-chat" aria-labelledby="kacTitle">
                    <div class="kai-panel-head">
                        <div><span class="kai-kicker">ATENCIÓN COMERCIAL</span><h2 id="kacTitle">Búsqueda manual alternativa</h2><p>También puedes escribir un nombre o código sin usar el chat.</p></div>
                        <span class="kai-status kai-status-pending">Solo lectura</span>
                    </div>
                    <div class="kac-chat-body" id="kacMessages" role="log" aria-live="polite" aria-label="Mensajes de búsqueda">
                        <div class="kac-bubble kac-assistant">Hola. Puedo consultar el catálogo de KerniX. Escribe un nombre o código de producto, por ejemplo: «cable», «laptop» o «PROD-001».</div>
                    </div>
                    <form id="kacSearchForm" class="kac-search-form" method="post" action="/IA/AgenteVentas?handler=Buscar">
                        @Html.AntiForgeryToken()
                        <label for="kacConsulta">Buscar en el catálogo</label>
                        <div class="kac-search-row">
                            <input id="kacConsulta" name="consulta" maxlength="120" minlength="2" autocomplete="off" placeholder="¿Qué producto necesita el cliente?" required disabled="@(Model.Contexto is null)" />
                            <button id="kacSearchButton" type="submit" class="kai-btn kai-btn-gold" disabled="@(Model.Contexto is null)">
                                <span uk-icon="search"></span> Buscar
                            </button>
                        </div>
                        <p class="kac-helper">Búsqueda en tiempo real al solicitarla. Máximo 18 coincidencias.</p>
                    </form>
                </section>
            </div>

            <aside class="kai-panel kac-summary" aria-labelledby="kacSummaryTitle">
                <div class="kai-panel-head">
                    <div><span class="kai-kicker">REVISIÓN HUMANA</span><h2 id="kacSummaryTitle">Borrador de cotización</h2><p>Precios revalidados en SQL antes de copiar.</p></div>
                </div>
                <div class="kac-customer">
                    <label for="kacCliente">Cliente / referencia</label>
                    <input type="text" id="kacCliente" maxlength="100" placeholder="Nombre del cliente (opcional)" />
                    <label for="kacNotas">Requisitos o condiciones</label>
                    <textarea id="kacNotas" maxlength="450" rows="2" placeholder="Entrega, especificaciones, consultas..."></textarea>
                </div>
                <div id="kacCart" class="kac-cart" aria-live="polite"><p class="kac-empty">No hay productos añadidos.</p></div>
                <div class="kac-subtotal">
                    <span>Importe referencial (sin desglose fiscal)</span>
                    <strong id="kacTotal">—</strong>
                </div>
                <p class="kac-disclaimer" id="kacPriceDisclaimer">El precio_venta consultado puede incluir o excluir impuestos según tu configuración empresarial. Este borrador no calcula IGV ni aplica descuentos y no reserva inventario.</p>
                <div class="kac-review" id="kacRevision" role="status" aria-live="polite">Añade productos y presiona «Validar borrador en SQL». Los precios del navegador no se consideran definitivos.</div>
                <div class="kac-summary-actions">
                    <button type="button" id="kacValidar" class="kai-btn kai-btn-blue" disabled><span uk-icon="check"></span> Validar borrador en SQL</button>
                    <button type="button" id="kacCopy" class="kai-btn kai-btn-gold" disabled><span uk-icon="copy"></span> Copiar borrador validado</button>
                    <button type="button" id="kacClear" class="kai-btn" disabled><span uk-icon="trash"></span> Limpiar</button>
                </div>
                <p id="kacCopyStatus" class="kac-feedback" role="status"></p>
            </aside>
        </div>

        <section class="kai-panel kac-results" aria-labelledby="kacResultsTitle">
            <div class="kai-panel-head">
                <div><span class="kai-kicker">CATÁLOGO VERIFICADO</span><h2 id="kacResultsTitle">Resultados de productos</h2><p>Cargados desde el chat inteligente o el buscador manual.</p></div>
                <span id="kacResultCount" class="kai-status kai-status-pending">0 resultados</span>
            </div>
            <div id="kacResultList" class="kac-result-list">
                <div class="kac-empty kac-empty-full">Pídele al agente que consulte productos, o utiliza el buscador manual.</div>
            </div>
        </section>

        <section class="kai-panel kac-next" aria-labelledby="kacNextTitle">
            <div class="kai-panel-head"><div><span class="kai-kicker">AUTOMATIZACIÓN CONTROLADA</span><h2 id="kacNextTitle">Siguiente integración</h2></div></div>
            <div class="kac-flow">
                <div><span uk-icon="database"></span><strong>1. Catálogo</strong><small>Lectura SQL real · Integrada en chat</small></div>
                <div><span uk-icon="bolt"></span><strong>2. Modelo IA</strong><small>Interpreta intención · Integrado</small></div>
                <div><span uk-icon="file-text"></span><strong>3. Cotización</strong><small>Borrador verificado en SQL · Fase 5</small></div>
                <div><span uk-icon="shield"></span><strong>4. Venta</strong><small>Permisos y pago verificado · Pendiente</small></div>
            </div>
        </section>
        <footer class="kai-footer">KerniX ERP · Agente Comercial Fase 5 · Ollama + catálogo y borrador revalidado · Sin escrituras</footer>
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/uikit@3.21.16/dist/js/uikit.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/uikit@3.21.16/dist/js/uikit-icons.min.js"></script>
<script src="~/js/IA/agente-catalogo.js" asp-append-version="true"></script>
<script src="~/js/IA/agente-ollama.js" asp-append-version="true"></script>
