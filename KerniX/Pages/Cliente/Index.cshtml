                                   type="email"
                                   maxlength="250" />

                        </div>

                        <!-- CONTACTOS ADICIONALES -->

                        <div class="kx-subtitle">
                            Contactos adicionales
                        </div>

                        <div class="kx-field full">

                            <div id="listaContactos"></div>

                            <button type="button"
                                    id="agregarContacto"
                                    class="kx-btn kx-btn-blue">

                                <span uk-icon="plus"></span>
                                Agregar contacto

                            </button>

                        </div>

                        <!-- DIRECCIONES -->

                        <div class="kx-subtitle">
                            Direcciones
                        </div>

                        <div class="kx-field full">

                            <div id="listaDirecciones"></div>

                            <button type="button"
                                    id="agregarDireccion"
                                    class="kx-btn kx-btn-blue">

                                <span uk-icon="plus"></span>
                                Agregar dirección

