@page
@model KerniX.Pages.Configuracion.MonedasModel

@{
    Layout = null;
    ViewData["Title"] = "Monedas";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - KerniX
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/css/uikit.min.css" />

    <link rel="stylesheet"
          href="~/css/configuracion.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/general.css"
          asp-append-version="true" />

    <style>

            .kx-monedas-page {
                min-height: 100vh;
                background: radial-gradient( circle at top right, rgba(0, 120, 255, .08), transparent 30% ), radial-gradient( circle at bottom left, rgba(212, 175, 55, .06), transparent 35% ), #07101f;
            }

                .kx-monedas-page .kx-card {
                    background: linear-gradient( 145deg, rgba(12, 24, 43, .98), rgba(6, 14, 27, .98) );
                    border: 1px solid rgba(255, 255, 255, .07);
                    box-shadow: 0 18px 45px rgba(0, 0, 0, .26);
                }

                .kx-monedas-page .kx-card-header h2,
                .kx-monedas-page .kx-modal-title h2,
                .kx-monedas-page h1 {
                    color: #f7f9fc;
                }

                .kx-monedas-page p,
                .kx-monedas-page small,
                .kx-monedas-page label {
                    color: #9eabc0;
                }

                .kx-monedas-page .kx-summary-row {
                    border-bottom: 1px solid rgba(255, 255, 255, .06);
                }

                    .kx-monedas-page .kx-summary-row span {
                        color: #9ca9bc;
                    }

                    .kx-monedas-page .kx-summary-row strong {
                        color: #f0c75e;
                    }

                .kx-monedas-page .kx-input {
                    background: #091426;
                    border: 1px solid rgba(255, 255, 255, .10);
                    color: #f8fafc;
                }

                    .kx-monedas-page .kx-input:focus {
                        border-color: #2d9cff;
                        box-shadow: 0 0 0 3px rgba(45, 156, 255, .10);
                        outline: none;
                    }

                    .kx-monedas-page .kx-input::placeholder {
                        color: #65748c;
                    }

                .kx-monedas-page .kx-table {
                    background: transparent;
                }

                    .kx-monedas-page .kx-table thead {
                        background: rgba(255, 255, 255, .035);
                    }

                    .kx-monedas-page .kx-table th {
                        color: #9ca9bc;
                        border-bottom: 1px solid rgba(255, 255, 255, .08);
                    }

                    .kx-monedas-page .kx-table td {
                        color: #e8edf5;
                        border-bottom: 1px solid rgba(255, 255, 255, .055);
                    }

                    .kx-monedas-page .kx-table tbody tr:hover {
                        background: rgba(45, 156, 255, .035);
                    }

                .kx-monedas-page .kx-modal {
                    background: linear-gradient( 145deg, #0c182b, #07101e );
                    border: 1px solid rgba(255, 255, 255, .08);
                    border-radius: 18px;
                    color: #f5f7fa;
                    box-shadow: 0 30px 90px rgba(0, 0, 0, .55);
                    padding: 28px;
                }

                .kx-monedas-page .uk-modal {
                    background: rgba(1, 6, 15, .78);
                    backdrop-filter: blur(7px);
                }

                .kx-monedas-page .uk-close {
                    color: #ffffff;
                }

                .kx-monedas-page .kx-status.active {
                    color: #6ee7a8;
                }

                .kx-monedas-page .kx-status.inactive {
                    color: #ff8383;
                }

                .kx-monedas-page .kx-empty {
                    color: #8290a6;
                    text-align: center;
                    padding: 30px;
                }

                .kx-monedas-page .kx-form-actions {
                    display: flex;
                    gap: 12px;
                    align-items: center;
                    flex-wrap: wrap;
                }

                .kx-monedas-page .kx-inline-actions {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    flex-wrap: wrap;
                }

                    .kx-monedas-page .kx-inline-actions form {
                        margin: 0;
                    }

                .kx-monedas-page .kx-btn-danger {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 8px;
                    min-height: 40px;
                    padding: 0 16px;
                    border-radius: 10px;
                    border: 1px solid rgba(255, 92, 92, .32);
                    background: rgba(255, 75, 75, .09);
                    color: #ff9090;
                    cursor: pointer;
                    font: inherit;
                }

                    .kx-monedas-page .kx-btn-danger:hover {
                        background: rgba(255, 75, 75, .16);
                        color: #ffc1c1;
                    }

    </style>

</head>

<body class="kx-body kx-monedas-page">

    <div class="kx-app">

        <!-- ===================================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================================== -->

        <aside class="kx-sidebar">

            <div class="kx-logo">

                <div class="kx-logo-icon">
                    KX
                </div>

                <div>

                    <strong>
                        KerniX
                    </strong>

                    <small>
                        Sistema Inteligente
                    </small>

                </div>

            </div>

            <nav class="kx-nav">

                <a href="/Inicio/Index">

                    <span uk-icon="icon: home"></span>

                    <span>
                        Inicio
                    </span>

                </a>

                <a href="/Ventas/Index">

                    <span uk-icon="icon: cart"></span>

                    <span>
                        Ventas
                    </span>

                </a>

                <a href="/Inventario/Index">

                    <span uk-icon="icon: database"></span>

                    <span>
                        Inventario
                    </span>

                </a>

                <a href="/Productos/Index">

                    <span uk-icon="icon: thumbnails"></span>

                    <span>
                        Productos
                    </span>

                </a>

                <a href="/Clientes/Index">

                    <span uk-icon="icon: users"></span>

                    <span>
                        Clientes
                    </span>

                </a>

                <a href="/IA/Index">

                    <span uk-icon="icon: bolt"></span>

                    <span>
                        KerniX IA
                    </span>

                </a>

                <a href="/Configuracion/Index1"
                   class="active">

                    <span uk-icon="icon: settings"></span>

                    <span>
                        Configuración
                    </span>

                </a>

            </nav>

        </aside>


        <!-- ===================================================== -->
        <!-- MAIN -->
        <!-- ===================================================== -->

        <main class="kx-content">

            <!-- ================================================= -->
            <!-- CABECERA -->
            <!-- ================================================= -->

            <header class="kx-topbar">

                <div>

                    <a href="/Configuracion/Index1"
                       class="kx-back">

                        <span uk-icon="icon: arrow-left"></span>

                        Volver a configuración

                    </a>

                    <h1>
                        Monedas
                    </h1>

                    <p>
                        Administra códigos, nombres,
                        símbolos y precisión monetaria.
                    </p>

                </div>

            </header>


            <!-- ================================================= -->
            <!-- MENSAJES -->
            <!-- ================================================= -->
            @if (!string.IsNullOrWhiteSpace(
                        Model.MensajeExito))
            {
                <div class="kx-alert-success">

                    <span uk-icon="icon: check"></span>

                    <span>
                        @Model.MensajeExito
                    </span>

                </div>
            }

            @if (!string.IsNullOrWhiteSpace(
                Model.MensajeError))
            {
                <div class="kx-alert-error">

                    <span uk-icon="icon: warning"></span>

                    <span>
                        @Model.MensajeError
                    </span>

                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="kx-alert-error">

                    <span uk-icon="icon: warning"></span>

                    <div asp-validation-summary="All">
                    </div>

                </div>
            }


            <!-- ================================================= -->
            <!-- RESUMEN Y CREAR -->
            <!-- ================================================= -->

            <div class="kx-settings-layout">

                <!-- ============================================= -->
                <!-- RESUMEN -->
                <!-- ============================================= -->

                <section class="kx-card">

                    <div class="kx-card-header">

                        <div class="kx-card-icon">

                            <span uk-icon="icon: credit-card">
                            </span>

                        </div>

                        <div>

                            <h2>
                                Resumen
                            </h2>

                            <p>
                                Estado de las monedas configuradas.
                            </p>

                        </div>

                    </div>


                    <div class="kx-summary-row">

                        <span>
                            Total registradas
                        </span>

                        <strong>
                            @Model.Monedas.Count
                        </strong>

                    </div>


                    <div class="kx-summary-row">

                        <span>
                            Activas
                        </span>

                        <strong>
                            @Model.Monedas.Count(x => x.Estado)
                        </strong>

                    </div>


                    <div class="kx-summary-row">

                        <span>
                            Inactivas
                        </span>

                        <strong>
                            @Model.Monedas.Count(x => !x.Estado)
                        </strong>

                    </div>

                </section>


                <!-- ============================================= -->
                <!-- NUEVA MONEDA -->
                <!-- ============================================= -->

                <section class="kx-card">

                    <div class="kx-card-header">

                        <div class="kx-card-icon">

                            <span uk-icon="icon: plus">
                            </span>

                        </div>

                        <div>

                            <h2>
                                Nueva moneda
                            </h2>

                            <p>
                                Agrega una moneda al sistema.
                            </p>

                        </div>

                    </div>


                    <form method="post"
                          action="/Configuracion/Monedas?handler=Crear">

                        @Html.AntiForgeryToken()


                        <div class="kx-form-group">

                            <label>
                                Código
                            </label>

                            <input type="text"
                                   name="NuevoCodigo"
                                   maxlength="10"
                                   placeholder="PEN"
                                   class="kx-input"
                                   required />

                        </div>


                        <div class="kx-form-group">

                            <label>
                                Nombre
                            </label>

                            <input type="text"
                                   name="NuevoNombre"
                                   maxlength="150"
                                   placeholder="Sol peruano"
                                   class="kx-input"
                                   required />

                        </div>


                        <div class="kx-form-group">

                            <label>
                                Símbolo
                            </label>

                            <input type="text"
                                   name="NuevoSimbolo"
                                   maxlength="10"
                                   placeholder="S/"
                                   class="kx-input" />

                        </div>


                        <div class="kx-form-group">

                            <label>
                                Decimales
                            </label>

                            <input type="number"
                                   name="NuevosDecimales"
                                   value="2"
                                   min="0"
                                   max="6"
                                   step="1"
                                   class="kx-input"
                                   required />

                        </div>


                        <div class="kx-option">

                            <div>

                                <strong>
                                    Estado
                                </strong>

                                <small>
                                    Activa para operaciones comerciales.
                                </small>

                            </div>


                            <div>

                                <label class="kx-switch">

                                    <input type="checkbox"
                                           name="NuevoEstado"
                                           value="true"
                                           checked />

                                    <span class="kx-slider"></span>

                                </label>

                                <input type="hidden"
                                       name="NuevoEstado"
                                       value="false" />

                            </div>

                        </div>


                        <div class="kx-form-actions">

                            <button type="submit"
                                    class="kx-btn-primary">

                                <span uk-icon="icon: plus"></span>

                                Crear moneda

                            </button>

                        </div>

                    </form>

                </section>

            </div>


            <!-- ================================================= -->
            <!-- LISTADO -->
            <!-- ================================================= -->

            <section class="kx-card"
                     style="margin-top: 22px;">

                <div class="kx-card-header">

                    <div class="kx-card-icon">

                        <span uk-icon="icon: list">
                        </span>

                    </div>

                    <div>

                        <h2>
                            Monedas configuradas
                        </h2>

                        <p>
                            Monedas disponibles actualmente.
                        </p>

                    </div>

                </div>


                <div class="kx-table-wrap">

                    <table class="kx-table">

                        <thead>

                            <tr>

                                <th>
                                    Código
                                </th>

                                <th>
                                    Nombre
                                </th>

                                <th>
                                    Símbolo
                                </th>

                                <th>
                                    Decimales
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th>
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @if (Model.Monedas.Count == 0)
                            {
                                <tr>

                                    <td colspan="6"
                                        class="kx-empty">

                                        No existen monedas configuradas.

                                    </td>

                                </tr>
                            }
                            else
                            {
                                @foreach (var moneda in Model.Monedas)
                                {
                                    string modalEditar =
                                        $"modal-moneda-{moneda.IdMoneda}";

                                    <tr>

                                        <td>

                                            <strong>
                                                @moneda.Codigo
                                            </strong>

                                        </td>


                                        <td>
                                            @moneda.Nombre
                                        </td>


                                        <td>

                                            @(string.IsNullOrWhiteSpace(
                                                moneda.Simbolo)
                                                ? "-"
                                                : moneda.Simbolo)

                                        </td>


                                        <td>
                                            @moneda.CantidadDecimales
                                        </td>


                                        <td>

                                            @if (moneda.Estado)
                                            {
                                                <span class="kx-status active">
                                                    Activa
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="kx-status inactive">
                                                    Inactiva
                                                </span>
                                            }

                                        </td>


                                        <td>

                                            <div class="kx-inline-actions">

                                                <button type="button"
                                                        class="kx-btn-secondary"
                                                        uk-toggle="target: #@modalEditar">

                                                    <span uk-icon="icon: pencil"></span>

                                                    Editar

                                                </button>


                                                <form method="post"
                                                      action="/Configuracion/Monedas?handler=CambiarEstado">

                                                    @Html.AntiForgeryToken()


                                                    <input type="hidden"
                                                           name="IdMonedaEstado"
                                                           value="@moneda.IdMoneda" />


                                                    <input type="hidden"
                                                           name="NuevoEstadoMoneda"
                                                           value="@(!moneda.Estado)" />


                                                    @if (moneda.Estado)
                                                    {
                                                        <button type="submit"
                                                                class="kx-btn-danger"
                                                                onclick="return confirm('¿Desea desactivar esta moneda?');">

                                                            Desactivar

                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit"
                                                                class="kx-btn-primary">

                                                            Activar

                                                        </button>
                                                    }

                                                </form>

                                            </div>

                                        </td>

                                    </tr>


                                    <!-- ================================= -->
                                    <!-- MODAL EDITAR -->
                                    <!-- ================================= -->

                                    <div id="@modalEditar"
                                         class="uk-flex-top"
                                         uk-modal>

                                        <div class="uk-modal-dialog uk-margin-auto-vertical kx-modal">

                                            <button type="button"
                                                    class="uk-modal-close-default"
                                                    uk-close>
                                            </button>


                                            <div class="kx-modal-title">

                                                <span>
                                                    CONFIGURACIÓN DE MONEDA
                                                </span>

                                                <h2>
                                                    Editar @moneda.Codigo
                                                </h2>

                                                <p>
                                                    Actualiza código,
                                                    nombre, símbolo y precisión.
                                                </p>

                                            </div>


                                            <form method="post"
                                                  action="/Configuracion/Monedas?handler=Editar">

                                                @Html.AntiForgeryToken()


                                                <input type="hidden"
                                                       name="IdMonedaEditar"
                                                       value="@moneda.IdMoneda" />


                                                <div class="kx-form-group">

                                                    <label>
                                                        Código
                                                    </label>

                                                    <input type="text"
                                                           name="CodigoEditar"
                                                           value="@moneda.Codigo"
                                                           maxlength="10"
                                                           class="kx-input"
                                                           required />

                                                </div>


                                                <div class="kx-form-group">

                                                    <label>
                                                        Nombre
                                                    </label>

                                                    <input type="text"
                                                           name="NombreEditar"
                                                           value="@moneda.Nombre"
                                                           maxlength="150"
                                                           class="kx-input"
                                                           required />

                                                </div>


                                                <div class="kx-form-group">

                                                    <label>
                                                        Símbolo
                                                    </label>

                                                    <input type="text"
                                                           name="SimboloEditar"
                                                           value="@moneda.Simbolo"
                                                           maxlength="10"
                                                           class="kx-input" />

                                                </div>


                                                <div class="kx-form-group">

                                                    <label>
                                                        Decimales
                                                    </label>

                                                    <input type="number"
                                                           name="DecimalesEditar"
                                                           value="@moneda.CantidadDecimales"
                                                           min="0"
                                                           max="6"
                                                           step="1"
                                                           class="kx-input"
                                                           required />

                                                </div>


                                                <input type="hidden"
                                                       name="EstadoEditar"
                                                       value="@moneda.Estado.ToString().ToLowerInvariant()" />


                                                <div class="kx-form-actions">

                                                    <button type="button"
                                                            class="kx-btn-secondary uk-modal-close">

                                                        Cancelar

                                                    </button>


                                                    <button type="submit"
                                                            class="kx-btn-primary">

                                                        <span uk-icon="icon: check"></span>

                                                        Guardar cambios

                                                    </button>

                                                </div>

                                            </form>

                                        </div>

                                    </div>
                                }
                            }

                        </tbody>

                    </table>

                </div>

            </section>


            <!-- ================================================= -->
            <!-- VOLVER -->
            <!-- ================================================= -->

            <div class="kx-form-actions"
                 style="margin-top: 22px;">

                <a href="/Configuracion/Index1"
                   class="kx-btn-secondary">

                    <span uk-icon="icon: arrow-left"></span>

                    Volver a configuración

                </a>

            </div>

        </main>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/js/uikit.min.js">
    </script>

    <script src="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/js/uikit-icons.min.js">
    </script>

</body>

</html>