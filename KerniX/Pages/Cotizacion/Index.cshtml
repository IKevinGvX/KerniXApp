            <!-- IA SIDEBAR -->

            <div class="kx-ai-sidebar">

                <div class="kx-ai-sidebar-top">

                    <div>

                        <h3>
                            KerniX IA
                        </h3>

                        <p>
                            Tu asistente inteligente para impulsar
                            tus ventas y tomar mejores decisiones.
                        </p>

