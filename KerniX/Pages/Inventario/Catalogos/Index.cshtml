@page
@model KerniX.Pages.Inventario.Catalogos.IndexModel

@{
    ViewData["Title"] = "Catálogos de Inventario";
}

<style>
    .kx-cat-page {
        --bg: #020b17;
        --panel: #06182b;
        --panel2: #082039;
        --gold: #ffb800;
        --gold2: #ffdc69;
        --blue: #149cff;
        --cyan: #50d2ff;
        --green: #36e69a;
        --red: #ff607b;
        --text: #f5f9ff;
        --muted: #95b5d0;
        --border: rgba(62,135,207,.28);
        min-height: 100vh;
        padding: 26px;
        color: var(--text);
        background: radial-gradient(circle at 92% 0%,rgba(20,156,255,.12),transparent 30%), radial-gradient(circle at 5% 0%,rgba(255,184,0,.07),transparent 25%), linear-gradient(145deg,#020b17,#031426);
        font-size: 16px;
    }

        .kx-cat-page *,
        .kx-cat-page *::before,
        .kx-cat-page *::after {
            box-sizing: border-box;
        }

    .kx-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        margin-bottom: 20px;
    }

    .kx-breadcrumb {
        color: var(--muted);
        font-size: 13px;
        margin-bottom: 5px;
    }

        .kx-breadcrumb a {
            color: var(--cyan);
            text-decoration: none;
        }

    .kx-title {
        margin: 0;
        color: #fff;
        font-size: 34px;
        font-weight: 900;
    }

    .kx-subtitle {
        margin: 6px 0 0;
        color: var(--muted);
        font-size: 15px;
    }

    .kx-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }

    .kx-btn {
        min-height: 45px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 0 15px;
        border-radius: 11px;
        border: 1px solid var(--border);
        font-size: 14px;
        font-weight: 850;
        cursor: pointer;
        text-decoration: none !important;
    }

    .kx-btn-dark {
        color: #eaf5ff !important;
        background: #071c31;
    }

    .kx-btn-gold {
        color: #211600 !important;
        border-color: #ffe17a;
        background: linear-gradient(180deg,#ffdc69,#efa800);
    }

    .kx-btn-blue {
        color: #e8f8ff !important;
        border-color: rgba(80,210,255,.46);
        background: linear-gradient(180deg,rgba(20,156,255,.20),rgba(6,35,63,.96));
    }

    .kx-btn-red {
        color: #ff9aad !important;
        border-color: rgba(255,96,123,.42);
        background: rgba(255,96,123,.07);
    }

    .kx-btn-green {
        color: #78efb3 !important;
        border-color: rgba(54,230,154,.40);
        background: rgba(54,230,154,.07);
    }

    .kx-message {
        margin-bottom: 16px;
        padding: 14px 17px;
        border-radius: 12px;
        font-size: 14px;
    }

        .kx-message.ok {
            color: #a6f3cd;
            border: 1px solid rgba(54,230,154,.35);
            background: rgba(54,230,154,.07);
        }

        .kx-message.error {
            color: #ffc3ce;
            border: 1px solid rgba(255,96,123,.37);
            background: rgba(255,96,123,.07);
        }

    .kx-summary {
        display: grid;
        grid-template-columns: repeat(6,minmax(0,1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .kx-card {
        border: 1px solid var(--border);
        border-radius: 16px;
        background: linear-gradient(145deg,rgba(7,29,52,.98),rgba(4,18,34,.98));
        box-shadow: 0 14px 32px rgba(0,0,0,.20);
    }

    .kx-kpi {
        padding: 16px;
    }

        .kx-kpi span {
            display: block;
            color: #86a7c5;
            font-size: 12px;
        }

        .kx-kpi strong {
            display: block;
            margin-top: 6px;
            color: #fff;
            font-size: 26px;
            font-weight: 900;
        }

        .kx-kpi.gold {
            border-color: rgba(255,184,0,.34);
        }

            .kx-kpi.gold strong {
                color: var(--gold2);
            }

        .kx-kpi.green strong {
            color: #75efb1;
        }

    .kx-grid {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 18px;
    }

    .kx-panel {
        padding: 18px;
    }

    .kx-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 14px;
    }

        .kx-panel-head h2 {
            margin: 0;
            color: #fff;
            font-size: 21px;
            font-weight: 900;
        }

        .kx-panel-head p {
            margin: 4px 0 0;
            color: var(--muted);
            font-size: 12px;
        }

    .kx-filter {
        display: grid;
        grid-template-columns: 1fr 150px auto;
        gap: 8px;
        margin-bottom: 14px;
    }

    .kx-control {
        width: 100%;
        min-height: 43px;
        padding: 0 12px;
        border-radius: 10px;
        border: 1px solid rgba(67,137,205,.34);
        outline: none;
        color: #fff !important;
        background: #05182b !important;
        font-size: 14px;
    }

        .kx-control option {
            background: #06182b;
            color: #fff;
        }

    .kx-table-wrap {
        overflow: auto;
    }

    .kx-table {
        width: 100%;
        min-width: 660px;
        border-collapse: collapse;
    }

        .kx-table th {
            padding: 10px 8px;
            text-align: left;
            color: #6ebcff;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .4px;
            border-bottom: 1px solid rgba(65,133,201,.24);
        }

        .kx-table td {
            padding: 11px 8px;
            color: #edf6ff;
            font-size: 12px;
            vertical-align: middle;
            border-bottom: 1px solid rgba(52,108,162,.14);
        }

    .kx-name {
        color: #fff;
        font-size: 13px;
        font-weight: 850;
    }

    .kx-desc {
        margin-top: 3px;
        max-width: 240px;
        color: #82a4c3;
        font-size: 10px;
        white-space: normal;
    }

    .kx-pill {
        display: inline-flex;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 900;
    }

        .kx-pill.active {
            color: #75efb1;
            border: 1px solid rgba(54,230,154,.35);
            background: rgba(54,230,154,.07);
        }

        .kx-pill.inactive {
            color: #ff91a5;
            border: 1px solid rgba(255,96,123,.35);
            background: rgba(255,96,123,.07);
        }

    .kx-row-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .kx-mini {
        min-height: 33px;
        padding: 0 10px;
        border-radius: 8px;
        font-size: 11px;
    }

    .kx-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(0,5,12,.78);
        backdrop-filter: blur(4px);
    }

        .kx-modal-backdrop.open {
            display: flex;
        }

    .kx-modal {
        width: min(620px,100%);
        max-height: 90vh;
        overflow: auto;
        padding: 22px;
        border: 1px solid rgba(255,184,0,.35);
        border-radius: 18px;
        background: linear-gradient(145deg,#071d34,#041321);
        box-shadow: 0 30px 90px rgba(0,0,0,.55);
    }

        .kx-modal h3 {
            margin: 0 0 4px;
            color: #fff;
            font-size: 23px;
            font-weight: 900;
        }

        .kx-modal p {
            margin: 0 0 17px;
            color: var(--muted);
            font-size: 13px;
        }

    .kx-field {
        margin-bottom: 14px;
    }

        .kx-field label {
            display: block;
            margin-bottom: 7px;
            color: #eaf5ff;
            font-size: 13px;
            font-weight: 850;
        }

    .kx-input,
    .kx-textarea {
        width: 100%;
        min-height: 48px;
        padding: 0 13px;
        border-radius: 10px;
        border: 1px solid rgba(65,136,205,.36);
        outline: none;
        color: #fff !important;
        background: #04182b !important;
        font-size: 15px;
    }

    .kx-textarea {
        min-height: 100px;
        padding-top: 12px;
        resize: vertical;
    }

    .kx-check {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #eaf5ff;
        font-size: 13px;
    }

        .kx-check input {
            width: 18px;
            height: 18px;
            accent-color: #f4b20b;
        }

    .kx-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 18px;
    }

    @@media(max-width:1100px) {
        .kx-grid {
            grid-template-columns: 1fr;
        }

        .kx-summary {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media(max-width:700px) {
        .kx-cat-page {
            padding: 14px;
        }

        .kx-header {
            flex-direction: column;
        }

        .kx-summary,
        .kx-filter {
            grid-template-columns: 1fr;
        }

        .kx-title {
            font-size: 29px;
        }
    }

    /* =========================================================
               KERNIX 3D / PREMIUM OVERRIDES
               Mantiene toda la lógica actual: crear/editar en modales.
               ========================================================= */

    .kx-cat-page {
        position: relative;
        overflow-x: hidden;
        background: radial-gradient(circle at 12% 12%, rgba(255,184,0,.08), transparent 22%), radial-gradient(circle at 86% 8%, rgba(20,156,255,.15), transparent 28%), radial-gradient(circle at 50% 100%, rgba(80,210,255,.05), transparent 34%), linear-gradient(145deg,#020813 0%,#03101f 48%,#04172b 100%);
    }

        .kx-cat-page::before,
        .kx-cat-page::after {
            content: "";
            position: fixed;
            pointer-events: none;
            z-index: 0;
            border-radius: 50%;
            filter: blur(2px);
            opacity: .38;
        }

        .kx-cat-page::before {
            width: 360px;
            height: 360px;
            top: -160px;
            right: -90px;
            background: radial-gradient(circle,rgba(20,156,255,.28),transparent 67%);
        }

        .kx-cat-page::after {
            width: 320px;
            height: 320px;
            left: -120px;
            bottom: -160px;
            background: radial-gradient(circle,rgba(255,184,0,.19),transparent 68%);
        }

        .kx-cat-page > * {
            position: relative;
            z-index: 1;
        }

    .kx-header {
        padding: 18px 20px;
        border: 1px solid rgba(73,145,215,.19);
        border-radius: 18px;
        background: linear-gradient(145deg,rgba(8,32,57,.78),rgba(3,18,34,.72));
        box-shadow: 0 18px 50px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.025);
        backdrop-filter: blur(10px);
    }

    .kx-title {
        letter-spacing: -.5px;
        text-shadow: 0 0 24px rgba(20,156,255,.10), 0 4px 12px rgba(0,0,0,.38);
    }

    .kx-btn {
        position: relative;
        overflow: hidden;
        transform: translateZ(0);
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease, filter .18s ease;
    }

        .kx-btn::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient(120deg,transparent 15%,rgba(255,255,255,.13) 48%,transparent 80%);
            transform: translateX(-130%);
            transition: transform .42s ease;
        }

        .kx-btn:hover::before {
            transform: translateX(130%);
        }

        .kx-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.05);
        }

    .kx-btn-gold:hover {
        box-shadow: 0 10px 28px rgba(255,184,0,.22), 0 0 0 1px rgba(255,220,105,.08);
    }

    .kx-btn-blue:hover {
        box-shadow: 0 10px 28px rgba(20,156,255,.18), 0 0 0 1px rgba(80,210,255,.08);
    }

    .kx-summary {
        perspective: 1100px;
    }

    .kx-kpi {
        position: relative;
        overflow: hidden;
        min-height: 104px;
        transform-style: preserve-3d;
        transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
    }

        .kx-kpi::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            right: -46px;
            top: -58px;
            border-radius: 50%;
            background: radial-gradient(circle,rgba(80,210,255,.12),transparent 68%);
        }

        .kx-kpi.gold::after {
            background: radial-gradient(circle,rgba(255,184,0,.16),transparent 68%);
        }

        .kx-kpi:hover {
            transform: translateY(-5px) rotateX(2deg) rotateY(-1deg);
            border-color: rgba(80,210,255,.42);
            box-shadow: 0 24px 45px rgba(0,0,0,.28), inset 0 1px 0 rgba(255,255,255,.025);
        }

    .kx-grid {
        perspective: 1300px;
    }

    .kx-panel {
        position: relative;
        overflow: hidden;
        transform-style: preserve-3d;
        box-shadow: 0 22px 56px rgba(0,0,0,.23), inset 0 1px 0 rgba(255,255,255,.025);
    }

        .kx-panel::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 2px;
            background: linear-gradient(90deg,transparent,rgba(80,210,255,.72),rgba(255,184,0,.70),transparent);
            opacity: .62;
        }

        .kx-panel:nth-child(2)::before {
            background: linear-gradient(90deg,transparent,rgba(20,156,255,.78),rgba(80,210,255,.82),transparent);
        }

    .kx-panel-head {
        padding: 2px 2px 10px;
        border-bottom: 1px solid rgba(72,143,211,.11);
    }

    .kx-table {
        border-collapse: separate;
        border-spacing: 0 7px;
    }

        .kx-table th {
            border-bottom: 0;
            padding-bottom: 7px;
        }

        .kx-table tbody tr {
            background: linear-gradient(90deg,rgba(7,29,52,.74),rgba(4,20,37,.55));
            transition: transform .16s ease, background .16s ease, box-shadow .16s ease;
        }

            .kx-table tbody tr:hover {
                transform: translateY(-2px);
                background: linear-gradient(90deg,rgba(10,40,70,.96),rgba(5,27,49,.86));
                box-shadow: 0 9px 24px rgba(0,0,0,.16);
            }

        .kx-table td {
            border-bottom: 0;
        }

            .kx-table td:first-child {
                border-radius: 10px 0 0 10px;
            }

            .kx-table td:last-child {
                border-radius: 0 10px 10px 0;
            }

    .kx-name {
        font-size: 14px;
        letter-spacing: .1px;
    }

    .kx-pill {
        box-shadow: inset 0 1px 0 rgba(255,255,255,.04);
    }

    .kx-mini {
        min-height: 35px;
        font-weight: 900;
    }

    /* MODAL 3D */
    .kx-modal-backdrop {
        perspective: 1400px;
        background: radial-gradient(circle at 50% 34%,rgba(20,156,255,.12),transparent 35%), rgba(0,4,11,.84);
        backdrop-filter: blur(10px);
    }

        .kx-modal-backdrop.open .kx-modal {
            animation: kxModalEntrada .28s ease both;
        }

    @@keyframes kxModalEntrada {
        from {
            opacity: 0;
            transform: translateY(24px) rotateX(8deg) scale(.965);
        }

        to {
            opacity: 1;
            transform: translateY(0) rotateX(0deg) scale(1);
        }
    }

    .kx-modal {
        position: relative;
        width: min(760px,100%);
        padding: 26px;
        overflow: hidden auto;
        transform-style: preserve-3d;
        border: 1px solid rgba(255,184,0,.46);
        border-radius: 22px;
        background: radial-gradient(circle at 92% 0%,rgba(20,156,255,.15),transparent 30%), linear-gradient(145deg,#08213b 0%,#05182b 52%,#03101d 100%);
        box-shadow: 0 40px 110px rgba(0,0,0,.66), 0 0 0 1px rgba(80,210,255,.025), inset 0 1px 0 rgba(255,255,255,.045);
    }

        .kx-modal::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 3px;
            background: linear-gradient(90deg,transparent 4%,var(--gold) 32%,var(--cyan) 68%,transparent 96%);
            box-shadow: 0 0 18px rgba(80,210,255,.18);
        }

        .kx-modal::after {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            right: -105px;
            top: -125px;
            border-radius: 50%;
            pointer-events: none;
            background: radial-gradient(circle,rgba(80,210,255,.13),transparent 67%);
        }

        .kx-modal h3 {
            position: relative;
            z-index: 1;
            font-size: 27px;
            letter-spacing: -.35px;
        }

        .kx-modal p {
            position: relative;
            z-index: 1;
            max-width: 540px;
            font-size: 14px;
        }

    .kx-field {
        position: relative;
        z-index: 1;
    }

    .kx-input,
    .kx-textarea {
        border-color: rgba(75,149,220,.34);
        background: linear-gradient(180deg,rgba(3,20,37,.96),rgba(4,25,45,.96)) !important;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.022), 0 8px 22px rgba(0,0,0,.08);
        transition: border-color .16s ease, box-shadow .16s ease, transform .16s ease;
    }

        .kx-input:focus,
        .kx-textarea:focus {
            border-color: rgba(80,210,255,.72);
            box-shadow: 0 0 0 4px rgba(20,156,255,.09), 0 12px 26px rgba(0,0,0,.13);
            transform: translateY(-1px);
        }

    .kx-modal-actions {
        position: sticky;
        bottom: -26px;
        z-index: 3;
        margin: 22px -26px -26px;
        padding: 15px 26px 20px;
        border-top: 1px solid rgba(73,143,211,.16);
        background: linear-gradient(180deg,rgba(4,18,33,.82),rgba(3,15,27,.98) 38%);
        backdrop-filter: blur(10px);
    }

    .kx-modal-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 2px 0 18px;
        padding: 7px 11px;
        border-radius: 999px;
        border: 1px solid rgba(80,210,255,.25);
        color: #9fddff;
        background: rgba(20,156,255,.055);
        font-size: 11px;
        font-weight: 850;
        letter-spacing: .25px;
    }

        .kx-modal-status::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 10px rgba(54,230,154,.65);
        }

    @@media(max-width:700px) {
        .kx-modal {
            padding: 20px;
            border-radius: 17px;
        }

        .kx-modal-actions {
            margin: 18px -20px -20px;
            padding: 13px 20px 16px;
        }
    }

</style>


<div class="kx-cat-page">

    <header class="kx-header">

        <div>

            <div class="kx-breadcrumb">
                <a href="/Inventario/Index">Inventario</a>
                <span>›</span>
                <a href="/Inventario/Productos/Index">Productos</a>
                <span>›</span>
                <span>Catálogos</span>
            </div>

            <h1 class="kx-title">
                Catálogos de Inventario
            </h1>

            <p class="kx-subtitle">
                Administración maestra de categorías, unidades de medida y marcas.
            </p>

        </div>


        <div class="kx-actions">

            <a href="/Inventario/Productos/Index"
               class="kx-btn kx-btn-dark">
                ← Productos
            </a>

            <button type="button"
                    class="kx-btn kx-btn-gold"
                    onclick="KerniXCatalogos.abrirNuevaCategoria();">
                + Nueva categoría
            </button>

            <button type="button"
                    class="kx-btn kx-btn-blue"
                    onclick="KerniXCatalogos.abrirNuevaUnidad();">
                + Nueva unidad
            </button>

            <button type="button"
                    class="kx-btn kx-btn-green"
                    onclick="KerniXCatalogos.abrirNuevaMarca();">
                + Nueva marca
            </button>

        </div>

    </header>


    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="kx-message ok">
            @Model.Mensaje
        </div>
    }


    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="kx-message error">
            @Model.Error
        </div>
    }


    <section class="kx-summary">

        <article class="kx-card kx-kpi gold">
            <span>Categorías</span>
            <strong>@Model.Categorias.Count</strong>
        </article>

        <article class="kx-card kx-kpi green">
            <span>Categorías activas</span>
            <strong>@Model.Categorias.Count(x => x.Estado)</strong>
        </article>

        <article class="kx-card kx-kpi">
            <span>Unidades de medida</span>
            <strong>@Model.Unidades.Count</strong>
        </article>

        <article class="kx-card kx-kpi green">
            <span>Unidades activas</span>
            <strong>@Model.Unidades.Count(x => x.Estado)</strong>
        </article>

        <article class="kx-card kx-kpi">
            <span>Marcas</span>
            <strong>@Model.Marcas.Count</strong>
        </article>

        <article class="kx-card kx-kpi green">
            <span>Marcas activas</span>
            <strong>@Model.Marcas.Count(x => x.Estado)</strong>
        </article>

    </section>


    <section class="kx-grid">


        <!-- =====================================================
             CATEGORÍAS
             ===================================================== -->

        <article class="kx-card kx-panel">

            <div class="kx-panel-head">

                <div>
                    <h2>Categorías de producto</h2>
                    <p>
                        Tabla inv.categoria_producto · Empresa @Model.IdEmpresa
                    </p>
                </div>

            </div>


            <form method="get"
                  action="/Inventario/Catalogos/Index"
                  class="kx-filter">

                <input type="search"
                       name="BuscarCategoria"
                       value="@Model.BuscarCategoria"
