@page "/Account/Login"
@model KerniX.Pages.Account.LoginModel

@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión | KerniX ERP";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <!-- UIKIT -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/css/uikit.min.css" />

    <!-- KERNIX -->
    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />

</head>

<body>

    <div class="kx-page">

        <main class="kx-login-shell">

            <!-- ==================================================
             DECORACIÓN
        =================================================== -->

            <div class="kx-frame-inner"
                 aria-hidden="true">
            </div>

            <span class="kx-corner kx-corner-tl"
                  aria-hidden="true">
            </span>

            <span class="kx-corner kx-corner-tr"
                  aria-hidden="true">
            </span>

            <span class="kx-corner kx-corner-bl"
                  aria-hidden="true">
            </span>

            <span class="kx-corner kx-corner-br"
                  aria-hidden="true">
            </span>

            <div class="kx-center-divider"
                 aria-hidden="true">

                <span class="kx-divider-diamond">
                </span>

            </div>

            <!-- ==================================================
             CONTENIDO
        =================================================== -->

            <div class="kx-main">

                <!-- ==================================================
                 IZQUIERDA
            =================================================== -->

                <section class="kx-left">

                    <!-- MARCA -->

                    <header class="kx-brand">

                        <img src="~/images/login/kernix-logo.png"
                             asp-append-version="true"
                             class="kx-brand-logo"
                             alt="KerniX ERP" />

                        <div class="kx-brand-copy">

                            <div class="kx-brand-name">

                                <span>
                                    KerniX
                                </span>

                                <strong>
                                    ERP
                                </strong>

                            </div>

                            <div class="kx-brand-subtitle">
                                Sistema Inteligente de Gestión Empresarial
                            </div>

                        </div>

                    </header>

                    <!-- BIENVENIDA -->

                    <section class="kx-welcome">

                        <span class="kx-eyebrow">
                            Bienvenido de nuevo
                        </span>

                        <h1>
                            Accede a
                            <span>KerniX</span>
                        </h1>

                        <p>
                            Inicia sesión para continuar
                        </p>

                    </section>

                    <!-- ==================================================
                     FORMULARIO
                =================================================== -->

                    <form method="post"
                          id="loginForm"
                          class="kx-form"
                          autocomplete="on">

                        @Html.AntiForgeryToken()

                        <!-- ==================================================
                         USUARIO
                    =================================================== -->

                        <div class="kx-field"
                             id="usuarioField">

                            <label for="usuarioInput">
                                Usuario o correo electrónico
                            </label>

                            <div class="kx-input-wrapper">

                                <span class="kx-input-icon"
                                      uk-icon="icon: user">
                                </span>

                                <input id="usuarioInput"
                                       name="Input.Usuario"
                                       value="@Model.Input.Usuario"
                                       type="text"
                                       autocomplete="username"
                                       maxlength="100"
                                       spellcheck="false"
                                       placeholder="Usuario o correo electrónico" />

                            </div>

                            <div id="usuarioClientError"
                                 class="kx-field-error"
                                 hidden>
                            </div>

                        </div>

                        <!-- ==================================================
                         CONTRASEÑA
                    =================================================== -->

                        <div class="kx-field"
                             id="passwordField">

                            <label for="kxPassword">
                                Contraseña
                            </label>

                            <div class="kx-input-wrapper">

                                <span class="kx-input-icon"
                                      uk-icon="icon: lock; ratio: .95">
                                </span>

                                <input id="kxPassword"
                                       name="Input.Password"
                                       type="password"
                                       autocomplete="current-password"
                                       placeholder="Contraseña" />

                                <button type="button"
                                        id="kxTogglePassword"
                                        class="kx-eye"
                                        aria-label="Mostrar contraseña">

                                    <span id="kxEyeIcon"
                                          uk-icon="icon: eye; ratio: .9">
                                    </span>

                                </button>

                            </div>

                            <div id="passwordClientError"
                                 class="kx-field-error"
                                 hidden>
                            </div>

                        </div>

                        <!-- ==================================================
                         OPCIONES
                    =================================================== -->

                        <div class="kx-options">

                            <label class="kx-remember">

                                <input id="recordarmeInput"
                                       name="Input.Recordarme"
                                       class="kx-checkbox"
                                       type="checkbox"
                                       value="true"
                                @(Model.Input.Recordarme ? "checked" : "") />

                                <span>
                                    Recordarme
                                </span>

                            </label>

                            <a href="#"
                               class="kx-forgot">

                                ¿Olvidaste tu contraseña?

                            </a>

                        </div>

                        <!-- ==================================================
                         LOGIN
                    =================================================== -->

                        <button type="submit"
                                id="loginButton"
                                class="kx-login-button">

                            <span id="loginButtonText">
                                Iniciar sesión
                            </span>

                            <span id="loginSpinner"
                                  class="kx-login-spinner"
                                  uk-spinner="ratio: .65"
                                  hidden>
                            </span>

                            <span id="loginArrow"
                                  class="kx-button-arrow">
                                →
                            </span>

                        </button>

                        <!-- ==================================================
                         SEPARADOR
                    =================================================== -->

                        <div class="kx-or">

                            <span></span>

                            <p>
                                o continúa con
                            </p>

                            <span></span>

                        </div>

                        <!-- ==================================================
                         LOGIN EXTERNO
                    =================================================== -->

                        <div class="kx-social">

                            <button type="button"
                                    class="kx-social-button"
                                    data-provider="Microsoft"
                                    aria-label="Continuar con Microsoft">

                                <span class="kx-microsoft">
                                    <i></i>
                                    <i></i>
                                    <i></i>
                                    <i></i>
                                </span>

                            </button>

                            <button type="button"
                                    class="kx-social-button kx-google"
                                    data-provider="Google"
                                    aria-label="Continuar con Google">

                                G

                            </button>

                            <button type="button"
                                    class="kx-social-button"
                                    data-provider="SSO"
                                    aria-label="Acceso empresarial">

                                <span uk-icon="icon: lock; ratio: 1.05">
                                </span>

                            </button>

                        </div>

                        <!-- ==================================================
                         SEGURIDAD
                    =================================================== -->

                        <div class="kx-security">

                            <div class="kx-security-shield">

                                <span uk-icon="icon: lock; ratio: 1.15">
                                </span>

                            </div>

                            <div>

                                <strong>
                                    Seguridad y confianza
                                </strong>

                                <p>
                                    Protección avanzada de tus datos con
                                    autenticación segura y control de permisos.
                                </p>

                            </div>

                        </div>

                    </form>

                </section>

                <!-- ==================================================
                 DERECHA
            =================================================== -->

                <aside class="kx-right">

                    <div class="kx-portal">

                        <div class="kx-portal-glow">
                        </div>

                        <img src="~/images/login/kernix-portal.png"
                             asp-append-version="true"
                             class="kx-portal-image"
                             alt="Portal KerniX ERP" />

                    </div>

                    <div class="kx-right-heading">

                        <h2>
                            Tu centro de operaciones

                            <span>
                                inteligente
                            </span>
                        </h2>

                        <p>
                            Ventas, inventario y decisiones basadas
                            en información real de tu negocio.
                        </p>

                    </div>

                    <div class="kx-features">

                        <article class="kx-feature kx-feature-gold">

                            <div class="kx-feature-icon">
                                <span uk-icon="icon: database; ratio: 1.05">
                                </span>
                            </div>

                            <div class="kx-feature-content">

                                <strong>
                                    Gestión Integral
                                </strong>

                                <span>
                                    Administra ventas, inventarios
                                    y operaciones desde un solo lugar.
                                </span>

                            </div>

                            <div class="kx-feature-arrow">
                                →
                            </div>

                        </article>

                        <article class="kx-feature kx-feature-purple">

                            <div class="kx-feature-icon kx-ai-icon">
                                AI
                            </div>

                            <div class="kx-feature-content">

                                <strong>
                                    Inteligencia Artificial
                                </strong>

                                <span>
                                    Pronósticos, reposición,
                                    anomalías y análisis inteligente.
                                </span>

                            </div>

                            <div class="kx-feature-arrow">
                                →
                            </div>

                        </article>

                        <article class="kx-feature kx-feature-blue">

                            <div class="kx-feature-icon">

                                <span uk-icon="icon: settings; ratio: 1.05">
                                </span>

                            </div>

                            <div class="kx-feature-content">

                                <strong>
                                    Control Total
                                </strong>

                                <span>
                                    Monitorea stock, Kardex
                                    y movimientos en tiempo real.
                                </span>

                            </div>

                            <div class="kx-feature-arrow">
                                →
                            </div>

                        </article>

                        <article class="kx-feature kx-feature-cyan">

                            <div class="kx-feature-icon">

                                <span uk-icon="icon: cloud-upload; ratio: 1.05">
                                </span>

                            </div>

                            <div class="kx-feature-content">

                                <strong>
                                    En la Nube
                                </strong>

                                <span>
                                    Accede desde cualquier lugar
                                    de forma segura y rápida.
                                </span>

                            </div>

                            <div class="kx-feature-arrow">
                                →
                            </div>

                        </article>

                    </div>

                </aside>

            </div>

            <!-- ==================================================
             FOOTER
        =================================================== -->

            <footer class="kx-footer">

                <div class="kx-footer-item">

                    <div class="kx-footer-icon kx-footer-gold">
                        <span uk-icon="icon: lock"></span>
                    </div>

                    <div>
                        <strong>Seguro</strong>
                        <span>Encriptación avanzada</span>
                    </div>

                </div>

                <div class="kx-footer-item">

                    <div class="kx-footer-icon kx-footer-purple">
                        <span uk-icon="icon: cloud"></span>
                    </div>

                    <div>
                        <strong>Disponible</strong>
                        <span>Acceso 24/7 en la nube</span>
                    </div>

                </div>

                <div class="kx-footer-item">

                    <div class="kx-footer-icon kx-footer-gold">
                        <span uk-icon="icon: bolt"></span>
                    </div>

                    <div>
                        <strong>Inteligente</strong>
                        <span>Reportes e insights</span>
                    </div>

                </div>

                <div class="kx-footer-item">

                    <div class="kx-footer-icon kx-footer-blue">
                        <span uk-icon="icon: receiver"></span>
                    </div>

                    <div>
                        <strong>Soporte 24/7</strong>
                        <span>Asistencia especializada</span>
                    </div>

                </div>

            </footer>

        </main>

    </div>

    <!-- ==========================================================
     RESPUESTA DEL SERVIDOR
=========================================================== -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div id="serverError"
             data-message="@Model.ErrorMessage"
             hidden>
        </div>
    }

    <!-- ==========================================================
     UIKIT
=========================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/js/uikit.min.js">
    </script>

    <script src="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/js/uikit-icons.min.js">
    </script>

    <!-- KERNIX LOGIN -->

    <script src="~/js/login.js"
            asp-append-version="true">
    </script>

</body>
</html>