            /* ============================================================
               GLOBAL SEARCH
               ============================================================ */

            function iniciarBuscadorGlobal() {

                const input =
                    document.getElementById(
                        "globalSearch"
                    );

                const results =
                    document.getElementById(
                        "globalResults"
                    );


                if (
                    !input ||
                    !results
                ) {
                    return;
                }


                document.addEventListener(
                    "keydown",
                    function (event) {

                        if (
                            event.ctrlKey &&
                            event.key.toLowerCase() === "k"
                        ) {

                            event.preventDefault();

                            input.focus();

                            input.select();

                        }

                    }
                );


                input.addEventListener(
                    "input",
                    function () {

                        const query =
                            normalizarTexto(
                                input.value.trim()
                            );


                        if (query.length === 0) {

                            results.classList.remove(
                                "show"
                            );

                            results.innerHTML =
                                `
                                        <div class="kx-global-empty">
                                            Escribe para buscar.
                                        </div>
                                    `;

                            return;

                        }


                        const encontrados =
                            window.kernixCotizaciones
                                .filter(
                                    function (item) {

                                        const contenido =
                                            normalizarTexto(
                                                item.numero +
                                                " " +
                                                item.cliente +
                                                " " +
                                                item.documento +
                                                " " +
                                                item.estado
                                            );


                                        return contenido.includes(
                                            query
                                        );

                                    }
                                )
                                .slice(
                                    0,
                                    8
                                );


                        if (
                            encontrados.length === 0
                        ) {

                            results.innerHTML =
                                `
                                        <div class="kx-global-empty">
                                            No se encontraron resultados.
                                        </div>
                                    `;

                        }
                        else {

                            results.innerHTML =
                                encontrados
                                    .map(
                                        function (item) {

                                            return `
                                                    <a
                                                        href="/Cotizacion/Detalle?id=${item.id}"
                                                        class="kx-global-result">

                                                        <div class="kx-global-result-icon">

                                                            <i class="fa-regular fa-file-lines"></i>

                                                        </div>

                                                        <div class="kx-global-result-data">

                                                            <strong>
                                                                ${escaparHtml(item.numero)}
                                                                -
                                                                ${escaparHtml(item.cliente)}
                                                            </strong>

                                                            <span>
                                                                ${escaparHtml(item.estado)}
                                                                ·
                                                                S/ ${Number(item.total).toFixed(2)}
                                                            </span>

                                                        </div>

                                                    </a>
                                                `;

                                        }
                                    )
                                    .join("");

                        }


                        results.classList.add(
                            "show"
                        );

                    }
                );


                input.addEventListener(
                    "click",
                    function (event) {

                        event.stopPropagation();

                    }
                );


                results.addEventListener(
                    "click",
                    function (event) {

                        event.stopPropagation();

                    }
                );


                document.addEventListener(
                    "click",
                    function () {

                        results.classList.remove(
                            "show"
                        );

                    }
                );

            }



