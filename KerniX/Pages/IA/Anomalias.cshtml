@page "/IA/Anomalias"
@model KerniX.Pages.IA.AnomaliasModel
@using System.Globalization
@using System.Linq

@{
    ViewData["Title"] = "Detección de Anomalías | KerniX";

    var serie = Model.Analisis.Serie ?? new List<KerniX.Models.IA.IaDiaVenta>();

    var recientes = serie
        .TakeLast(Math.Min(30, serie.Count))
        .ToList();

    var meses = serie
        .GroupBy(x => new { x.Fecha.Year, x.Fecha.Month })
        .Select(g => new
        {
            Fecha = new DateTime(g.Key.Year, g.Key.Month, 1),
            Total = g.Sum(x => x.Total),
            Operaciones = g.Sum(x => x.Operaciones)
        })
        .OrderBy(x => x.Fecha)
        .ToList();

    decimal maxReciente = recientes.Count > 0
        ? Math.Max(1M, recientes.Max(x => x.Total))
        : 1M;

    decimal maxMes = meses.Count > 0
        ? Math.Max(1M, meses.Max(x => x.Total))
        : 1M;

    int maxOps = serie.Count > 0
        ? Math.Max(1, serie.Max(x => x.Operaciones))
        : 1;

    var fechasAnomalias = Model.Analisis.Anomalias
        .Select(x => x.Fecha.Date)
        .ToHashSet();

    string desdeTexto = Model.FechaDesde?.ToString("dd/MM/yyyy") ?? "—";
    string hastaTexto = Model.FechaHasta?.ToString("dd/MM/yyyy") ?? "—";
}

