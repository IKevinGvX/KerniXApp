            /* ============================================================
               3D DONUT
               ============================================================ */

            function iniciarGrafico3D() {

                const canvas =
                    document.getElementById(
                        "estadoChart"
                    );


                if (
                    !canvas ||
                    typeof Chart ===
                    "undefined"
                ) {
                    return;
                }


                const source =
                    window.kernixCotizacionChart;


                if (!source) {
                    return;
                }


                const labels =
                    Array.isArray(
                        source.labels
                    )
                        ? source.labels
                        : [];


                const valores =
                    Array.isArray(
                        source.valores
                    )
                        ? source.valores
                        : [];


                if (
                    labels.length === 0 ||
                    valores.length === 0
                ) {
                    return;
                }


                const colores =
                    labels.map(
                        obtenerColorEstado
                    );


                const profundidadColores =
                    labels.map(
                        obtenerColorProfundidad
                    );


                /*
                 * EFECTO DE PROFUNDIDAD.
                 *
                 * Dibuja varias capas inferiores.
                 */

                const profundidadPlugin = {

                    id:
                        "kernixDepth",

                    beforeDatasetDraw(
                        chart
                    ) {

                        const meta =
                            chart.getDatasetMeta(
                                0
                            );

                        const ctx =
                            chart.ctx;


                        if (
                            !meta ||
                            !meta.data
                        ) {
                            return;
                        }


                        for (
                            let depth = 13;
                            depth >= 2;
                            depth--
                        ) {

                            meta.data.forEach(
                                function (
                                    arc,
                                    index
                                ) {

                                    const props =
                                        arc.getProps(
                                            [
                                                "x",
                                                "y",
                                                "startAngle",
                                                "endAngle",
                                                "innerRadius",
                                                "outerRadius"
                                            ],
                                            true
                                        );


                                    ctx.save();

                                    ctx.beginPath();


                                    ctx.arc(
                                        props.x,
                                        props.y +
                                        depth,
                                        props.outerRadius,
                                        props.startAngle,
                                        props.endAngle
                                    );


                                    ctx.arc(
                                        props.x,
                                        props.y +
                                        depth,
                                        props.innerRadius,
                                        props.endAngle,
                                        props.startAngle,
                                        true
                                    );


                                    ctx.closePath();


                                    ctx.fillStyle =
                                        profundidadColores[
                                        index
                                        ];


                                    ctx.fill();


                                    ctx.restore();

                                }
                            );

                        }

                    }

                };


                const glowPlugin = {

                    id:
                        "kernixGlow",

                    beforeDatasetDraw(
                        chart
                    ) {

                        const ctx =
                            chart.ctx;


                        ctx.save();


                        ctx.shadowColor =
                            "rgba(0,0,0,.70)";


                        ctx.shadowBlur =
                            18;


                        ctx.shadowOffsetX =
                            4;


                        ctx.shadowOffsetY =
                            12;

                    },


                    afterDatasetDraw(
                        chart
                    ) {

                        chart.ctx.restore();

                    }

                };


                new Chart(
                    canvas,
                    {

                        type:
                            "doughnut",


                        data: {

                            labels:
                                labels,


                            datasets: [
                                {

                                    data:
                                        valores,


                                    backgroundColor:
                                        colores,


                                    borderColor:
                                        colores.map(
                                            function (
                                                color
                                            ) {

                                                return aclararColor(
                                                    color,
                                                    35
                                                );

                                            }
                                        ),


                                    borderWidth:
                                        2,


                                    hoverOffset:
                                        13,


                                    hoverBorderWidth:
                                        3,


                                    spacing:
                                        1

                                }
                            ]

                        },


                        plugins: [
                            profundidadPlugin,
                            glowPlugin
                        ],


                        options: {

                            responsive:
                                true,


                            maintainAspectRatio:
                                true,


                            cutout:
                                "58%",


                            rotation:
                                -90,


                            layout: {

                                padding: {

                                    top:
                                        8,

                                    right:
                                        12,

                                    bottom:
                                        28,

                                    left:
                                        12

                                }

                            },


                            animation: {

                                animateRotate:
                                    true,

                                animateScale:
                                    true,

                                duration:
                                    1000

                            },


                            plugins: {

                                legend: {

                                    display:
                                        false

                                },


                                tooltip: {

                                    enabled:
                                        true,


                                    backgroundColor:
                                        "#061321",


                                    borderColor:
                                        "#31526f",


                                    borderWidth:
                                        1,


                                    titleColor:
                                        "#ffffff",


                                    bodyColor:
                                        "#dce7f0",


                                    padding:
                                        11,


                                    callbacks: {

                                        label(
                                            context
                                        ) {

                                            const value =
                                                Number(
                                                    context.raw ||
                                                    0
                                                );


                                            const total =
                                                context
                                                    .dataset
                                                    .data
                                                    .reduce(
                                                        function (
                                                            accumulator,
                                                            current
                                                        ) {

                                                            return (
                                                                Number(
                                                                    accumulator
                                                                ) +
                                                                Number(
                                                                    current
                                                                )
                                                            );

                                                        },
                                                        0
                                                    );


                                            const porcentaje =
                                                total > 0
                                                    ? (
                                                        value /
                                                        total *
                                                        100
                                                    ).toFixed(
                                                        1
                                                    )
                                                    : "0.0";


                                            return (
                                                " " +
                                                context.label +
                                                ": " +
                                                value +
                                                " (" +
                                                porcentaje +
                                                "%)"
                                            );

                                        }

                                    }

                                }

                            }

                        }

                    }
                );

            }



            /* ============================================================
               COLORS
               ============================================================ */

            function obtenerColorEstado(
                estado
            ) {

                const value =
                    normalizarTexto(
                        estado
                    );


                if (
                    value.includes(
                        "pendiente"
                    )
                ) {

                    return "#ffb900";

                }


                if (
                    value.includes(
                        "aprob"
                    )
                ) {

                    return "#38d94f";

                }


                if (
                    value.includes(
                        "convert"
                    )
                ) {

                    return "#1687ff";

                }


                if (
                    value.includes(
                        "rechaz"
                    )
                ) {

                    return "#ff3636";

                }


                if (
                    value.includes(
                        "venc"
                    )
                ) {

                    return "#9b5cff";

                }


                return "#00d4d4";

            }



            function obtenerColorProfundidad(
                estado
            ) {

                const value =
                    normalizarTexto(
                        estado
                    );


                if (
                    value.includes(
                        "pendiente"
                    )
                ) {

                    return "#624100";

                }


                if (
                    value.includes(
                        "aprob"
                    )
                ) {

                    return "#0c641f";

                }


                if (
                    value.includes(
                        "convert"
                    )
                ) {

                    return "#063d82";

                }


                if (
                    value.includes(
                        "rechaz"
                    )
                ) {

                    return "#771717";

                }


                if (
                    value.includes(
                        "venc"
                    )
                ) {

                    return "#47237e";

                }


                return "#006868";

            }



            function aclararColor(
                hex,
                porcentaje
            ) {

                const num =
                    parseInt(
                        hex.replace(
                            "#",
                            ""
                        ),
                        16
                    );


                let r =
                    (
                        num >>
                        16
                    ) +
                    porcentaje;


                let g =
                    (
                        (
                            num >>
                            8
                        ) &
                        0x00FF
                    ) +
                    porcentaje;


                let b =
                    (
                        num &
                        0x0000FF
                    ) +
                    porcentaje;


                r =
                    Math.min(
                        255,
                        r
                    );


                g =
                    Math.min(
                        255,
                        g
                    );


                b =
                    Math.min(
                        255,
                        b
                    );


                return (
                    "#" +
                    (
                        b |
                        (
                            g <<
                            8
                        ) |
                        (
                            r <<
                            16
                        )
                    )
                        .toString(
                            16
                        )
                        .padStart(
                            6,
                            "0"
                        )
                );

            }



            /* ============================================================
               UTILS
               ============================================================ */

            function normalizarTexto(
                texto
            ) {

                return String(
                    texto ||
                    ""
                )
                    .toLowerCase()
                    .normalize(
                        "NFD"
                    )
                    .replace(
                        /[\u0300-\u036f]/g,
                        ""
                    );

            }



            function escaparHtml(
                texto
            ) {

                const div =
                    document.createElement(
                        "div"
                    );


                div.textContent =
                    String(
                        texto ??
                        ""
                    );


                return div.innerHTML;

            }

    </script>


