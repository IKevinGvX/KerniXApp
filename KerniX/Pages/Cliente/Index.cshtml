@page
@model KerniX.Pages.Cliente.IndexModel

@{
    Layout = null;
    ViewData["Title"] = "Clientes | KerniX";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Clientes | KerniX</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/css/uikit.min.css" />

    <style>

            :root {
                --bg: #07111f;
                --bg2: #0d1b2c;
                --panel: #102136;
                --panel2: #142941;
                --gold: #f6c75b;
                --gold2: #dba83c;
                --blue: #55a7ff;
                --green: #36d5a5;
                --red: #ff7185;
                --text: #edf4fc;
                --muted: #91a8be;
                --line: rgba(148, 181, 218, .16);
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: linear-gradient( 145deg, #07111f, #0a1a2c 60%, #081322 );
                color: var(--text);
                font-family: Inter, "Segoe UI", Arial, sans-serif;
            }

            button,
            input,
            select {
                font: inherit;
            }

            button {
                cursor: pointer;
            }

                button:disabled {
                    opacity: .55;
                    cursor: not-allowed;
                }

            [hidden] {
                display: none !important;
            }

            /* =====================================
                                               ESTRUCTURA
                                            ===================================== */

            .kx-layout {
                display: grid;
                grid-template-columns: 245px minmax(0, 1fr);
                min-height: 100vh;
            }

            .kx-sidebar {
                background: #091625;
                border-right: 1px solid var(--line);
                padding: 25px 15px;
            }

            .kx-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 35px;
            }

            .kx-logo {
                width: 47px;
                height: 47px;
                display: grid;
                place-items: center;
                border-radius: 13px;
                background: linear-gradient( 145deg, var(--gold), var(--gold2) );
                color: #091525;
                font-size: 23px;
                font-weight: 900;
            }

            .kx-brand strong {
                display: block;
                color: white;
                font-size: 19px;
            }

            .kx-brand small {
                color: var(--muted);
            }

            .kx-nav {
                display: flex;
                flex-direction: column;
                gap: 7px;
            }

                .kx-nav a {
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    padding: 13px;
                    border-radius: 11px;
                    text-decoration: none;
                    color: #9ab0c5;
                    font-size: 14px;
                    font-weight: 700;
                }

                    .kx-nav a:hover {
                        background: #14283e;
                        color: white;
                        text-decoration: none;
                    }

                    .kx-nav a.active {
                        background: rgba(246, 199, 91, .10);
                        color: var(--gold);
                        border: 1px solid rgba(246, 199, 91, .20);
                    }

            .kx-main {
                min-width: 0;
                padding: 30px;
            }

            /* =====================================
                                               CABECERA
                                            ===================================== */

            .kx-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 20px;
                margin-bottom: 28px;
            }

            .kx-eyebrow {
                color: var(--gold);
                font-size: 11px;
                font-weight: 900;
                letter-spacing: 1.5px;
                text-transform: uppercase;
            }

            .kx-header h1 {
                margin: 7px 0;
                color: white;
                font-size: 33px;
                font-weight: 900;
            }

            .kx-header p {
                margin: 0;
                color: var(--muted);
                font-size: 14px;
            }

            .kx-actions {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
            }

            .kx-btn {
                min-height: 43px;
                padding: 0 17px;
                border-radius: 10px;
                border: 1px solid var(--line);
                background: #172b42;
                color: white;
                font-size: 13px;
                font-weight: 800;
            }

                .kx-btn:hover {
                    filter: brightness(1.15);
                }

            .kx-btn-primary {
                border: none;
                background: linear-gradient( 135deg, #f8d578, #dca638 );
                color: #091525;
            }

            .kx-btn-blue {
                border-color: rgba(85, 167, 255, .35);
                color: #9dceff;
            }

            /* =====================================
                                               INDICADORES
                                            ===================================== */

            .kx-stats {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 17px;
                margin-bottom: 25px;
            }

            .kx-stat {
                position: relative;
                min-width: 0;
                padding: 22px;
                border-radius: 17px;
                border: 1px solid var(--line);
                background: linear-gradient( 145deg, #142941, #0d1d30 );
                overflow: hidden;
            }

                .kx-stat::before {
                    content: "";
                    position: absolute;
                    width: 110px;
                    height: 110px;
                    top: -60px;
                    right: -50px;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, .04);
                }

                .kx-stat.gold {
                    border-color: rgba(246, 199, 91, .30);
                }

                .kx-stat.green {
                    border-color: rgba(54, 213, 165, .25);
                }

                .kx-stat.blue {
                    border-color: rgba(85, 167, 255, .28);
                }

                .kx-stat.red {
                    border-color: rgba(255, 113, 133, .25);
                }

            .kx-stat-icon {
                display: grid;
                place-items: center;
                width: 42px;
                height: 42px;
                border-radius: 11px;
                margin-bottom: 17px;
                background: rgba(246, 199, 91, .12);
                color: var(--gold);
            }

            .kx-stat.green .kx-stat-icon {
                background: rgba(54, 213, 165, .10);
                color: var(--green);
            }

            .kx-stat.blue .kx-stat-icon {
                background: rgba(85, 167, 255, .10);
                color: var(--blue);
            }

            .kx-stat.red .kx-stat-icon {
                background: rgba(255, 113, 133, .10);
                color: var(--red);
            }

            .kx-stat-label {
                display: block;
                color: var(--muted);
                font-size: 13px;
            }

            .kx-stat-value {
                display: block;
                margin-top: 8px;
                color: white;
                font-size: 31px;
                font-weight: 900;
            }

            .kx-stat small {
                display: block;
                margin-top: 7px;
                color: #6f8aa2;
                font-size: 11px;
            }

            /* =====================================
                                               PANEL Y FILTROS
                                            ===================================== */

            .kx-panel {
                border-radius: 17px;
                border: 1px solid var(--line);
                background: #102136;
                overflow: hidden;
            }

            .kx-panel-header {
                display: flex;
                justify-content: space-between;
                gap: 20px;
                align-items: center;
                padding: 23px;
                border-bottom: 1px solid var(--line);
            }

                .kx-panel-header h2 {
                    margin: 0;
                    color: white;
                    font-size: 19px;
                    font-weight: 850;
                }

                .kx-panel-header p {
                    margin: 6px 0 0;
                    color: var(--muted);
                    font-size: 12px;
                }

            .kx-count {
                background: rgba(246, 199, 91, .10);
                color: var(--gold);
                padding: 8px 12px;
                border-radius: 30px;
                font-size: 12px;
                font-weight: 800;
            }

            .kx-filters {
                display: grid;
                grid-template-columns: minmax(0, 1fr) 180px 150px;
                gap: 12px;
                padding: 20px 23px;
            }

            .kx-input,
            .kx-select {
                width: 100%;
                min-width: 0;
                height: 44px;
                padding: 0 13px;
                background: #091a2d;
                border: 1px solid rgba(126, 174, 218, .19);
                border-radius: 10px;
                color: white;
                outline: none;
                font-size: 13px;
            }

                .kx-input:focus,
                .kx-select:focus {
                    border-color: var(--gold);
                }

                .kx-input::placeholder {
                    color: #69839c;
                }

                .kx-select option {
                    background: #102136;
                    color: white;
                }

            /* =====================================
                                               TABLA
                                            ===================================== */

            .kx-table-wrap {
                overflow-x: auto;
            }

            .kx-table {
                width: 100%;
                min-width: 900px;
                border-collapse: collapse;
            }

                .kx-table thead {
                    background: #0b1b2c;
                }

                .kx-table th {
                    padding: 16px 20px;
                    color: #829bb3;
                    text-align: left;
                    font-size: 11px;
                    font-weight: 850;
                    text-transform: uppercase;
                }

                .kx-table td {
                    padding: 16px 20px;
                    border-top: 1px solid var(--line);
                    color: #dbe7f4;
                    font-size: 13px;
                    vertical-align: middle;
                }

                .kx-table tbody tr:hover {
                    background: rgba(85, 167, 255, .035);
                }

            .kx-client {
                display: flex;
                align-items: center;
                gap: 12px;
                min-width: 210px;
            }

            .kx-avatar {
                width: 42px;
                height: 42px;
                flex: 0 0 auto;
                display: grid;
                place-items: center;
                border-radius: 12px;
                background: linear-gradient( 145deg, #244e73, #17334d );
                color: #a9d7ff;
                font-size: 15px;
                font-weight: 900;
            }

            .kx-client strong {
                display: block;
                color: white;
                font-size: 13px;
            }

            .kx-client small {
                display: block;
                margin-top: 4px;
                color: var(--muted);
                font-size: 11px;
            }

            .kx-badge {
                display: inline-flex;
                padding: 6px 10px;
                border-radius: 30px;
                font-size: 11px;
                font-weight: 800;
            }

                .kx-badge.active {
                    background: rgba(54, 213, 165, .11);
                    color: #56ecc0;
                }

                .kx-badge.inactive {
                    background: rgba(255, 113, 133, .11);
                    color: #ff92a2;
                }

                .kx-badge.type {
                    background: rgba(85, 167, 255, .11);
                    color: #91c8ff;
                }

            .kx-table-actions {
                display: flex;
                gap: 6px;
            }

            .kx-icon-btn {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                border: 1px solid var(--line);
                background: #172d45;
                color: #9ccaff;
                display: grid;
                place-items: center;
            }

                .kx-icon-btn:hover {
                    color: var(--gold);
                    border-color: var(--gold);
                }

            .kx-empty {
                padding: 48px 20px !important;
                text-align: center;
                color: var(--muted) !important;
            }

            /* =====================================
                                               PAGINACIÓN
                                            ===================================== */

            .kx-pagination {
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 15px;
                padding: 19px 23px;
                border-top: 1px solid var(--line);
            }

                .kx-pagination span {
                    color: var(--muted);
                    font-size: 12px;
                }

            /* =====================================
                                               MODALES
                                            ===================================== */

            .kx-modal {
                position: fixed;
                inset: 0;
                z-index: 9999;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 20px;
                background: rgba(2, 8, 17, .88);
                backdrop-filter: blur(8px);
            }

            .kx-modal-dialog {
                width: 820px;
                max-width: 100%;
                max-height: calc(100dvh - 40px);
                display: flex;
                flex-direction: column;
                background: #102238;
                border: 1px solid rgba(246, 199, 91, .25);
                border-radius: 17px;
                overflow: hidden;
                box-shadow: 0 30px 90px rgba(0,0,0,.5);
            }

            .kx-modal-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 14px;
                padding: 20px 24px;
                background: #0b1b2d;
                border-bottom: 1px solid var(--line);
            }

                .kx-modal-header h2 {
                    margin: 0;
                    color: white;
                    font-size: 21px;
                }

                .kx-modal-header p {
                    margin: 5px 0 0;
                    color: var(--muted);
                    font-size: 12px;
                }

            .kx-modal-body {
                overflow-y: auto;
                padding: 24px;
                min-height: 0;
            }

            .kx-modal-footer {
                display: flex;
                justify-content: flex-end;
                flex-wrap: wrap;
                gap: 10px;
                padding: 17px 24px;
                background: #0b1b2d;
                border-top: 1px solid var(--line);
            }

            .kx-form-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 17px;
            }

            .kx-field {
                min-width: 0;
            }

                .kx-field.full {
                    grid-column: 1 / -1;
                }

                .kx-field label {
                    display: block;
                    color: #a2b8cd;
                    margin-bottom: 7px;
                    font-size: 12px;
                    font-weight: 750;
                }

            .kx-subtitle {
                grid-column: 1 / -1;
                margin: 12px 0 0;
                padding-top: 17px;
                border-top: 1px solid var(--line);
                color: var(--gold);
                font-size: 14px;
                font-weight: 850;
            }

            .kx-extra-card {
                padding: 15px;
                border: 1px solid var(--line);
                border-radius: 12px;
                background: #0b1b2e;
                margin-bottom: 12px;
            }

            .kx-extra-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 10px;
                margin-bottom: 14px;
            }

                .kx-extra-header strong {
                    color: var(--gold);
                    font-size: 12px;
                }

            .kx-check {
                display: flex;
                align-items: center;
                gap: 9px;
                color: var(--muted);
                font-size: 12px;
            }

            .kx-detail-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0,1fr));
                gap: 15px;
            }

            .kx-detail-item {
                padding: 17px;
                background: #0b1b2e;
                border: 1px solid var(--line);
                border-radius: 12px;
                min-width: 0;
                overflow-wrap: anywhere;
            }

                .kx-detail-item small {
                    display: block;
                    color: var(--muted);
                    margin-bottom: 7px;
                }

                .kx-detail-item strong {
                    color: white;
                    font-size: 14px;
                }

            .kx-message {
                margin-bottom: 18px;
                padding: 13px 15px;
                border-radius: 10px;
                background: rgba(255, 113, 133, .09);
                border: 1px solid rgba(255, 113, 133, .25);
                color: #ff9baa;
                font-size: 13px;
            }

            .kx-toast {
                position: fixed;
                bottom: 25px;
                right: 25px;
                z-index: 10000;
                max-width: min(400px, calc(100vw - 30px));
                padding: 15px 19px;
                border-radius: 12px;
                background: #173b37;
                border: 1px solid var(--green);
                box-shadow: 0 15px 40px #0005;
                color: white;
                font-size: 13px;
            }

                .kx-toast.error {
                    background: #442332;
                    border-color: var(--red);
                }

            /* =====================================
                                               RESPONSIVE
                                            ===================================== */

            @@media (max-width: 1200px) {

                .kx-stats {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @@media (max-width: 900px) {

                .kx-layout {
                    grid-template-columns: 1fr;
                }

                .kx-sidebar {
                    display: none;
                }

                .kx-main {
                    padding: 18px;
                }

                .kx-filters {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 650px) {

                .kx-stats {
                    grid-template-columns: 1fr;
                }

                .kx-header h1 {
                    font-size: 27px;
                }

                .kx-form-grid,
                .kx-detail-grid {
                    grid-template-columns: 1fr;
                }

                .kx-modal {
                    padding: 8px;
                }

                .kx-modal-dialog {
                    max-height: calc(100dvh - 16px);
                }

                .kx-modal-body {
                    padding: 16px;
                }

                .kx-modal-header,
                .kx-modal-footer {
                    padding: 16px;
                }

                .kx-panel-header {
                    flex-wrap: wrap;
                }
            }


            /* Tabla estable: cada cabecera comparte anchura con su columna. */
            .kx-table-wrap {
                display: block;
                width: 100%;
                max-width: 100%;
                overflow-x: auto;
                overflow-y: hidden;
                -webkit-overflow-scrolling: touch;
            }

            .kx-table {
                width: 1200px;
                min-width: 100%;
                table-layout: fixed;
                border-collapse: collapse;
            }

                .kx-table th,
                .kx-table td {
                    box-sizing: border-box;
                    padding: 13px 12px;
                    vertical-align: middle;
                    text-align: left;
                    overflow: visible;
                }

                .kx-table th {
                    white-space: nowrap;
                }

                .kx-table td {
                    overflow-wrap: normal;
                }

            .kx-client {
                display: flex;
                align-items: center;
                gap: 12px;
                min-width: 0;
                width: 100%;
            }

                .kx-client > div:last-child {
                    flex: 1 1 auto;
                    min-width: 0;
                    width: auto;
                }

                .kx-client strong,
                .kx-client small {
                    display: block;
                    max-width: 100%;
                    white-space: normal;
                    overflow-wrap: anywhere;
                    overflow: visible;
                    text-overflow: clip;
                }

            .kx-contact {
                min-width: 0;
                max-width: 100%;
            }

            .kx-contact-phone,
            .kx-contact-mail {
                display: block;
                max-width: 100%;
                overflow-wrap: anywhere;
                white-space: normal;
                overflow: visible;
            }

            .kx-contact-mail {
                color: var(--muted);
            }

            .kx-table-actions {
                display: flex;
                align-items: center;
                justify-content: flex-start;
                gap: 8px;
                flex-wrap: nowrap;
            }

                .kx-table-actions .kx-icon-btn {
                    flex: 0 0 34px;
                }

    </style>

</head>

<body>

    <!-- TOKEN ANTIFALSIFICACIÓN -->

    <form id="formTokenClientes"
          method="post"
          hidden>

        @Html.AntiForgeryToken()

    </form>

    <div class="kx-layout">

        <!-- ====================================
             SIDEBAR
        ==================================== -->

        <aside class="kx-sidebar">

            <div class="kx-brand">

                <div class="kx-logo">K</div>

                <div>
                    <strong>KerniX</strong>
                    <small>Gestión comercial</small>
                </div>

            </div>

            <nav class="kx-nav">

                <a href="/Inicio/Index">
                    <span uk-icon="home"></span>
                    Inicio
                </a>

                <a href="/Ventas/PrincipalVentas">
                    <span uk-icon="cart"></span>
                    Ventas
                </a>

                <a href="/Ventas/Nueva">
                    <span uk-icon="plus-circle"></span>
                    Nueva venta
                </a>

                <a href="/Cliente/Index"
                   class="kx-submenu-link">

                    <span class="kx-sub-dot"></span>
                    Clientes

                </a>
            </nav>

        </aside>

        <!-- ====================================
             CONTENIDO
        ==================================== -->

        <main class="kx-main">

            <!-- CABECERA -->

            <header class="kx-header">

                <div>

                    <span class="kx-eyebrow">
                        Gestión comercial / CRM
                    </span>

                    <h1>Gestión de clientes</h1>

                    <p>
                        Administra clientes, contactos,
                        direcciones y relaciones comerciales.
                    </p>

                </div>

                <div class="kx-actions">

                    <button type="button"
                            class="kx-btn kx-btn-blue"
                            id="recargarClientes">

                        <span uk-icon="refresh"></span>
                        Actualizar

                    </button>

                    <button type="button"
                            class="kx-btn kx-btn-primary"
                            id="abrirNuevoCliente">

                        <span uk-icon="plus"></span>
                        Nuevo cliente

                    </button>

                </div>

            </header>

            <!-- ====================================
                 INDICADORES
            ==================================== -->

            <section class="kx-stats">

                <article class="kx-stat gold">

                    <div class="kx-stat-icon">
                        <span uk-icon="users"></span>
                    </div>

                    <span class="kx-stat-label">
                        Total de clientes
                    </span>

                    <strong class="kx-stat-value"
                            id="statTotal">
                        0
                    </strong>

                    <small>
                        Registros de la empresa
                    </small>

                </article>

                <article class="kx-stat green">

                    <div class="kx-stat-icon">
                        <span uk-icon="check-circle"></span>
                    </div>

                    <span class="kx-stat-label">
                        Clientes activos
                    </span>

                    <strong class="kx-stat-value"
                            id="statActivos">
                        0
                    </strong>

                    <small>
                        Habilitados actualmente
                    </small>

                </article>

                <article class="kx-stat blue">

                    <div class="kx-stat-icon">
                        <span uk-icon="world"></span>
                    </div>

                    <span class="kx-stat-label">
                        Personas jurídicas
                    </span>

                    <strong class="kx-stat-value"
                            id="statJuridicos">
                        0
                    </strong>

                    <small>
                        Empresas registradas
                    </small>

                </article>

                <article class="kx-stat red">

                    <div class="kx-stat-icon">
                        <span uk-icon="ban"></span>
                    </div>

                    <span class="kx-stat-label">
                        Clientes inactivos
                    </span>

                    <strong class="kx-stat-value"
                            id="statInactivos">
                        0
                    </strong>

                    <small>
                        Registros deshabilitados
                    </small>

                </article>

            </section>

            <!-- ====================================
                 LISTADO
            ==================================== -->

            <section class="kx-panel">

                <div class="kx-panel-header">

                    <div>

                        <h2>Directorio de clientes</h2>

                        <p>
                            Consulta y administra los
                            clientes registrados.
                        </p>

                    </div>

                    <span class="kx-count"
                          id="contadorClientes">
                        0 clientes
                    </span>

                </div>

                <!-- FILTROS -->

                <div class="kx-filters">

                    <input type="search"
                           class="kx-input"
                           id="buscarClientes"
                           autocomplete="off"
                           placeholder="Buscar por nombre, RUC, DNI, correo..." />

                    <select class="kx-select"
                            id="filtroTipo">

                        <option value="">
                            Todos los tipos
                        </option>

                        <option value="natural">
                            Persona natural
                        </option>

                        <option value="juridico">
                            Persona jurídica
                        </option>

                    </select>

                    <select class="kx-select"
                            id="filtroEstado">

                        <option value="">
                            Todos los estados
                        </option>

                        <option value="activo">
                            Activos
                        </option>

                        <option value="inactivo">
                            Inactivos
                        </option>

                    </select>

                </div>

                <!-- TABLA -->

                <div class="kx-table-wrap">

                    <table class="kx-table">
                        <colgroup>
                            <col style="width:285px" />
                            <col style="width:160px" />
                            <col style="width:125px" />
                            <col style="width:330px" />
                            <col style="width:130px" />
                            <col style="width:170px" />
                        </colgroup>

                        <thead>

                            <tr>

                                <th>Cliente</th>
                                <th>Documento</th>
                                <th>Tipo</th>
                                <th>Contacto</th>
                                <th>Estado</th>
                                <th>Acciones</th>

                            </tr>

                        </thead>

                        <tbody id="tablaClientes">

                            <tr>

                                <td colspan="6"
                                    class="kx-empty">

                                    Cargando clientes...

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

                <!-- PAGINACIÓN -->

                <div class="kx-pagination">

                    <span id="textoPaginacion">
                        0 registros
                    </span>

                    <div class="kx-actions">

                        <button type="button"
                                class="kx-btn"
                                id="paginaAnterior">

                            Anterior

                        </button>

                        <button type="button"
                                class="kx-btn"
                                id="paginaSiguiente">

                            Siguiente

                        </button>

                    </div>

                </div>

            </section>

        </main>

    </div>

    <!-- ==========================================
         MODAL REGISTRAR / EDITAR
    ========================================== -->

    <div class="kx-modal"
         id="modalCliente"
