@page "/Account/ResetPassword"
@model KerniX.Pages.Account.ResetPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Restablecer contraseña | KerniX ERP";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#040914" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/uikit@3.23.12/dist/css/uikit.min.css" />
    <link rel="stylesheet" href="~/css/recuperacion.css" asp-append-version="true" />
</head>
<body class="kxrp-body">
<div class="kxrp-stage">
    <span class="kxrp-ambient kxrp-ambient-one" aria-hidden="true"></span>
    <span class="kxrp-ambient kxrp-ambient-two" aria-hidden="true"></span>
    <div class="kxrp-wrap">
        <header class="kxrp-topbar">
            <a href="/Account/Login" class="kxrp-brand" aria-label="KerniX ERP - Ir al inicio de sesión">
                <img src="~/images/login/kernix-logo.png" asp-append-version="true" alt="" class="kxrp-brand-logo" />
                <span class="kxrp-brand-text"><strong>KerniX <em>ERP</em></strong><small>Sistema Inteligente de Gestión Empresarial</small></span>
            </a>
            <div class="kxrp-topbar-right"><span class="kxrp-status-led"></span> CENTRO DE SEGURIDAD <span class="kxrp-topbar-line"></span> <span class="kxrp-topbar-version">ACCESO SEGURO</span></div>
        </header>

        <main class="kxrp-layout" id="contenido">
            <section class="kxrp-card" aria-labelledby="kxrp-title">
                <div class="kxrp-card-aura" aria-hidden="true"></div>
                <div class="kxrp-card-content">
                    <div class="kxrp-breadcrumb"><span class="kxrp-pulse"></span> SEGURIDAD DE LA CUENTA <span class="kxrp-slash">/</span> NUEVA CLAVE</div>
                    @if (Model.Actualizada)
                    {
                        <div class="kxrp-emblem kxrp-emblem-success" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12.5l5 5L20 6" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                        <h1 id="kxrp-title" class="kxrp-heading">Contraseña <span>actualizada</span></h1>
                        <p class="kxrp-lead">Tu contraseña se restableció correctamente. Ya puedes iniciar sesión en KerniX ERP con tu nueva clave.</p>
                        <div class="kxrp-info kxrp-info-success" role="status"><span class="kxrp-info-icon" aria-hidden="true">✓</span><div><strong>Protección restablecida</strong><span>El enlace utilizado ya no es válido. Tu siguiente acceso requiere la nueva contraseña.</span></div></div>
                        <a href="/Account/Login" class="kxrp-button kxrp-primary">Iniciar sesión <span aria-hidden="true">→</span></a>
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="kxrp-emblem" aria-hidden="true">!</div>
                        <h1 id="kxrp-title" class="kxrp-heading">No fue <span>posible continuar</span></h1>
                        <div class="kxrp-info kxrp-info-error" role="alert">@Model.ErrorMessage</div>
                        <a class="kxrp-button kxrp-primary" href="/Account/ForgotPassword">Solicitar un enlace nuevo <span aria-hidden="true">→</span></a>
                        <a class="kxrp-secondary-link" href="/Account/Login">Volver al inicio de sesión</a>
                    }
                    else if (Model.EnlaceValido)
                    {
                        <div class="kxrp-emblem" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M14 3a7 7 0 1 0 6.8 8.7M14 7h7m-3.5-3.5V10"/><path d="M5 18l-2 3 3-2 2-3"/></svg></div>
                        <h1 id="kxrp-title" class="kxrp-heading">Nueva <span>contraseña</span></h1>
                        <p class="kxrp-lead">Protege tu acceso con una contraseña única de al menos 12 caracteres.</p>
                        <form method="post" class="kxrp-form" id="kxrp-reset-form" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Token" value="@Model.Token" />
                            <label class="kxrp-label" for="kxrp-password">Nueva contraseña</label>
                            <div class="kxrp-input-wrap">
                                <span class="kxrp-input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
                                <input class="kxrp-input kxrp-password-input" type="password" id="kxrp-password" name="Input.Password" autocomplete="new-password" minlength="12" required placeholder="Introduce tu contraseña" aria-describedby="kxrp-strength-label kxrp-password-hint" />
                                <button type="button" class="kxrp-show" data-toggle-password="kxrp-password" aria-label="Mostrar contraseña" aria-pressed="false"><span aria-hidden="true">◉</span></button>
                            </div>
                            <span class="kxrp-field-error">@Html.ValidationMessageFor(m => m.Input.Password)</span>
                            <div class="kxrp-strength" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                            <div class="kxrp-strength-caption" id="kxrp-strength-label" aria-live="polite">Seguridad: escribe una contraseña</div>
                            <label class="kxrp-label" for="kxrp-confirm">Confirmar contraseña</label>
                            <div class="kxrp-input-wrap">
                                <span class="kxrp-input-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
                                <input class="kxrp-input kxrp-password-input" type="password" id="kxrp-confirm" name="Input.ConfirmarPassword" autocomplete="new-password" minlength="12" required placeholder="Repite la contraseña" />
                                <button type="button" class="kxrp-show" data-toggle-password="kxrp-confirm" aria-label="Mostrar confirmación" aria-pressed="false"><span aria-hidden="true">◉</span></button>
                            </div>
                            <span class="kxrp-field-error">@Html.ValidationMessageFor(m => m.Input.ConfirmarPassword)</span>
                            <div class="kxrp-hint" id="kxrp-password-hint">Máximo 72 bytes UTF-8 por compatibilidad con BCrypt. Evita reutilizar contraseñas.</div>
                            <p id="kxrp-client-error" class="kxrp-client-error" role="alert" hidden></p>
                            <button type="submit" class="kxrp-button kxrp-primary" id="kxrp-submit"><span data-submit-label>Actualizar contraseña</span><span aria-hidden="true">→</span></button>
                        </form>
                        <a href="/Account/Login" class="kxrp-secondary-link">← Volver al inicio de sesión</a>
                    }
                    else
                    {
                        <div class="kxrp-emblem" aria-hidden="true">!</div>
                        <h1 id="kxrp-title" class="kxrp-heading">Enlace <span>no disponible</span></h1>
                        <p class="kxrp-lead">El enlace puede haber expirado, ya se utilizó o no es válido.</p>
                        <a class="kxrp-button kxrp-primary" href="/Account/ForgotPassword">Solicitar un enlace nuevo <span aria-hidden="true">→</span></a>
                        <a class="kxrp-secondary-link" href="/Account/Login">Volver al inicio de sesión</a>
                    }
                    <div class="kxrp-divider"></div>
                    <div class="kxrp-security-note"><span class="kxrp-note-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span><span><strong>Recuperación protegida</strong> El enlace vence a los <b>15 minutos</b> y no puede volver a utilizarse.</span></div>
                </div>
            </section>

            <aside class="kxrp-visual" aria-label="KerniX ERP, operaciones inteligentes">
                <div class="kxrp-visual-cover" aria-hidden="true"></div>
                <div class="kxrp-orbit kxrp-orbit-a" aria-hidden="true"></div>
                <div class="kxrp-orbit kxrp-orbit-b" aria-hidden="true"></div>
                <div class="kxrp-art-halo" aria-hidden="true"></div>
                <div class="kxrp-visual-top"><span class="kxrp-diamond">✦</span> PROTECCIÓN INTELIGENTE <span class="kxrp-signal">● SISTEMA KERNIX</span></div>
                <div class="kxrp-visual-caption"><span class="kxrp-visual-eyebrow">SEGURIDAD PARA TUS OPERACIONES</span><h2>Tu negocio.<br/><span>Bajo control.</span></h2><p>Ventas, inventario e inteligencia empresarial conectados en un solo entorno.</p></div>
                <div class="kxrp-visual-tags"><span><i class="kxrp-tag-dot"></i> Ventas</span><span><i class="kxrp-tag-dot"></i> Inventario</span><span><i class="kxrp-tag-dot"></i> Inteligencia</span></div>
            </aside>
        </main>
        <footer class="kxrp-footer"><span>© @DateTime.UtcNow.Year KerniX ERP</span><span><span class="kxrp-footer-dot"></span> Plataforma de gestión empresarial</span></footer>
    </div>
</div>
<script src="~/js/recuperacion.js" asp-append-version="true"></script>
</body>
</html>
